    <bpmn:userTask id="feedback" name="Posts feedback or hearts a post">
      <bpmn:documentation>Anonymous by default, filed under the device. Signing in on the same form puts a name on it.
when: feedback_post
when: feedback_heart
ref: feedback.html
ref: assets/feedback.js</bpmn:documentation>
      <bpmn:incoming>visitor-e26</bpmn:incoming>
      <bpmn:outgoing>visitor-e27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="feedback-in" name="Stores it, capped per hour">
      <bpmn:documentation>ref: functions/api/feedback.js POST say, heart, unheart, remove</bpmn:documentation>
