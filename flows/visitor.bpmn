    </bpmn:endEvent>
    <bpmn:userTask id="deal" name="Presses Sign in to use it on a discount">
      <bpmn:documentation>The offer is drawn for everybody; the code takes an account.
when: deal_signin
ref: assets/app.js dealBlock()</bpmn:documentation>
      <bpmn:incoming>visitor-e29</bpmn:incoming>
