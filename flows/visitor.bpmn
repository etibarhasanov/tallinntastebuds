    <bpmn:startEvent id="open-map" name="Opens tallinntastebuds.ee">
      <bpmn:documentation>when: page:map
ref: index.html
ref: functions/index.js the head for ?spot= and ?lang=</bpmn:documentation>
      <bpmn:outgoing>visitor-e1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="what-now" name="What now?">
      <bpmn:incoming>visitor-e1</bpmn:incoming>
      <bpmn:outgoing>visitor-e2</bpmn:outgoing>
      <bpmn:outgoing>visitor-e3</bpmn:outgoing>
      <bpmn:outgoing>visitor-e9</bpmn:outgoing>
      <bpmn:outgoing>visitor-e12</bpmn:outgoing>
      <bpmn:outgoing>visitor-e17</bpmn:outgoing>
      <bpmn:outgoing>visitor-e19</bpmn:outgoing>
      <bpmn:outgoing>visitor-e24</bpmn:outgoing>
      <bpmn:outgoing>visitor-e27</bpmn:outgoing>
      <bpmn:outgoing>visitor-e29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="browse" name="Browses the map, the chips and the search">
      <bpmn:documentation>A chip that would leave nothing on screen pulls the map back instead. Surprise me picks from what the chips allow.
when: filter_select
when: search@map
when: find_pick
when: find_submit
when: find_area
when: random_pick
when: cluster_open
ref: assets/app.js applyFilters()
ref: data/taxonomy.json</bpmn:documentation>
      <bpmn:incoming>visitor-e3</bpmn:incoming>
      <bpmn:outgoing>visitor-e4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="find-anywhere" name="Finds anywhere in Tallinn">
      <bpmn:documentation>On the map first, then Google's 1,111 venues.
ref: functions/api/places.js GET</bpmn:documentation>
      <bpmn:incoming>visitor-e4</bpmn:incoming>
      <bpmn:outgoing>visitor-e5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="open-place" name="Opens a place">
      <bpmn:documentation>A pin, a row in the column, a result of the search, or a deep link /?spot=&lt;id&gt;.
when: view:map
ref: assets/app.js selectPlace()</bpmn:documentation>
      <bpmn:incoming>visitor-e2</bpmn:incoming>
      <bpmn:incoming>visitor-e5</bpmn:incoming>
      <bpmn:outgoing>visitor-e6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="place-card" name="Adds Google's block and the save counts">
      <bpmn:documentation>ref: functions/api/venues.js GET ?map= or ?ids=
ref: functions/api/saves.js GET</bpmn:documentation>
      <bpmn:incoming>visitor-e6</bpmn:incoming>
      <bpmn:outgoing>visitor-e7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="share" name="Goes, or shares the place">
      <bpmn:documentation>Share sheet on a phone, else the clipboard. The link is /?spot=&lt;id&gt;&amp;from=share, the tag taken off the address again as it opens.
when: place_share
when: directions
when: website
when: call_place
when: google_listing
when: reel_open
ref: assets/app.js pressShare()</bpmn:documentation>
      <bpmn:incoming>visitor-e7</bpmn:incoming>
      <bpmn:outgoing>visitor-e8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="found" name="Somewhere to eat">
      <bpmn:incoming>visitor-e8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ask" name="Asks the chat">
      <bpmn:documentation>when: ask
ref: assets/ask.js</bpmn:documentation>
      <bpmn:incoming>visitor-e9</bpmn:incoming>
      <bpmn:outgoing>visitor-e10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="answer" name="Answers with one to three places">
      <bpmn:documentation>Workers AI on the free daily allowance, shared by preview and production. No account needed.
ref: functions/api/ask.js POST</bpmn:documentation>
      <bpmn:incoming>visitor-e10</bpmn:incoming>
      <bpmn:outgoing>visitor-e11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="asked" name="The answer's pins on the map">
      <bpmn:incoming>visitor-e11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="save" name="Presses the bookmark on a place">
      <bpmn:documentation>when: save_place
ref: assets/app.js</bpmn:documentation>
      <bpmn:incoming>visitor-e12</bpmn:incoming>
      <bpmn:outgoing>visitor-e13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="save-device" name="Files the save under this device">
      <bpmn:documentation>The owner is the device's random id. 403 challenge when Turnstile fails, 429 capped past five saves from one fingerprint.
ref: functions/api/saves.js POST</bpmn:documentation>
      <bpmn:incoming>visitor-e13</bpmn:incoming>
      <bpmn:outgoing>visitor-e14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="offer" name="Takes the account offer?">
      <bpmn:documentation>Offered once a visit, and not again for 14 days after a no.</bpmn:documentation>
      <bpmn:incoming>visitor-e14</bpmn:incoming>
      <bpmn:outgoing>visitor-e15</bpmn:outgoing>
      <bpmn:outgoing>visitor-e16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="saved-here" name="Saved on this device">
      <bpmn:incoming>visitor-e15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="read" name="Watches a story, reads the blog, plays the radio">
      <bpmn:documentation>when: story_open
when: page:blog
when: radio_play
ref: data/stories.json
ref: blog.html
ref: assets/radio.js</bpmn:documentation>
      <bpmn:incoming>visitor-e17</bpmn:incoming>
      <bpmn:outgoing>visitor-e18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="read-done" name="Read and listened">
      <bpmn:incoming>visitor-e18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="lists" name="Opens a list, a profile or /lists">
      <bpmn:documentation>when: page:lists
when: page:list
when: page:profile
ref: functions/list/[id].js
ref: functions/u/[name].js
ref: functions/lists/index.js</bpmn:documentation>
      <bpmn:incoming>visitor-e19</bpmn:incoming>
      <bpmn:outgoing>visitor-e20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="public-only" name="Answers public lists only">
      <bpmn:documentation>A private list is its owner's alone; anybody else gets a 404.
ref: functions/api/lists.js GET
ref: functions/api/profile.js GET</bpmn:documentation>
      <bpmn:incoming>visitor-e20</bpmn:incoming>
      <bpmn:outgoing>visitor-e21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="keep-it" name="Wants to keep the list?">
      <bpmn:incoming>visitor-e21</bpmn:incoming>
      <bpmn:outgoing>visitor-e22</bpmn:outgoing>
      <bpmn:outgoing>visitor-e23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="list-read" name="List read">
      <bpmn:incoming>visitor-e22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="feedback" name="Posts feedback or hearts a post">
      <bpmn:documentation>Anonymous by default, filed under the device. Signing in on the same form puts a name on it.
when: feedback_post
when: feedback_heart
ref: feedback.html
ref: assets/feedback.js</bpmn:documentation>
      <bpmn:incoming>visitor-e24</bpmn:incoming>
      <bpmn:outgoing>visitor-e25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="feedback-in" name="Stores it, capped per hour">
      <bpmn:documentation>ref: functions/api/feedback.js POST say, heart, unheart, remove</bpmn:documentation>
      <bpmn:incoming>visitor-e25</bpmn:incoming>
      <bpmn:outgoing>visitor-e26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="feedback-done" name="Feedback on the page">
      <bpmn:incoming>visitor-e26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="deal" name="Presses Sign in to use it on a discount">
      <bpmn:documentation>The offer is drawn for everybody; the code takes an account.
when: deal_signin
ref: assets/app.js dealBlock()</bpmn:documentation>
      <bpmn:incoming>visitor-e27</bpmn:incoming>
      <bpmn:outgoing>visitor-e28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="sign-in" name="Signs up or signs in">
      <bpmn:documentation>A username of 3 to 24 letters, numbers or dashes, and a password or Google. No email.
when: account_create
when: account_login
ref: index.html the account sheet
ref: assets/app.js</bpmn:documentation>
      <bpmn:incoming>visitor-e16</bpmn:incoming>
      <bpmn:incoming>visitor-e23</bpmn:incoming>
      <bpmn:incoming>visitor-e28</bpmn:incoming>
      <bpmn:incoming>visitor-e29</bpmn:incoming>
      <bpmn:outgoing>visitor-e30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="session" name="Opens a session, claims this device's saves">
      <bpmn:documentation>ref: functions/api/account.js POST create, login, google-name
ref: functions/api/_account.js claimDeviceSaves()
ref: functions/api/google.js GET</bpmn:documentation>
      <bpmn:incoming>visitor-e30</bpmn:incoming>
      <bpmn:outgoing>visitor-e31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="member" name="Now a member">
      <bpmn:incoming>visitor-e31</bpmn:incoming>
    </bpmn:endEvent>
