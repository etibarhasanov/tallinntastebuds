    </bpmn:userTask>
    <bpmn:serviceTask id="find-anywhere" name="Finds anywhere in Tallinn">
      <bpmn:documentation>On the map first, then Google's 1,112 venues.
ref: functions/api/places.js GET</bpmn:documentation>
      <bpmn:incoming>visitor-e6</bpmn:incoming>
