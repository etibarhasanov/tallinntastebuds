    </bpmn:userTask>
    <bpmn:serviceTask id="azeri-home-page" name="Writes the home into the page, and answers it to the script">
      <bpmn:documentation>No read of the database. functions/azeri.js writes the home as text, and the questions as an FAQPage, into the page in the address's language for a reader that runs no script; /api/azeri answers the same file to the script, kept five minutes.
ref: functions/azeri.js
ref: functions/api/azeri.js GET</bpmn:documentation>
      <bpmn:incoming>visitor-e34</bpmn:incoming>
