      <bpmn:outgoing>chess-e22</bpmn:outgoing>
      <bpmn:outgoing>chess-e23</bpmn:outgoing>
      <bpmn:outgoing>chess-e24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="join" name="Joins the waiting list">
      <bpmn:documentation>Signed out, the card says sign in on the map. One place an account, left any time before the game starts.
when: chess_join
when: chess_leave
ref: assets/chess.js playCard()</bpmn:documentation>
      <bpmn:incoming>chess-e22</bpmn:incoming>
      <bpmn:outgoing>chess-e25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="queue" name="Puts them in line">
      <bpmn:documentation>The queue is the private games not started yet, oldest first, and everybody sees the names.
ref: functions/api/chess.js POST join, leave</bpmn:documentation>
      <bpmn:incoming>chess-e25</bpmn:incoming>
      <bpmn:outgoing>chess-e26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="wait" name="Waits for the house">
      <bpmn:documentation>The page says the game has started on its next ask, and nothing else does: the site has no address for anybody.</bpmn:documentation>
      <bpmn:incoming>chess-e26</bpmn:incoming>
      <bpmn:outgoing>chess-e27</bpmn:outgoing>
      <bpmn:timerEventDefinition id="wait-def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="challenge" name="Challenges another member">
      <bpmn:documentation>Found by the start of a username, or in the waiting list. Whoever challenges plays white; five going at most.
when: chess_challenge
when: chess_rematch
when: chess_cancel
ref: assets/chess.js duelsCard(), challengeEnd()</bpmn:documentation>
      <bpmn:incoming>chess-e23</bpmn:incoming>
      <bpmn:outgoing>chess-e29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="challenged" name="Files the challenge">
      <bpmn:documentation>ref: functions/api/chess.js POST challenge, cancel, GET ?find=</bpmn:documentation>
      <bpmn:incoming>chess-e29</bpmn:incoming>
      <bpmn:outgoing>chess-e30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="reply" name="Accepts, or declines">
      <bpmn:documentation>The other member, on their own page's next ask. A challenge nobody answers lapses in seven days.
handover: begins on somebody else's device
when: chess_accept
when: chess_decline
ref: functions/api/chess.js POST accept, decline</bpmn:documentation>
      <bpmn:incoming>chess-e30</bpmn:incoming>
      <bpmn:outgoing>chess-e31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="own" name="A game of their own, on the same board">
      <bpmn:incoming>chess-e28</bpmn:incoming>
      <bpmn:incoming>chess-e31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="claim" name="Claims a duel the other has left for seven days">
      <bpmn:documentation>when: chess_claim
ref: functions/api/chess.js POST claim</bpmn:documentation>
      <bpmn:incoming>chess-e24</bpmn:incoming>
      <bpmn:outgoing>chess-e32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="claimed" name="The duel is theirs">
      <bpmn:incoming>chess-e32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="h-what" name="What now?">
      <bpmn:incoming>chess-e5</bpmn:incoming>
