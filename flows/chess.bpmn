    <bpmn:startEvent id="open" name="Opens /chess">
      <bpmn:documentation>By its address, or by holding Surprise me on the map for five seconds: nothing on the site links to it. One page for everybody, in three faces.
when: page:chess
ref: chess.html
ref: assets/app.js holdForChess()</bpmn:documentation>
      <bpmn:outgoing>chess-e1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="answer" name="Answers the whole page in one request">
      <bpmn:documentation>The boards with their moves, and the legal ones for whoever may move now; the line, the duels, the notes and the asks. Asked again every twenty seconds while the page is on screen.
ref: functions/api/chess.js GET</bpmn:documentation>
      <bpmn:incoming>chess-e1</bpmn:incoming>
      <bpmn:outgoing>chess-e2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="who" name="Who is reading?">
      <bpmn:incoming>chess-e2</bpmn:incoming>
      <bpmn:outgoing>chess-e3</bpmn:outgoing>
      <bpmn:outgoing>chess-e4</bpmn:outgoing>
      <bpmn:outgoing>chess-e5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="a-what" name="What now?">
      <bpmn:incoming>chess-e3</bpmn:incoming>
      <bpmn:incoming>chess-e21</bpmn:incoming>
      <bpmn:incoming>chess-e37</bpmn:incoming>
      <bpmn:outgoing>chess-e6</bpmn:outgoing>
      <bpmn:outgoing>chess-e7</bpmn:outgoing>
