      <bpmn:outgoing>chess-e36</bpmn:outgoing>
      <bpmn:outgoing>chess-e37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="start" name="Starts a game with the first in line">
      <bpmn:documentation>One private game at a time. The member opens as white.
when: chess_start
ref: functions/api/chess.js POST start</bpmn:documentation>
      <bpmn:incoming>chess-e27</bpmn:incoming>
      <bpmn:incoming>chess-e33</bpmn:incoming>
      <bpmn:outgoing>chess-e28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="h-new" name="Starts the next public game">
      <bpmn:documentation>After a mate or a stalemate; a game given up or drawn by agreement starts the next one by itself. The colours swap.
when: chess_new_game
ref: functions/api/chess.js POST new</bpmn:documentation>
      <bpmn:incoming>chess-e34</bpmn:incoming>
      <bpmn:outgoing>chess-e38</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="fresh" name="A fresh board, colours swapped">
      <bpmn:incoming>chess-e38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="abandon" name="Ends a game a member has left for seven days">
      <bpmn:documentation>when: chess_abandon
ref: functions/api/chess.js POST abandon</bpmn:documentation>
      <bpmn:incoming>chess-e35</bpmn:incoming>
      <bpmn:outgoing>chess-e39</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="abandoned" name="Over, and it counts for nobody">
      <bpmn:incoming>chess-e39</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="hide" name="Hides a note">
