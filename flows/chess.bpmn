      <bpmn:incoming>chess-e36</bpmn:incoming>
      <bpmn:outgoing>chess-e40</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="hidden" name="Off the page, still counted against its author">
