  id="flashcards-definitions" targetNamespace="https://tallinntastebuds.ee/flows" exporter="tools/flows.mjs" exporterVersion="1">
  <bpmn:collaboration id="flashcards-collaboration">
    <bpmn:participant id="flashcards-pool" name="Flashcards, a learner" processRef="flashcards-process" />
  </bpmn:collaboration>
  <bpmn:process id="flashcards-process" name="Flashcards, a learner" isExecutable="false">
    <bpmn:documentation>Somebody learning Estonian on flashcard.tallinntastebuds.ee. Signed out they get the decks page and one word; an account remembers every answer, spaces the next time, and lets them write decks of their own.</bpmn:documentation>
    <bpmn:laneSet id="flashcards-lanes">
      <bpmn:lane id="flashcards-lane-learner" name="Learner">
        <bpmn:flowNodeRef>open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>shelf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>what-now</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>turn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signed-in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>one-word</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign-in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remember</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>progress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>own-deck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>own-done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reset</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reset-done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fresh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report-done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="open" name="Opens flashcards">
      <bpmn:documentation>ref: functions/flashcard.js</bpmn:documentation>
      <bpmn:outgoing>flashcards-e1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="shelf" name="Answers the shelf and the words, in one request">
      <bpmn:documentation>ref: functions/api/flashcard.js GET</bpmn:documentation>
      <bpmn:incoming>flashcards-e1</bpmn:incoming>
      <bpmn:outgoing>flashcards-e2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="what-now" name="What now?">
      <bpmn:incoming>flashcards-e2</bpmn:incoming>
      <bpmn:outgoing>flashcards-e3</bpmn:outgoing>
      <bpmn:outgoing>flashcards-e11</bpmn:outgoing>
      <bpmn:outgoing>flashcards-e14</bpmn:outgoing>
      <bpmn:outgoing>flashcards-e17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="deck" name="Opens a deck or a lesson">
      <bpmn:documentation>Deeper stages open as the count of known words grows.
ref: assets/flashcard.js</bpmn:documentation>
      <bpmn:incoming>flashcards-e3</bpmn:incoming>
      <bpmn:outgoing>flashcards-e4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="turn" name="Turns a card: got it, or not">
      <bpmn:documentation>Undo one answer, a hint once a card, hear it spoken.
ref: assets/flashcard.js
ref: functions/api/say.js GET</bpmn:documentation>
      <bpmn:incoming>flashcards-e4</bpmn:incoming>
      <bpmn:outgoing>flashcards-e5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="signed-in" name="Signed in?">
      <bpmn:incoming>flashcards-e5</bpmn:incoming>
      <bpmn:outgoing>flashcards-e6</bpmn:outgoing>
      <bpmn:outgoing>flashcards-e7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="one-word" name="One word, then the sign-in card">
      <bpmn:documentation>The answer is kept in the tab and sent once they sign in.
ref: assets/flashcard.js</bpmn:documentation>
      <bpmn:incoming>flashcards-e7</bpmn:incoming>
      <bpmn:outgoing>flashcards-e8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="sign-in" name="Signs in">
      <bpmn:documentation>ref: functions/api/account.js POST
ref: functions/api/google.js GET</bpmn:documentation>
      <bpmn:incoming>flashcards-e8</bpmn:incoming>
      <bpmn:outgoing>flashcards-e9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="remember" name="Remembers it and spaces the next time">
      <bpmn:documentation>Boxes of 1, 3, 7, 14, 35 and 77 days; a miss goes back to the start.
ref: functions/api/flashcard.js POST knew, again</bpmn:documentation>
      <bpmn:incoming>flashcards-e6</bpmn:incoming>
      <bpmn:incoming>flashcards-e9</bpmn:incoming>
      <bpmn:outgoing>flashcards-e10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="progress" name="Progress kept">
      <bpmn:incoming>flashcards-e10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="write" name="Writes a deck of their own">
      <bpmn:documentation>Members only. 20 decks, 200 cards each.
ref: assets/flashcard.js</bpmn:documentation>
      <bpmn:incoming>flashcards-e11</bpmn:incoming>
      <bpmn:outgoing>flashcards-e12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="own-deck" name="Stores the deck and its cards">
      <bpmn:documentation>ref: functions/api/flashcard.js POST deck, card, editcard, uncard, drop</bpmn:documentation>
      <bpmn:incoming>flashcards-e12</bpmn:incoming>
      <bpmn:outgoing>flashcards-e13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="own-done" name="A deck only they see">
      <bpmn:incoming>flashcards-e13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="reset" name="Starts a deck again">
      <bpmn:documentation>ref: assets/flashcard.js</bpmn:documentation>
      <bpmn:incoming>flashcards-e14</bpmn:incoming>
      <bpmn:outgoing>flashcards-e15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="reset-done" name="Forgets that deck's answers">
      <bpmn:documentation>ref: functions/api/flashcard.js POST reset</bpmn:documentation>
      <bpmn:incoming>flashcards-e15</bpmn:incoming>
      <bpmn:outgoing>flashcards-e16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="fresh" name="A fresh deck">
      <bpmn:incoming>flashcards-e16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="report" name="Says a card is wrong">
      <bpmn:documentation>No account needed.
ref: assets/flashcard.js</bpmn:documentation>
      <bpmn:incoming>flashcards-e17</bpmn:incoming>
      <bpmn:outgoing>flashcards-e18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="reported" name="Files the report, 20 an hour">
      <bpmn:documentation>ref: functions/api/flashcard.js POST report</bpmn:documentation>
      <bpmn:incoming>flashcards-e18</bpmn:incoming>
      <bpmn:outgoing>flashcards-e19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="report-done" name="Reported">
      <bpmn:incoming>flashcards-e19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flashcards-e1" sourceRef="open" targetRef="shelf" />
    <bpmn:sequenceFlow id="flashcards-e2" sourceRef="shelf" targetRef="what-now" />
    <bpmn:sequenceFlow id="flashcards-e3" name="learn" sourceRef="what-now" targetRef="deck" />
    <bpmn:sequenceFlow id="flashcards-e4" sourceRef="deck" targetRef="turn" />
    <bpmn:sequenceFlow id="flashcards-e5" sourceRef="turn" targetRef="signed-in" />
    <bpmn:sequenceFlow id="flashcards-e6" name="yes" sourceRef="signed-in" targetRef="remember" />
    <bpmn:sequenceFlow id="flashcards-e7" name="no" sourceRef="signed-in" targetRef="one-word" />
    <bpmn:sequenceFlow id="flashcards-e8" sourceRef="one-word" targetRef="sign-in" />
    <bpmn:sequenceFlow id="flashcards-e9" sourceRef="sign-in" targetRef="remember" />
    <bpmn:sequenceFlow id="flashcards-e10" sourceRef="remember" targetRef="progress" />
    <bpmn:sequenceFlow id="flashcards-e11" name="write a deck" sourceRef="what-now" targetRef="write" />
    <bpmn:sequenceFlow id="flashcards-e12" sourceRef="write" targetRef="own-deck" />
    <bpmn:sequenceFlow id="flashcards-e13" sourceRef="own-deck" targetRef="own-done" />
    <bpmn:sequenceFlow id="flashcards-e14" name="start again" sourceRef="what-now" targetRef="reset" />
    <bpmn:sequenceFlow id="flashcards-e15" sourceRef="reset" targetRef="reset-done" />
    <bpmn:sequenceFlow id="flashcards-e16" sourceRef="reset-done" targetRef="fresh" />
    <bpmn:sequenceFlow id="flashcards-e17" name="wrong card" sourceRef="what-now" targetRef="report" />
    <bpmn:sequenceFlow id="flashcards-e18" sourceRef="report" targetRef="reported" />
    <bpmn:sequenceFlow id="flashcards-e19" sourceRef="reported" targetRef="report-done" />
