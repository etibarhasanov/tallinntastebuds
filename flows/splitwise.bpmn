      <bpmn:lane id="splitwise-lane-holder" name="Link holder">
        <bpmn:flowNodeRef>open-link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signed-in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign-in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="splitwise-lane-member" name="Member">
        <bpmn:flowNodeRef>what-now</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>spend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>undo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>balances</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="splitwise-lane-site" name="The site">
        <bpmn:flowNodeRef>created</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ledger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>joined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>owner-write</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="paid" name="Paid for dinner">
      <bpmn:documentation>ref: split.html</bpmn:documentation>
      <bpmn:outgoing>splitwise-e1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="create" name="Names a group">
      <bpmn:documentation>ref: assets/split.js</bpmn:documentation>
      <bpmn:incoming>splitwise-e1</bpmn:incoming>
      <bpmn:outgoing>splitwise-e2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="created" name="Creates it">
      <bpmn:documentation>Up to 20 groups an account.
ref: functions/api/split.js POST create</bpmn:documentation>
      <bpmn:incoming>splitwise-e2</bpmn:incoming>
      <bpmn:outgoing>splitwise-e3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="send" name="Sends the link to the table">
      <bpmn:documentation>ref: functions/split.js the head a message unfurls</bpmn:documentation>
      <bpmn:incoming>splitwise-e3</bpmn:incoming>
      <bpmn:outgoing>splitwise-e4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="open-link" name="Opens the link">
      <bpmn:documentation>ref: functions/split.js</bpmn:documentation>
      <bpmn:incoming>splitwise-e4</bpmn:incoming>
      <bpmn:outgoing>splitwise-e5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ledger" name="Answers the whole ledger to the code">
      <bpmn:documentation>Members, expenses, payments, balances and who pays whom.
ref: functions/api/split.js GET ?group=</bpmn:documentation>
      <bpmn:incoming>splitwise-e5</bpmn:incoming>
      <bpmn:outgoing>splitwise-e6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="signed-in" name="Signed in?">
      <bpmn:incoming>splitwise-e6</bpmn:incoming>
      <bpmn:outgoing>splitwise-e7</bpmn:outgoing>
      <bpmn:outgoing>splitwise-e8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="sign-in" name="Signs in on the page">
      <bpmn:documentation>ref: assets/split.js
ref: functions/api/account.js POST login, create</bpmn:documentation>
      <bpmn:incoming>splitwise-e7</bpmn:incoming>
      <bpmn:outgoing>splitwise-e9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="join" name="Presses Join">
      <bpmn:documentation>ref: assets/split.js joinCard()</bpmn:documentation>
      <bpmn:incoming>splitwise-e8</bpmn:incoming>
      <bpmn:incoming>splitwise-e9</bpmn:incoming>
      <bpmn:outgoing>splitwise-e10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="joined" name="Adds the member">
      <bpmn:documentation>12 members a group, 429 full past that.
ref: functions/api/split.js POST join</bpmn:documentation>
      <bpmn:incoming>splitwise-e10</bpmn:incoming>
      <bpmn:outgoing>splitwise-e11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="what-now" name="What now?">
      <bpmn:incoming>splitwise-e11</bpmn:incoming>
      <bpmn:outgoing>splitwise-e12</bpmn:outgoing>
      <bpmn:outgoing>splitwise-e13</bpmn:outgoing>
