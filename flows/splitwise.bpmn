      <bpmn:outgoing>splitwise-e15</bpmn:outgoing>
      <bpmn:outgoing>splitwise-e16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="spend" name="Adds an expense, for anybody">
      <bpmn:documentation>ref: assets/split.js spendForm()</bpmn:documentation>
      <bpmn:incoming>splitwise-e12</bpmn:incoming>
      <bpmn:outgoing>splitwise-e17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="settle" name="Marks a payment as paid">
      <bpmn:documentation>ref: assets/split.js</bpmn:documentation>
      <bpmn:incoming>splitwise-e13</bpmn:incoming>
      <bpmn:outgoing>splitwise-e18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="undo" name="Removes a line they wrote or paid">
      <bpmn:incoming>splitwise-e14</bpmn:incoming>
      <bpmn:outgoing>splitwise-e19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="leave" name="Leaves">
      <bpmn:documentation>Only while nothing in the sums names them: 409 spent otherwise.</bpmn:documentation>
      <bpmn:incoming>splitwise-e15</bpmn:incoming>
      <bpmn:outgoing>splitwise-e20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="write" name="Stores it, in cents">
      <bpmn:documentation>200 expenses and 200 payments a group.
ref: functions/api/split.js POST spend, settle, unspend, unsettle, leave</bpmn:documentation>
      <bpmn:incoming>splitwise-e17</bpmn:incoming>
      <bpmn:incoming>splitwise-e18</bpmn:incoming>
      <bpmn:incoming>splitwise-e19</bpmn:incoming>
      <bpmn:incoming>splitwise-e20</bpmn:incoming>
      <bpmn:outgoing>splitwise-e21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="balances" name="Who pays whom, in one sentence">
      <bpmn:incoming>splitwise-e21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="owner-acts" name="Removes a member, or deletes the group">
      <bpmn:documentation>Only a member nothing in the sums names. Deleting takes everything and has no undo.
ref: assets/split.js</bpmn:documentation>
      <bpmn:incoming>splitwise-e16</bpmn:incoming>
      <bpmn:outgoing>splitwise-e22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="owner-write" name="Drops them, or the group">
      <bpmn:documentation>ref: functions/api/split.js POST drop, remove</bpmn:documentation>
      <bpmn:incoming>splitwise-e22</bpmn:incoming>
      <bpmn:outgoing>splitwise-e23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="owner-done" name="Group changed">
      <bpmn:incoming>splitwise-e23</bpmn:incoming>
    </bpmn:endEvent>
