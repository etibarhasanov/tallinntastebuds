  <bpmn:process id="splitwise-process" name="Splitwise, a group" isExecutable="false">
    <bpmn:documentation>Friends splitting a bill on splitwise.tallinntastebuds.ee. The code in the link is enough to read the whole group; writing to it takes an account and a press of Join. The owner is whoever made the group.</bpmn:documentation>
    <bpmn:laneSet id="splitwise-lanes">
      <bpmn:lane id="splitwise-lane-owner" name="Group owner">
        <bpmn:flowNodeRef>paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
