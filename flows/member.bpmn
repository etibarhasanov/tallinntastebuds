    <bpmn:userTask id="edit-page" name="Edits the page under their name">
      <bpmn:documentation>A line about themselves, three handles, the languages they speak, a page of links with their public lists among it in the order they drag them — the line and the links in as many of the site's languages as they write them in.
when: page:edit
ref: edit.html
ref: assets/edit.js</bpmn:documentation>
      <bpmn:incoming>member-e29</bpmn:incoming>
