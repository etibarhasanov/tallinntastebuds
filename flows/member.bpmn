    <bpmn:userTask id="save" name="Saves a place">
      <bpmn:documentation>ref: assets/app.js</bpmn:documentation>
      <bpmn:incoming>member-e2</bpmn:incoming>
      <bpmn:outgoing>member-e3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="save-account" name="Files the save under the account">
      <bpmn:documentation>ref: functions/api/saves.js POST</bpmn:documentation>
      <bpmn:incoming>member-e3</bpmn:incoming>
      <bpmn:outgoing>member-e4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="saved" name="Saved on every device">
      <bpmn:incoming>member-e4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="make-list" name="Makes a list">
      <bpmn:documentation>ref: account.html
ref: assets/account.js</bpmn:documentation>
      <bpmn:incoming>member-e5</bpmn:incoming>
      <bpmn:outgoing>member-e6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="list-create" name="Creates it">
      <bpmn:documentation>Up to 24 lists, 429 too-many past that.
ref: functions/api/lists.js POST create</bpmn:documentation>
      <bpmn:incoming>member-e6</bpmn:incoming>
      <bpmn:outgoing>member-e7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="fill-list" name="Adds places, notes, what to order">
      <bpmn:documentation>Up to 50 places. A place nobody has is found by address.
ref: lists.html
ref: assets/lists.js</bpmn:documentation>
      <bpmn:incoming>member-e7</bpmn:incoming>
      <bpmn:outgoing>member-e8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="list-edit" name="Stores each edit">
      <bpmn:documentation>ref: functions/api/lists.js POST add, drop, order, say, mustOrder, edit, place, delete
ref: functions/api/geocode.js GET</bpmn:documentation>
      <bpmn:incoming>member-e8</bpmn:incoming>
      <bpmn:outgoing>member-e9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="public" name="Public?">
      <bpmn:incoming>member-e9</bpmn:incoming>
      <bpmn:outgoing>member-e10</bpmn:outgoing>
      <bpmn:outgoing>member-e11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="published" name="On /lists and /u/&lt;name&gt;">
      <bpmn:incoming>member-e10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="private" name="Theirs alone">
      <bpmn:incoming>member-e11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="keep" name="Keeps somebody else's list">
      <bpmn:documentation>ref: assets/lists.js</bpmn:documentation>
      <bpmn:incoming>member-e12</bpmn:incoming>
      <bpmn:outgoing>member-e13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="kept" name="Adds it to Lists you saved">
      <bpmn:documentation>400 own on your own list, cap of 200.
ref: functions/api/lists.js POST keep, unkeep</bpmn:documentation>
      <bpmn:incoming>member-e13</bpmn:incoming>
      <bpmn:outgoing>member-e14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="kept-done" name="Kept">
      <bpmn:incoming>member-e14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="deal" name="Opens a discount pass">
      <bpmn:documentation>ref: deal.html
ref: assets/deal.js</bpmn:documentation>
      <bpmn:incoming>member-e15</bpmn:incoming>
      <bpmn:outgoing>member-e16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="admit" name="Admits the account, draws the hour's rate">
      <bpmn:documentation>ref: functions/api/pass.js GET</bpmn:documentation>
      <bpmn:incoming>member-e16</bpmn:incoming>
      <bpmn:outgoing>member-e17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="deal-done" name="Shows the code (see the discount diagram)">
      <bpmn:incoming>member-e17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="edit-page" name="Edits the page under their name">
      <bpmn:documentation>A line about themselves, three handles, a page of links.
ref: edit.html
ref: assets/edit.js</bpmn:documentation>
      <bpmn:incoming>member-e18</bpmn:incoming>
      <bpmn:outgoing>member-e19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="page-saved" name="Stores the page">
      <bpmn:documentation>ref: functions/api/account.js POST display, about, links, rows</bpmn:documentation>
      <bpmn:incoming>member-e19</bpmn:incoming>
      <bpmn:outgoing>member-e20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="insights" name="Reads who opened it">
      <bpmn:documentation>ref: insights.html
ref: assets/insights.js</bpmn:documentation>
      <bpmn:incoming>member-e20</bpmn:incoming>
      <bpmn:outgoing>member-e21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="views" name="Counts views of their own page">
      <bpmn:documentation>ref: functions/api/insights.js GET</bpmn:documentation>
