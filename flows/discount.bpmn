<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="discount-definitions" targetNamespace="https://tallinntastebuds.ee/flows" exporter="tools/flows.mjs" exporterVersion="1">
  <bpmn:collaboration id="discount-collaboration">
    <bpmn:participant id="discount-pool" name="A discount, at the table" processRef="discount-process" />
  </bpmn:collaboration>
  <bpmn:process id="discount-process" name="A discount, at the table" isExecutable="false">
    <bpmn:documentation>The one journey that crosses people: a guest with an account shows a code that changes every hour, and a waiter checks it with an ordinary camera and no account. The counter's page is the fallback when the camera will not scan.</bpmn:documentation>
    <bpmn:laneSet id="discount-lanes">
      <bpmn:lane id="discount-lane-guest" name="Guest">
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>signed-in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign-in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show-qr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="discount-lane-site" name="The site">
        <bpmn:flowNodeRef>admit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="discount-lane-waiter" name="Waiter">
        <bpmn:flowNodeRef>camera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>given</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>refused</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="discount-lane-counter" name="Counter">
        <bpmn:flowNodeRef>compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>given-counter</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="offer" name="Sees an offer on a place">
      <bpmn:documentation>when: deal_open
ref: assets/app.js dealBlock()
ref: data/deals.json</bpmn:documentation>
      <bpmn:outgoing>discount-e1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="signed-in" name="Signed in?">
      <bpmn:incoming>discount-e1</bpmn:incoming>
      <bpmn:outgoing>discount-e2</bpmn:outgoing>
      <bpmn:outgoing>discount-e3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="sign-in" name="Signs in from the sheet, lands back on the pass">
      <bpmn:documentation>when: deal_signin
when: pass_signin
ref: index.html the account sheet</bpmn:documentation>
      <bpmn:incoming>discount-e3</bpmn:incoming>
      <bpmn:outgoing>discount-e4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="show-qr" name="Presses Show QR">
      <bpmn:documentation>when: page:deal
ref: deal.html</bpmn:documentation>
      <bpmn:incoming>discount-e2</bpmn:incoming>
      <bpmn:outgoing>discount-e5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="admit" name="Admits the account, draws the hour's rate">
      <bpmn:documentation>401 sign-in without a session, 503 with no database or salt. The rate is the same for the whole hour and nothing is stored.
when: pass_shown
ref: functions/api/pass.js GET</bpmn:documentation>
      <bpmn:incoming>discount-e4</bpmn:incoming>
      <bpmn:incoming>discount-e5</bpmn:incoming>
      <bpmn:outgoing>discount-e6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="pass" name="Draws the QR, the code and a live countdown">
      <bpmn:documentation>code = HMAC(the deal's key, place:hour[:rate]), five characters. The countdown is what tells a live pass from a screenshot.
ref: assets/deal.js
ref: assets/pass.js
ref: assets/qr.js</bpmn:documentation>
      <bpmn:incoming>discount-e6</bpmn:incoming>
      <bpmn:outgoing>discount-e7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="camera" name="Camera scans it?">
      <bpmn:incoming>discount-e7</bpmn:incoming>
      <bpmn:outgoing>discount-e8</bpmn:outgoing>
      <bpmn:outgoing>discount-e9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="scan" name="Points the phone's camera at the QR">
      <bpmn:documentation>handover: begins on somebody else's device
when: page:verify
ref: verify.html</bpmn:documentation>
      <bpmn:incoming>discount-e8</bpmn:incoming>
      <bpmn:outgoing>discount-e10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:task id="verify" name="Checks the hour and the code">
      <bpmn:documentation>Accepts the hour before and after. Everything is checked on the waiter's phone; no request is made.
when: pass_verify
ref: assets/verify.js
ref: assets/pass.js verify()</bpmn:documentation>
      <bpmn:incoming>discount-e10</bpmn:incoming>
      <bpmn:outgoing>discount-e11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="valid" name="Valid?">
      <bpmn:incoming>discount-e11</bpmn:incoming>
      <bpmn:outgoing>discount-e12</bpmn:outgoing>
      <bpmn:outgoing>discount-e13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="given" name="Discount given">
      <bpmn:incoming>discount-e12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="refused" name="Refused, with the reason">
      <bpmn:incoming>discount-e13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="compare" name="Compares with this hour's code">
      <bpmn:documentation>The owner sends staff.html?r=&lt;id&gt; once and the restaurant bookmarks it.
handover: begins on somebody else's device
when: page:staff
ref: staff.html
ref: assets/staff.js</bpmn:documentation>
      <bpmn:incoming>discount-e9</bpmn:incoming>
      <bpmn:outgoing>discount-e14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="given-counter" name="Discount given">
      <bpmn:incoming>discount-e14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="discount-e1" sourceRef="offer" targetRef="signed-in" />
    <bpmn:sequenceFlow id="discount-e2" name="yes" sourceRef="signed-in" targetRef="show-qr" />
    <bpmn:sequenceFlow id="discount-e3" name="no" sourceRef="signed-in" targetRef="sign-in" />
    <bpmn:sequenceFlow id="discount-e4" sourceRef="sign-in" targetRef="admit" />
    <bpmn:sequenceFlow id="discount-e5" sourceRef="show-qr" targetRef="admit" />
    <bpmn:sequenceFlow id="discount-e6" sourceRef="admit" targetRef="pass" />
    <bpmn:sequenceFlow id="discount-e7" sourceRef="pass" targetRef="camera" />
    <bpmn:sequenceFlow id="discount-e8" name="yes" sourceRef="camera" targetRef="scan" />
    <bpmn:sequenceFlow id="discount-e9" name="no" sourceRef="camera" targetRef="compare" />
    <bpmn:sequenceFlow id="discount-e10" sourceRef="scan" targetRef="verify" />
    <bpmn:sequenceFlow id="discount-e11" sourceRef="verify" targetRef="valid" />
    <bpmn:sequenceFlow id="discount-e12" name="VALID" sourceRef="valid" targetRef="given" />
    <bpmn:sequenceFlow id="discount-e13" name="expired, early, wrong" sourceRef="valid" targetRef="refused" />
    <bpmn:sequenceFlow id="discount-e14" sourceRef="compare" targetRef="given-counter" />
  </bpmn:process>
