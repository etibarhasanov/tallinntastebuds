    <bpmn:startEvent id="docs" name="Opens /developers">
      <bpmn:documentation>English only: the names and fields are English whatever the reader speaks.
ref: developers.html</bpmn:documentation>
      <bpmn:outgoing>developer-e1</bpmn:outgoing>
