      <bpmn:outgoing>developer-e5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="call" name="Calls /api/v1 from their own code">
      <bpmn:documentation>GET only, JSON, any origin. Places, one place, the public lists, one list, the kinds of place.
ref: functions/api/v1/[[path]].js</bpmn:documentation>
      <bpmn:incoming>developer-e2</bpmn:incoming>
      <bpmn:outgoing>developer-e3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="answer" name="Answers in version 1's shape">
      <bpmn:documentation>The map's own rows and none of Google's. Five minutes in the colo. A field may be added and none taken away; a break is /api/v2, and v1 then carries Deprecation and Sunset.
ref: functions/api/v1/[[path]].js
ref: functions/_public.js
ref: data/api-v1.json
ref: tools/apicheck.mjs</bpmn:documentation>
      <bpmn:incoming>developer-e3</bpmn:incoming>
      <bpmn:outgoing>developer-e4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="built" name="Their app shows the places">
      <bpmn:incoming>developer-e4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="frame" name="Puts /embed in an iframe on their page">
      <bpmn:documentation>?list=, ?type=, ?ids= or nothing, with &amp;lang= and &amp;style=.
ref: embed.html
ref: assets/embed.js</bpmn:documentation>
      <bpmn:incoming>developer-e5</bpmn:incoming>
      <bpmn:outgoing>developer-e6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="draw" name="Draws the map from /api/v1">
      <bpmn:documentation>The one page another site may frame. Every link opens the site in a new tab; nothing is counted.
ref: assets/embed.js
ref: functions/_security.js EMBEDS</bpmn:documentation>
      <bpmn:incoming>developer-e6</bpmn:incoming>
      <bpmn:outgoing>developer-e7</bpmn:outgoing>
    </bpmn:serviceTask>
