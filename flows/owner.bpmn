    <bpmn:serviceTask id="story-deploy" name="Deploys within the minute">
      <bpmn:incoming>owner-e8</bpmn:incoming>
      <bpmn:outgoing>owner-e9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="story-from" name="Its from comes round">
      <bpmn:documentation>Up for 36 hours; an hourly job files it away after.
