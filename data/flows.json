        {"id": "open-place", "type": "user", "lane": "visitor", "name": "Opens a place", "when": ["view:map"], "note": "A pin, a row in the column, a result of the search, or a deep link /?spot=<id>.", "ref": ["assets/app.js selectPlace()"]},
