{
 "id": "talk-delivery",
 "added": "2026-10-07",
 "name": {
  "en": "Ordering delivery and installation",
  "az": "Çatdırılma və quraşdırma sifarişi",
  "ru": "Заказ доставки и установки"
 },
 "why": {
  "en": "The form for a client card, delivery tomorrow, and free all the way up to the ninth floor",
  "az": "Müştəri kartı üçün anket, sabah çatdırılma və doqquzuncu mərtəbəyə qədər pulsuz",
  "ru": "Анкета для карты клиента, доставка завтра и бесплатно хоть на девятый этаж"
 },
 "taste": "Ma elan üheksandal korrusel.",
 "source": "Keeletee",
 "scenes": [
  {
   "turns": [
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Ma vormistan siis teile kliendikaardi.",
       "en": "I'll make you a client card, then.",
       "az": "Onda sizə müştəri kartı rəsmiləşdirirəm.",
       "ru": "Тогда я оформлю вам карту клиента."
      },
      {
       "et": "Täitke palun see ankeet ära.",
       "en": "Please fill in this form.",
       "az": "Zəhmət olmasa, bu anketi doldurun.",
       "ru": "Заполните, пожалуйста, эту анкету."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Mhm.",
       "en": "Mm-hm.",
       "az": "Mhm.",
       "ru": "Угу."
      },
      {
       "et": "Kui ma täna ostan, siis millal ma masina kätte saan?",
       "en": "If I buy today, when will I get the machine?",
       "az": "Bu gün alsam, maşını nə vaxt alaram?",
       "ru": "Если я куплю сегодня, когда я получу машину?"
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Sõltub, kas te soovite kojuvedu ka või mitte.",
       "en": "That depends on whether you want delivery or not.",
       "az": "Evə çatdırılma istəyib-istəməməyinizdən asılıdır.",
       "ru": "Зависит от того, нужна ли вам доставка на дом."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Kindlasti soovin.",
       "en": "I certainly do.",
       "az": "Əlbəttə istəyirəm.",
       "ru": "Обязательно нужна."
      },
      {
       "et": "Keegi võiks selle masina mul kodus tööle ka panna.",
       "en": "Someone could get the machine working at my home, too.",
       "az": "Kimsə bu maşını evimdə qoşub işə də sala bilərdi.",
       "ru": "И хорошо бы кто-нибудь подключил эту машину у меня дома."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Üks hetk, ma kontrollin, kas täna veel saab kojuvedu ja paigaldust tellida.",
       "en": "Just a moment, I'll check whether delivery and installation can still be ordered for today.",
       "az": "Bir dəqiqə, yoxlayıram, bu gün hələ çatdırılma və quraşdırma sifariş etmək olarmı.",
       "ru": "Одну минуту, я проверю, можно ли ещё сегодня заказать доставку и установку."
      },
      {
       "et": "Paistab, et ei saa.",
       "en": "It looks like they can't.",
       "az": "Deyəsən, olmaz.",
       "ru": "Похоже, что нельзя."
      },
      {
       "et": "Aga homse päeva jooksul kindlasti saab.",
       "en": "But sometime tomorrow, certainly.",
       "az": "Amma sabah gün ərzində mütləq olar.",
       "ru": "Но в течение завтрашнего дня — точно можно."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Hästi.",
       "en": "OK.",
       "az": "Yaxşı.",
       "ru": "Хорошо."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Kirjutage palun siia oma aadress ja telefoninumber.",
       "en": "Please write your address and phone number here.",
       "az": "Zəhmət olmasa, ünvanınızı və telefon nömrənizi bura yazın.",
       "ru": "Напишите, пожалуйста, сюда свой адрес и номер телефона."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Kui palju see kojuvedu maksab?",
       "en": "How much does the delivery cost?",
       "az": "Bu çatdırılma neçəyədir?",
       "ru": "Сколько стоит доставка?"
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Kojuvedu on meil linna piires tasuta.",
       "en": "Within the city our delivery is free.",
       "az": "Şəhər daxilində çatdırılmamız pulsuzdur.",
       "ru": "В пределах города доставка у нас бесплатная."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Ma elan üheksandal korrusel.",
       "en": "I live on the ninth floor.",
       "az": "Mən doqquzuncu mərtəbədə yaşayıram.",
       "ru": "Я живу на девятом этаже."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Ärge muretsege.",
       "en": "Don't worry.",
       "az": "Narahat olmayın.",
       "ru": "Не волнуйтесь."
      },
      {
       "et": "Ilmselt on teil majas lift ja nagu ma ütlesin, kojuvedu on niikuinii tasuta.",
       "en": "There's probably a lift in your building, and as I said, delivery is free anyway.",
       "az": "Yəqin ki, binanızda lift var və dediyim kimi, çatdırılma onsuz da pulsuzdur.",
       "ru": "Наверняка в вашем доме есть лифт, и, как я сказал, доставка всё равно бесплатная."
      },
      {
       "et": "Pole vahet, mis korrusel te elate.",
       "en": "It doesn't matter which floor you live on.",
       "az": "Neçənci mərtəbədə yaşamağınızın fərqi yoxdur.",
       "ru": "Неважно, на каком этаже вы живёте."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Väga hea.",
       "en": "Very good.",
       "az": "Çox gözəl.",
       "ru": "Очень хорошо."
      }
     ]
    }
   ]
  }
 ],
