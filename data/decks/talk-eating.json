{
 "id": "talk-eating",
 "added": "2026-10-06",
 "name": {
  "en": "The food arrives",
  "az": "Yemək gəlir",
  "ru": "Еду принесли"
 },
 "why": {
  "en": "Head isu, jätku leiba, a portion too big to finish, and the bill by card",
  "az": "Head isu, jätku leiba, bitirilməyəcək qədər böyük porsiya və kartla ödəniş",
  "ru": "Head isu, jätku leiba, порция, которую не осилить, и счёт по карте"
 },
 "taste": "Ja siin on teie söögid. Head isu!",
 "source": "Keeletee",
 "scenes": [
  {
   "turns": [
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Ja siin on teie söögid.",
       "en": "And here is your food.",
       "az": "Buyurun, yeməkləriniz.",
       "ru": "А вот и ваша еда."
      },
      {
       "et": "Head isu!",
       "en": "Enjoy your meal!",
       "az": "Nuş olsun!",
       "ru": "Приятного аппетита!"
      }
     ]
    },
    {
     "who": "Illimar",
     "lines": [
      {
       "et": "Tegelikult supp oli mulle.",
       "en": "Actually, the soup was for me.",
       "az": "Əslində şorba mənim idi.",
       "ru": "Вообще-то суп был мне."
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Oi, palun vabandust!",
       "en": "Oh, I'm sorry!",
       "az": "Oy, bağışlayın!",
       "ru": "Ой, простите!"
      }
     ]
    },
    {
     "who": "Johanna",
     "lines": [
      {
       "et": "Appi, kui suur ports!",
       "en": "Goodness, what a big portion!",
       "az": "Vay, nə böyük porsiyadır!",
       "ru": "Батюшки, какая порция!"
      },
      {
       "et": "Ma vist kõike küll ei jaksa ära süüa.",
       "en": "I don't think I can eat all of it.",
       "az": "Deyəsən, hamısını yeyə bilməyəcəyəm.",
       "ru": "Я, наверное, всё не осилю."
      }
     ]
    },
    {
     "who": "Illimar",
     "lines": [
      {
       "et": "Kas ma leiba ja hapukoort ka saaksin?",
       "en": "Could I have some bread and sour cream as well?",
       "az": "Çörək və xama da ala bilərəm?",
       "ru": "Можно мне ещё хлеба и сметаны?"
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Jah, ma kohe toon leiba.",
       "en": "Yes, I'll bring bread right away.",
       "az": "Bəli, indicə çörək gətirirəm.",
       "ru": "Да, сейчас принесу хлеб."
      },
      {
       "et": "Hapukoort meil paraku ei ole.",
       "en": "Sour cream, unfortunately, we don't have.",
       "az": "Xama, təəssüf ki, yoxdur.",
       "ru": "Сметаны у нас, к сожалению, нет."
      }
     ]
    },
    {
     "who": "Johanna",
     "lines": [
      {
       "et": "Tooge mulle veel üks õlu ka, palun.",
       "en": "Bring me another beer too, please.",
       "az": "Mənə bir pivə də gətirin, zəhmət olmasa.",
       "ru": "Принесите мне, пожалуйста, ещё одно пиво."
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Selge.",
       "en": "Right.",
       "az": "Aydındır.",
       "ru": "Хорошо."
      },
      {
       "et": "Palun!",
       "en": "Here you are!",
       "az": "Buyurun!",
       "ru": "Пожалуйста!"
      }
     ]
    },
    {
     "who": "Johanna",
     "lines": [
      {
       "et": "Tänan.",
       "en": "Thank you.",
       "az": "Sağ olun.",
       "ru": "Спасибо."
      },
      {
       "et": "Vaata, kui uhke.",
       "en": "Look how grand.",
       "az": "Bax, nə təmtəraqlı.",
       "ru": "Смотри, как шикарно."
      },
      {
       "et": "Teeme pilti ka!",
       "en": "Let's take a picture too!",
       "az": "Gəl şəkil də çəkək!",
       "ru": "Давай ещё сфотографируемся!"
      }
     ]
    },
    {
     "who": "Illimar",
     "lines": [
      {
       "et": "Aa, muidugi.",
       "en": "Ah, of course.",
       "az": "Aa, əlbəttə.",
       "ru": "А, конечно."
      }
     ]
    },
    {
     "who": "Johanna",
     "lines": [
      {
       "et": "Ma mõtlesin, et toidust võiks pilti teha.",
       "en": "I meant we could take a picture of the food.",
       "az": "Mən yeməyin şəklini çəkməyi nəzərdə tuturdum.",
       "ru": "Я имела в виду, что можно сфотографировать еду."
      }
     ]
    },
    {
     "who": "Illimar",
     "lines": [
      {
       "et": "Teeme siis toidust ka.",
       "en": "Let's take one of the food too, then.",
       "az": "Onda yeməyin də şəklini çəkək.",
       "ru": "Тогда сфотографируем и еду."
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Palun.",
       "en": "Here you are.",
       "az": "Buyurun.",
       "ru": "Пожалуйста."
      },
      {
       "et": "Teie leib.",
       "en": "Your bread.",
       "az": "Çörəyiniz.",
       "ru": "Ваш хлеб."
      }
     ]
    },
    {
     "who": "Illimar",
     "lines": [
      {
       "et": "Tänud.",
       "en": "Thanks.",
       "az": "Təşəkkürlər.",
       "ru": "Спасибо."
      }
     ]
    },
    {
     "who": "Johanna",
     "lines": [
      {
       "et": "Jätku leiba siis, Illimar!",
       "en": "Jätku leiba, then, Illimar!",
       "az": "Onda nuş olsun, Illimar!",
       "ru": "Ну, jätku leiba, Illimar!"
      },
      {
       "et": "Hakkame sööma.",
       "en": "Let's start eating.",
       "az": "Başlayaq yeməyə.",
       "ru": "Давай есть."
      }
     ]
    },
    {
     "who": "Illimar",
     "lines": [
      {
       "et": "Jätku tarvis.",
       "en": "Jätku tarvis — thanks, and the same to you.",
       "az": "Jätku tarvis — sağ ol, sənə də.",
       "ru": "Jätku tarvis — спасибо, и тебе."
      }
     ]
    },
    {
     "who": "Johanna",
     "lines": [
      {
       "et": "Kuidas sulle supp maitseb?",
       "en": "How is the soup?",
       "az": "Şorba necədir?",
       "ru": "Как тебе суп?"
      },
      {
       "et": "Šašlõkk on küll suurepärane.",
       "en": "The shashlik is excellent.",
       "az": "Şaşlık əladır.",
       "ru": "Шашлык просто отличный."
      }
     ]
    },
    {
     "who": "Illimar",
     "lines": [
      {
       "et": "Täitsa söödav supp.",
       "en": "Quite an edible soup.",
       "az": "Yeməli şorbadır.",
       "ru": "Вполне съедобный суп."
      },
      {
       "et": "Minu ema teeb muidugi veel paremat kalasuppi.",
       "en": "My mother makes an even better fish soup, of course.",
       "az": "Anam, əlbəttə, daha yaxşı balıq şorbası bişirir.",
       "ru": "Моя мама, конечно, варит рыбный суп ещё лучше."
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Oi, kas šašlõkk ei maitsenud teile?",
       "en": "Oh, didn't you like the shashlik?",
       "az": "Oy, şaşlık xoşunuza gəlmədi?",
       "ru": "Ой, вам не понравился шашлык?"
      }
     ]
    },
    {
     "who": "Johanna",
     "lines": [
      {
       "et": "Vastupidi, väga maitses.",
       "en": "On the contrary, I liked it a lot.",
       "az": "Əksinə, çox xoşuma gəldi.",
       "ru": "Наоборот, очень понравился."
      },
      {
       "et": "Lihtsalt see portsjon oli hirmus suur.",
       "en": "It's just that the portion was terribly big.",
       "az": "Sadəcə porsiya dəhşətli böyük idi.",
       "ru": "Просто порция была ужасно большая."
      },
      {
       "et": "Palun, kas te saaksite selle mulle kaasa pakkida?",
       "en": "Could you please pack it for me to take away?",
       "az": "Zəhmət olmasa, onu mənim üçün qablaşdıra bilərsiniz?",
       "ru": "Не могли бы вы завернуть мне его с собой?"
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Jah, loomulikult.",
       "en": "Yes, of course.",
       "az": "Bəli, əlbəttə.",
       "ru": "Да, разумеется."
      },
      {
       "et": "Kas kohvi või magustoitu ka soovite?",
       "en": "Would you like coffee or a dessert as well?",
       "az": "Kofe və ya desert də istəyirsiniz?",
       "ru": "Кофе или десерт желаете?"
      }
     ]
    },
    {
     "who": "Johanna",
     "lines": [
      {
       "et": "Kahjuks ei jaksa, kõht on tõesti väga täis.",
       "en": "Unfortunately I can't, I'm really very full.",
       "az": "Təəssüf ki, yox, doğrudan da çox toxam.",
       "ru": "К сожалению, не осилю, я правда очень сыта."
      },
      {
       "et": "Palun tooge arve.",
       "en": "Please bring the bill.",
       "az": "Zəhmət olmasa, hesabı gətirin.",
       "ru": "Принесите, пожалуйста, счёт."
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Kaardiga maksate, jah?",
       "en": "You're paying by card, yes?",
       "az": "Kartla ödəyirsiniz, eləmi?",
       "ru": "Платите картой, да?"
      },
      {
       "et": "Sel juhul tulge palun minuga kaasa, kaardiga saab meil ainult leti ääres maksta.",
       "en": "In that case please come with me — card payments are only at the counter here.",
       "az": "Onda, zəhmət olmasa, mənimlə gəlin — bizdə kartla ancaq piştaxtanın yanında ödəmək olar.",
       "ru": "Тогда пройдёмте, пожалуйста, со мной — картой у нас можно заплатить только у стойки."
      }
     ]
    }
   ]
  }
 ],
