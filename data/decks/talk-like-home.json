{
 "id": "talk-like-home",
 "added": "2026-10-07",
 "name": {
  "en": "Do you like your home?",
  "az": "Evini sevirsən?",
  "ru": "Тебе нравится твой дом?"
 },
 "why": {
  "en": "Arvo's Vancouver, Aleksandr's park next door, and Ingrid's squirrel that visits",
  "az": "Arvonun Vankuveri, Aleksandrın evinin yanındakı park və Ingridə qonaq gələn dələ",
  "ru": "Ванкувер Arvo, парк рядом с домом Aleksandr и белка, которая ходит в гости к Ingrid"
 },
 "taste": "Minu kodu kõrval on park",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Kas sulle meeldib sinu kodu?",
    "en": "Do you like your home?",
    "az": "Evini sevirsən?",
    "ru": "Тебе нравится твой дом?"
   },
   "turns": [
    {
     "who": "Arvo",
     "lines": [
      {
       "et": "Ikka meeldib.",
       "en": "Sure I do.",
       "az": "Əlbəttə, sevirəm.",
       "ru": "Конечно, нравится."
      },
      {
       "et": "Vancouver on ilus.",
       "en": "Vancouver is beautiful.",
       "az": "Vankuver gözəldir.",
       "ru": "Ванкувер красивый."
      },
      {
       "et": "Meil on meri, meil on mäed ja mets, vihmamets.",
       "en": "We have the ocean, we have the mountains and the forest, the rainforest.",
       "az": "Bizdə dəniz var, dağlar və meşə var, tropik meşə.",
       "ru": "У нас есть море, есть горы и лес, дождевой лес."
      },
      {
       "et": "Vancouver on väga ilus linn.",
       "en": "Vancouver is a very beautiful city.",
       "az": "Vankuver çox gözəl şəhərdir.",
       "ru": "Ванкувер — очень красивый город."
      },
      {
       "et": "Meil on rannad ka.",
       "en": "We have beaches, too.",
       "az": "Çimərliklərimiz də var.",
       "ru": "У нас и пляжи есть."
      },
      {
       "et": "Vaata, kus mujal maailmas sa võid minna kesklinna või all-linna ja seal on mererand.",
       "en": "You see, where else in the world could you go to the city centre or downtown and have a beach there?",
       "az": "Bax, dünyanın başqa harasında şəhər mərkəzinə gedib orada dəniz sahili tapa bilərsən?",
       "ru": "Смотри, где ещё в мире можно пойти в центр города или в даунтаун, а там морской пляж?"
      },
      {
       "et": "Selline kombinatsioon on lihtsalt väga ilus: mäed, meri ja mets.",
       "en": "It's just beautiful, this combination: mountains, ocean and forest.",
       "az": "Belə birləşmə sadəcə çox gözəldir: dağlar, dəniz və meşə.",
       "ru": "Такое сочетание просто очень красиво: горы, море и лес."
      },
      {
       "et": "Meil kasvavad ja õitsevad ka igasugused taimed.",
       "en": "We have all sorts of plants growing and blossoming here, too.",
       "az": "Bizdə hər cür bitki də böyüyür və çiçək açır.",
       "ru": "У нас растут и цветут всякие растения."
      }
     ]
    },
    {
     "who": "Arvo",
     "lines": [
      {
       "et": "Räägitakse, et Vancouver on väga sarnane Rio de Janeiroga ja Sydney, Hongkongi või Cape Towniga.",
       "en": "They say Vancouver is very similar to Rio de Janeiro and Sydney, Hong Kong or Cape Town.",
       "az": "Deyirlər ki, Vankuver Rio-de-Janeyroya və Sidneyə, Honkonqa və ya Keyptauna çox oxşayır.",
       "ru": "Говорят, что Ванкувер очень похож на Рио-де-Жанейро и Сидней, Гонконг или Кейптаун."
      },
      {
       "et": "Jah, Vancouver on ilus linn.",
       "en": "Yes, Vancouver is a beautiful city.",
       "az": "Bəli, Vankuver gözəl şəhərdir.",
       "ru": "Да, Ванкувер красивый город."
      },
      {
       "et": "Ma olen Sydneys käinud ja ma ütlen teile, et mina sinna ei koliks.",
       "en": "I have been to Sydney, and I tell you, I wouldn't move there.",
       "az": "Mən Sidneydə olmuşam və sizə deyirəm ki, ora köçməzdim.",
       "ru": "Я бывал в Сиднее и скажу вам, что туда я бы не переехал."
      },
      {
       "et": "Mina jääksin Vancouverisse.",
       "en": "I would stay in Vancouver.",
       "az": "Mən Vankuverdə qalardım.",
       "ru": "Я бы остался в Ванкувере."
      }
     ]
    },
    {
     "who": "Aleksandr",
     "lines": [
      {
       "et": "No kindlasti mulle meeldib minu kodu, sest see kant on väga ilus.",
       "en": "Sure I like my home, because the neighbourhood is very beautiful.",
       "az": "Əlbəttə, evimi sevirəm, çünki o tərəflər çox gözəldir.",
       "ru": "Ну конечно, мне нравится мой дом, потому что этот район очень красивый."
      },
      {
       "et": "Minu kodu kõrval on park, kus on hästi palju puid ja muud rohelist.",
       "en": "There's a park next to my home, with lots of trees and other greenery.",
       "az": "Evimin yanında park var, orada çoxlu ağac və başqa yaşıllıq var.",
       "ru": "Рядом с моим домом есть парк, где очень много деревьев и другой зелени."
      }
     ]
    },
    {
     "who": "Ingrid",
     "lines": [
      {
       "et": "Minule väga meeldib minu kodu!",
       "en": "I like my home a lot!",
       "az": "Mən evimi çox sevirəm!",
       "ru": "Мне очень нравится мой дом!"
      },
      {
       "et": "Vaadake, siin on kased ja siin on palju rohelust.",
       "en": "Look, there are birch trees here and there is lots of greenery.",
       "az": "Baxın, burada ağcaqayınlar var və çoxlu yaşıllıq var.",
       "ru": "Посмотрите, здесь берёзы и много зелени."
      },
      {
       "et": "Lust on siin elada, minule väga meeldib!",
       "en": "It's a joy to live here, I like it a lot!",
       "az": "Burada yaşamaq zövqdür, çox xoşuma gəlir!",
       "ru": "Жить здесь — одно удовольствие, мне очень нравится!"
      },
      {
       "et": "Mul käib siin isegi üks väike orav külas.",
       "en": "I even have a small squirrel visiting me here.",
       "az": "Hətta bir balaca dələ də mənə qonaq gəlir.",
       "ru": "Ко мне сюда даже белочка в гости ходит."
      },
      {
       "et": "See vudib siin kogu aeg edasi-tagasi.",
       "en": "It scurries back and forth here all the time.",
       "az": "O, bütün günü burada o yan-bu yana qaçır.",
       "ru": "Она всё время шныряет туда-сюда."
      },
      {
       "et": "Selline armas väike orav.",
       "en": "Such a sweet little squirrel.",
       "az": "Elə şirin balaca dələdir.",
       "ru": "Такая милая маленькая белочка."
      },
      {
       "et": "Mu lapsed on ka teda näinud, kui ta siin vahel jookseb.",
       "en": "My kids have seen it too, when it runs about here sometimes.",
       "az": "Uşaqlarım da onu görüblər, bəzən burada qaçanda.",
       "ru": "Мои дети тоже её видели, когда она иногда здесь бегает."
      }
     ]
    }
   ]
  }
 ],
