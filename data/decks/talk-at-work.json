{
 "id": "talk-at-work",
 "added": "2026-11-05",
 "name": {
  "en": "What you do at work",
  "az": "İşdə nə edirsən",
  "ru": "Что ты делаешь на работе"
 },
 "why": {
  "en": "An intensive-care nurse, a guitar teacher, a children’s football coach and a hairdresser on what their work is",
  "az": "Reanimasiya tibb bacısı, gitara müəllimi, balacaların məşqçisi və bərbər işlərinin nə olduğundan danışır",
  "ru": "Медсестра реанимации, учитель гитары, тренер малышей и парикмахер рассказывают, в чём их работа"
 },
 "taste": "Tuleb klient.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Mida sa tööl teed?",
    "en": "What do you do at work?",
    "az": "İşdə nə edirsən?",
    "ru": "Что ты делаешь на работе?"
   },
   "turns": [
    {
     "who": "Piret",
     "lines": [
      {
       "et": "Põhiliselt tähendab intensiivraviõe töö patsientide jälgimist, nende seisundi jälgimist.",
       "en": "Mainly an intensive-care nurse’s work means watching the patients, watching their condition.",
       "az": "Reanimasiya tibb bacısının işi əsasən xəstələri izləmək, onların vəziyyətini izləmək deməkdir.",
       "ru": "В основном работа медсестры реанимации — это наблюдение за пациентами, наблюдение за их состоянием."
      },
      {
       "et": "Kui on vaja, siis tuleb sekkuda kas protseduuride või ravimitega.",
       "en": "If it’s necessary, you have to step in, either with procedures or with medicines.",
       "az": "Lazım olanda ya prosedurlarla, ya da dərmanlarla müdaxilə etmək lazım gəlir.",
       "ru": "Если нужно, приходится вмешиваться — процедурами или лекарствами."
      },
      {
       "et": "Kui midagi juhtub, teavitatakse sellest arsti, kes siis annab vastavad korraldused.",
       "en": "If something happens, the doctor is told, and then gives the orders that are needed.",
       "az": "Nəsə baş verəndə bu barədə həkimə xəbər verilir, o da lazımi göstərişləri verir.",
       "ru": "Если что-то случается, об этом сообщают врачу, и он даёт соответствующие распоряжения."
      },
      {
       "et": "Üldiselt hakkame siis ikkagi koostöös arsti ja kogu meeskonnaga, kuhu kuulub veel hooldaja, tegutsema.",
       "en": "Generally we then act together with the doctor and the whole team, which also includes a care assistant.",
       "az": "Ümumiyyətlə, sonra həkim və bütün komanda ilə birlikdə hərəkət edirik, komandaya bir də baxıcı daxildir.",
       "ru": "Обычно мы тогда всё-таки действуем вместе с врачом и всей командой, в которую входит ещё и санитар."
      },
      {
       "et": "Võime teha uuringuid, teha protseduure, anda ravimeid või lihtsalt jälgida.",
       "en": "We may do tests, do procedures, give medicines or simply watch.",
       "az": "Müayinələr edə, prosedurlar apara, dərman verə və ya sadəcə izləyə bilərik.",
       "ru": "Мы можем делать обследования, проводить процедуры, давать лекарства или просто наблюдать."
      }
     ]
    },
    {
     "who": "Johannes",
     "lines": [
      {
       "et": "Ma õpetan lastemuusikakoolis väikseid tulevasi kitarrivirtuoose.",
       "en": "I teach little future guitar virtuosos at a children’s music school.",
       "az": "Uşaq musiqi məktəbində balaca gələcək gitara virtuozlarına dərs deyirəm.",
       "ru": "Я учу маленьких будущих гитарных виртуозов в детской музыкальной школе."
      },
      {
       "et": "Lapsed on keskmiselt üheteist-kaheteistaastased, osa on nooremad, osa on natuke vanemad.",
       "en": "The children are eleven or twelve on average; some are younger, some a little older.",
       "az": "Uşaqlar orta hesabla on bir-on iki yaşındadırlar, bəziləri daha kiçik, bəziləri bir az böyükdür.",
       "ru": "Детям в среднем одиннадцать-двенадцать лет, некоторые младше, некоторые немного старше."
      },
      {
       "et": "Praegu on mul neid kaheksa, teen kõigiga kaks korda nädalas individuaaltunde.",
       "en": "At the moment I have eight of them, and I give each of them a private lesson twice a week.",
       "az": "Hazırda onlardan səkkizi var, hamısı ilə həftədə iki dəfə fərdi dərs keçirəm.",
       "ru": "Сейчас их у меня восемь, со всеми я два раза в неделю занимаюсь индивидуально."
      }
     ]
    },
    {
     "who": "Ott",
     "lines": [
      {
       "et": "Tavaliselt alustan trennides soojendusega.",
       "en": "I usually start the training sessions with a warm-up.",
       "az": "Məşqlərə adətən istiləşmə ilə başlayıram.",
       "ru": "Обычно я начинаю тренировки с разминки."
      },
      {
       "et": "Väiksemate puhul töötavad väga hästi erinevad kullimängud.",
       "en": "With the smaller ones, all kinds of tag games work very well.",
       "az": "Balacalarla müxtəlif tutmaca oyunları çox yaxşı alınır.",
       "ru": "С малышами очень хорошо работают разные игры в салки."
      },
      {
       "et": "Ja üldse kõik see, kus saab hästi kiiresti ja hästi palju joosta.",
       "en": "And generally anything where you get to run really fast and really a lot.",
       "az": "Ümumiyyətlə, çox sürətlə və çox qaçmaq olan hər şey.",
       "ru": "И вообще всё, где можно очень быстро и очень много бегать."
      },
      {
       "et": "Ja lõpus jällegi annan lastele vabad käed.",
       "en": "And at the end I give the children a free hand again.",
       "az": "Sonda isə yenə uşaqlara sərbəstlik verirəm.",
       "ru": "А в конце я опять даю детям свободу."
      },
      {
       "et": "Kui nad tahavad mängida mõnda pallimängu, näiteks rahvastepalli, siis minugi poolest, peaasi, et laps liigub.",
       "en": "If they want to play some ball game, dodgeball for instance, that’s fine by me; the main thing is that the child moves.",
       "az": "Hansısa top oyunu oynamaq istəsələr, məsələn, “yakan top”, mənim üçün fərqi yoxdur, əsas odur ki, uşaq hərəkət etsin.",
       "ru": "Если они хотят поиграть в какую-нибудь игру с мячом, например в вышибалы, то я не против — главное, чтобы ребёнок двигался."
      }
     ]
    },
    {
     "who": "Marita",
     "lines": [
      {
       "et": "Tuleb klient.",
       "en": "A client comes in.",
       "az": "Müştəri gəlir.",
       "ru": "Приходит клиентка."
      },
      {
       "et": "Ma võtan ta avasüli vastu.",
       "en": "I welcome her with open arms.",
       "az": "Onu açıq qucaqla qarşılayıram.",
       "ru": "Я встречаю её с распростёртыми объятиями."
      },
      {
       "et": "Siis kõigepealt pesen kliendil pea.",
       "en": "Then first of all I wash the client’s hair.",
       "az": "Sonra ilk növbədə müştərinin başını yuyuram.",
       "ru": "Потом первым делом мою клиентке голову."
      },
      {
       "et": "Teen peamassaaži.",
       "en": "I do a head massage.",
       "az": "Baş masajı edirəm.",
       "ru": "Делаю массаж головы."
      },
      {
       "et": "Ja siis vastavalt sellele, kas klient soovib juukseid lõigata või värvida, siis vastavalt sellele tegutsen.",
       "en": "And then, depending on whether the client wants her hair cut or coloured, I act accordingly.",
       "az": "Sonra da müştərinin saçını kəsdirmək, yoxsa boyatmaq istəməsindən asılı olaraq, ona uyğun hərəkət edirəm.",
       "ru": "А потом, в зависимости от того, хочет ли клиентка подстричься или покраситься, действую соответственно."
      }
     ]
    }
   ]
  }
 ],
