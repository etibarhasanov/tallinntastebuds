{
 "id": "talk-summer",
 "added": "2026-11-05",
 "name": {
  "en": "What you do in summer",
  "az": "Yayda nə edirsən",
  "ru": "Что ты делаешь летом"
 },
 "why": {
  "en": "Camping round Estonia, a beer on a summer evening, the football season and a bike ride further afield",
  "az": "Estoniyada çadırda gəzinti, yay axşamı bir pivə, futbol mövsümü və velosipedlə uzaqlara səfər",
  "ru": "Палатки по всей Эстонии, пиво летним вечером, футбольный сезон и поездка на велосипеде подальше"
 },
 "taste": "Mängime lauatennist.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Mida sa teed suvel?",
    "en": "What do you do in summer?",
    "az": "Yayda nə edirsən?",
    "ru": "Что ты делаешь летом?"
   },
   "turns": [
    {
     "who": "Johannes",
     "lines": [
      {
       "et": "Suviti ma käin mööda Eestimaad ringi.",
       "en": "In summer I travel round Estonia.",
       "az": "Yayda Estoniyanı gəzirəm.",
       "ru": "Летом я езжу по Эстонии."
      },
      {
       "et": "Aeg-ajalt lähen kuskile loodusesse telkima.",
       "en": "From time to time I go camping somewhere out in nature.",
       "az": "Arabir təbiətə, hansısa bir yerə çadır qurmağa gedirəm.",
       "ru": "Время от времени уезжаю куда-нибудь на природу с палаткой."
      },
      {
       "et": "Vahepeal käin rannas, võtan päikest, käin sõpradega väljas, joome õhtul õlut kuskil.",
       "en": "In between I go to the beach, sunbathe, go out with friends, and we have a beer somewhere in the evening.",
       "az": "Arada çimərliyə gedirəm, günəş vannası qəbul edirəm, dostlarla bayıra çıxıram, axşam haradasa pivə içirik.",
       "ru": "В промежутках хожу на пляж, загораю, выбираюсь с друзьями куда-нибудь, вечером пьём где-нибудь пиво."
      },
      {
       "et": "Mängime lauatennist.",
       "en": "We play table tennis.",
       "az": "Stolüstü tennis oynayırıq.",
       "ru": "Играем в настольный теннис."
      }
     ]
    },
    {
     "who": "Ott",
     "lines": [
      {
       "et": "Suvel meeldib mulle rattaga sõita ja teha väljas sporti.",
       "en": "In summer I like cycling and doing sport outdoors.",
       "az": "Yayda velosiped sürməyi və çöldə idmanla məşğul olmağı sevirəm.",
       "ru": "Летом мне нравится кататься на велосипеде и заниматься спортом на улице."
      },
      {
       "et": "Siis algab ka jalgpallihooaeg ja väljas saab mängida korvpalli.",
       "en": "Then the football season starts too, and you can play basketball outdoors.",
       "az": "Onda futbol mövsümü də başlayır, çöldə basketbol da oynamaq olur.",
       "ru": "Тогда начинается и футбольный сезон, и на улице можно играть в баскетбол."
      },
      {
       "et": "Siis on nii palju võimalusi, mida teha.",
       "en": "Then there are so many things you can do.",
       "az": "Onda görüləsi o qədər imkan olur ki.",
       "ru": "Тогда столько всего можно делать."
      },
      {
       "et": "Oleneb päevast, mida ma teha tahaksin.",
       "en": "What I would like to do depends on the day.",
       "az": "Nə etmək istədiyim gündən asılıdır.",
       "ru": "Что мне хочется делать, зависит от дня."
      }
     ]
    },
    {
     "who": "Piret",
     "lines": [
      {
       "et": "Suvel käin ka matkamas ja võib-olla telkimas.",
       "en": "In summer I also go hiking and maybe camping.",
       "az": "Yayda yürüşə də gedirəm, bəlkə də çadırda qalmağa.",
       "ru": "Летом я ещё хожу в походы и, может быть, с палаткой."
      },
      {
       "et": "Ja rattaga saab sõita kuhugi kaugemale juba!",
       "en": "And by then you can cycle somewhere further away!",
       "az": "Artıq velosipedlə haradasa daha uzağa getmək olur!",
       "ru": "И на велосипеде уже можно уехать куда-нибудь подальше!"
      }
     ]
    }
   ]
  }
 ],
