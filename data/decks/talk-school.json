{
 "id": "talk-school",
 "added": "2026-10-07",
 "name": {
  "en": "Where did you go to school?",
  "az": "Harada məktəbə getmisən?",
  "ru": "Где ты учился в школе?"
 },
 "why": {
  "en": "Mirja changes schools for the third grade, Mai Riin moves to a new building, and Jüri starts in October",
  "az": "Mirja üçüncü sinifdə məktəbini dəyişir, Mai Riin yeni binaya keçir, Jüri isə məktəbə oktyabrda başlayır",
  "ru": "Mirja меняет школу в третьем классе, Mai Riin переходит в новое здание, а Jüri идёт в школу в октябре"
 },
 "taste": "Mina läksin kooli 1960. aastal.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Kus sa koolis oled käinud?",
    "en": "Where did you go to school?",
    "az": "Harada məktəbə getmisən?",
    "ru": "Где ты учился в школе?"
   },
   "turns": [
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Läksin kooli üheksakümne neljandal aastal, olin siis kuueaastane.",
       "en": "I went to school in ninety-four; I was six then.",
       "az": "Doxsan dördüncü ildə məktəbə getdim, onda altı yaşım vardı.",
       "ru": "Я пошла в школу в девяносто четвёртом году, мне тогда было шесть лет."
      },
      {
       "et": "Kaks aastat hiljem läksin järgmisse kooli, sest meie perekond kolis teise linna otsa ja siis me otsustasime, et selleks, et lastel oleks kergem koolis käia, tuleb kooli vahetada.",
       "en": "Two years later I went to another school, because our family moved to the other end of town, and we decided that to make it easier for the children to get to school, we had to change schools.",
       "az": "İki il sonra başqa məktəbə keçdim, çünki ailəmiz şəhərin o biri başına köçdü və biz qərara gəldik ki, uşaqlar üçün məktəbə getmək asan olsun deyə məktəbi dəyişmək lazımdır.",
       "ru": "Через два года я перешла в другую школу, потому что наша семья переехала на другой конец города, и мы решили, что, чтобы детям было легче ходить в школу, надо сменить школу."
      },
      {
       "et": "Kolmandasse klassi läksin siis Descartes'i lütseumi.",
       "en": "So for the third grade I went to the Descartes Lyceum.",
       "az": "Üçüncü sinfə artıq Dekart liseyinə getdim.",
       "ru": "В третий класс я пошла уже в Декартовский лицей."
      },
      {
       "et": "Seal ma olin keskkooli lõpuni.",
       "en": "I stayed there until the end of secondary school.",
       "az": "Orada orta məktəbi bitirənə qədər oxudum.",
       "ru": "Там я и училась до конца средней школы."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Siis ma läksin ülikooli, see oli aastal 2006.",
       "en": "Then I went to university; that was in 2006.",
       "az": "Sonra universitetə getdim, bu 2006-cı ildə idi.",
       "ru": "Потом я поступила в университет, это было в 2006 году."
      },
      {
       "et": "Ja ma käisin natuke kauem ülikoolis kui mõned teised inimesed.",
       "en": "And I was at university a little longer than some other people.",
       "az": "Universitetdə bəzi başqa adamlardan bir az uzun oxudum.",
       "ru": "И я проучилась в университете немного дольше, чем некоторые другие."
      },
      {
       "et": "Lõpetasin aastal 2010 bakalaureuse- ja hiljem aastal 2013 magistriõppe.",
       "en": "I finished my bachelor's in 2010 and later, in 2013, my master's.",
       "az": "2010-cu ildə bakalavrı, sonra 2013-cü ildə magistraturanı bitirdim.",
       "ru": "В 2010 году я окончила бакалавриат, а позже, в 2013 году, магистратуру."
      },
      {
       "et": "Ja siis läksin tööle.",
       "en": "And then I went to work.",
       "ru": "А потом пошла работать.",
       "az": "Sonra da işə getdim."
      }
     ]
    },
    {
     "who": "Mai Riin",
     "lines": [
      {
       "et": "Ma alustasin oma kooliteed Püünsi Põhikoolist ja lõpetasin selle 2016. aastal.",
       "en": "I started my schooling at Püünsi Basic School and finished it in 2016.",
       "az": "Məktəb yolumu Püünsi əsas məktəbində başladım və onu 2016-cı ildə bitirdim.",
       "ru": "Я начала учиться в Пююнсиской основной школе и окончила её в 2016 году."
      },
      {
       "et": "Peale seda ma läksin Viimsi Keskkooli.",
       "en": "After that I went to Viimsi Secondary School.",
       "az": "Ondan sonra Viimsi orta məktəbinə getdim.",
       "ru": "После этого я пошла в Виймсискую среднюю школу."
      },
      {
       "et": "Aga järgmisest aastast ma õpin Viimsi Riigigümnaasiumis, sest nad ehitasid uue koolimaja.",
       "en": "But from next year I'll be studying at Viimsi State Gymnasium, because they built a new school building.",
       "az": "Amma gələn ildən Viimsi Dövlət Gimnaziyasında oxuyacağam, çünki onlar yeni məktəb binası tikdilər.",
       "ru": "Но со следующего года я учусь в Виймсиской государственной гимназии, потому что они построили новое здание школы."
      },
      {
       "et": "Ja siis loodetavasti 2019. aastal ma lõpetan Viimsi Riigigümnaasiumi.",
       "en": "And then, hopefully, in 2019 I'll graduate from Viimsi State Gymnasium.",
       "az": "Sonra da, ümid edirəm, 2019-cu ildə Viimsi Dövlət Gimnaziyasını bitirəcəyəm.",
       "ru": "И потом, надеюсь, в 2019 году я окончу Виймсискую государственную гимназию."
      }
     ]
    },
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Mina läksin kooli 1960. aastal.",
       "en": "I went to school in 1960.",
       "az": "Mən 1960-cı ildə məktəbə getdim.",
       "ru": "Я пошёл в школу в 1960 году."
      },
      {
       "et": "Ja hiljem kui teised, sest kui kool algas esimesel septembril, siis ma ei olnud veel seitsmeaastane ja vanemad arvasid, et las poiss olla ühe aasta veel kodus.",
       "en": "And later than the others, because when school started on the first of September I wasn't seven yet, and my parents thought: let the boy stay at home one more year.",
       "az": "Özü də başqalarından gec, çünki məktəb sentyabrın birində başlayanda mənim hələ yeddi yaşım yox idi və valideynlərim düşündülər ki, qoy oğlan bir il də evdə qalsın.",
       "ru": "И позже, чем другие, потому что, когда первого сентября начались занятия, мне ещё не было семи лет, и родители решили: пусть мальчик ещё годик побудет дома."
      }
     ]
    },
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Mul oli hoidja, vana kokamamma, kunagi Peterburis teeninud väga väärikas daam.",
       "en": "I had a nanny, an old cook, a very dignified lady who had once been in service in St Petersburg.",
       "az": "Mənim dayəm vardı, qoca aşpaz qadın, vaxtilə Peterburqda xidmət etmiş çox ləyaqətli bir xanım.",
       "ru": "У меня была няня, старая кухарка, очень достойная дама, когда-то служившая в Петербурге."
      },
      {
       "et": "Kahjuks tema septembris suri ära.",
       "en": "Sadly she died in September.",
       "az": "Təəssüf ki, o, sentyabrda öldü.",
       "ru": "К сожалению, в сентябре она умерла."
      },
      {
       "et": "Ja siis selgus, et poiss ei taha üksi kodus olla, et poiss tahab kooli minna.",
       "en": "And then it turned out that the boy didn't want to be at home alone, that the boy wanted to go to school.",
       "az": "Sonra məlum oldu ki, oğlan evdə tək qalmaq istəmir, oğlan məktəbə getmək istəyir.",
       "ru": "И тогда выяснилось, что мальчик не хочет оставаться дома один, что мальчик хочет в школу."
      },
      {
       "et": "Ema käis siis direktoriga rääkimas ja nii mind võeti oktoobri teisel poolel kooli.",
       "en": "So my mother went to talk to the head teacher, and that's how I was taken into school in the second half of October.",
       "az": "Anam direktorla danışmağa getdi və beləcə məni oktyabrın ikinci yarısında məktəbə götürdülər.",
       "ru": "Мама сходила поговорить с директором, и так меня во второй половине октября взяли в школу."
      },
      {
       "et": "Ja seal ma käisin 11. klassi lõpuni.",
       "en": "And I went there until the end of the 11th grade.",
       "az": "Orada 11-ci sinfin sonuna qədər oxudum.",
       "ru": "И там я учился до конца 11-го класса."
      },
      {
       "et": "Nii et keskkooli olen ma lõpetanud traktoristi-mehhanisaatorina, traktoristi paberitega, hiljem sain veel mootorrattaload ja ülikoolis loomulikult autojuhiload.",
       "en": "So I finished secondary school as a tractor driver-mechanic, with tractor driver's papers; later I also got a motorbike licence and, at university, of course, a driving licence.",
       "az": "Yəni orta məktəbi traktorçu-mexanizator kimi, traktorçu sənədləri ilə bitirmişəm, sonra motosiklet vəsiqəsi, universitetdə isə, əlbəttə, sürücülük vəsiqəsi də aldım.",
       "ru": "Так что среднюю школу я окончил трактористом-механизатором, с правами тракториста, позже получил ещё права на мотоцикл, а в университете, конечно, водительские права."
      }
     ]
    },
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Siis ma läksin õppima Tartu Ülikooli ja selle mõttega ausalt öelda oli mind harjutatud juba ma ei tea kui kaua, sest meie suguvõsas oli kõrgema haridusega inimesi väga vähe.",
       "en": "Then I went to study at the University of Tartu, and, to be honest, I had been made used to that idea for I don't know how long, because in our extended family there were very few people with higher education.",
       "az": "Sonra Tartu Universitetinə oxumağa getdim və düzünü desəm, məni bu fikrə bilmirəm nə vaxtdan öyrəşdirmişdilər, çünki bizim nəsildə ali təhsilli adam çox az idi.",
       "ru": "Потом я поехал учиться в Тартуский университет, и, честно говоря, к этой мысли меня приучали уже не знаю сколько времени, потому что в нашей родне людей с высшим образованием было очень мало."
      },
      {
       "et": "Nii et ma teadsin kindlalt, et kui keskkool on läbi, lähen loomulikult ülikooli.",
       "en": "So I knew for certain that when secondary school was over, I would of course go to university.",
       "az": "Ona görə də dəqiq bilirdim ki, orta məktəb bitən kimi, təbii ki, universitetə gedəcəyəm.",
       "ru": "Так что я твёрдо знал, что, когда школа закончится, я, конечно, пойду в университет."
      },
      {
       "et": "Ja ainus küsimus oli: mida õppida?",
       "en": "And the only question was: what to study?",
       "az": "Yeganə sual bu idi: nə oxumalı?",
       "ru": "И единственный вопрос был: что изучать?"
      }
     ]
    },
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Minu valik langes filoloogia kasuks.",
       "en": "My choice fell on philology.",
       "az": "Seçimim filologiyanın xeyrinə oldu.",
       "ru": "Мой выбор пал на филологию."
      },
      {
       "et": "Konkurss oli päris suur, aga ma sain sisse.",
       "en": "The competition was quite stiff, but I got in.",
       "az": "Müsabiqə xeyli böyük idi, amma qəbul oldum.",
       "ru": "Конкурс был довольно большой, но я поступил."
      },
      {
       "et": "Ma lõpetasin ülikooli 1976. aastal ja siis sai see tore aeg läbi.",
       "en": "I graduated from university in 1976, and then that wonderful time was over.",
       "az": "Universiteti 1976-cı ildə bitirdim və o gözəl vaxt da bununla bitdi.",
       "ru": "Я окончил университет в 1976 году, и на этом то прекрасное время закончилось."
      }
     ]
    }
   ]
  }
 ],
