{
 "id": "talk-bus",
 "added": "2026-10-07",
 "name": {
  "en": "Buying a bus ticket",
  "az": "Avtobus bileti almaq",
  "ru": "Покупка билета на автобус"
 },
 "why": {
  "en": "The three and the four o'clock are sold out, so a discount ticket to Tallinn on the half past three",
  "az": "Saat üçün və dördün avtobusları satılıb, ona görə Tallinnə saat üç yarımın avtobusuna güzəştli bilet",
  "ru": "На три и на четыре всё продано, так что льготный билет до Таллинна на половину четвёртого"
 },
 "taste": "Üks pilet Tallinna palun.",
 "source": "Keeletee",
 "scenes": [
  {
   "turns": [
    {
     "who": "Kassiir",
     "lines": [
      {
       "et": "Tere!",
       "en": "Hello!",
       "az": "Salam!",
       "ru": "Здравствуйте!"
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Üks pilet Tallinna palun.",
       "en": "One ticket to Tallinn, please.",
       "az": "Tallinnə bir bilet, xahiş edirəm.",
       "ru": "Один билет до Таллинна, пожалуйста."
      }
     ]
    },
    {
     "who": "Kassiir",
     "lines": [
      {
       "et": "Mis kellasele bussile?",
       "en": "For the bus at what time?",
       "az": "Saat neçənin avtobusuna?",
       "ru": "На автобус во сколько?"
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Kella kolmesele.",
       "en": "The three o'clock one.",
       "az": "Saat üçün avtobusuna.",
       "ru": "На трёхчасовой."
      }
     ]
    },
    {
     "who": "Kassiir",
     "lines": [
      {
       "et": "Kella kolmene on juba välja müüdud.",
       "en": "The three o'clock one is already sold out.",
       "az": "Saat üçün avtobusu artıq satılıb.",
       "ru": "На трёхчасовой уже всё продано."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Palun siis kella neljasele.",
       "en": "Then the four o'clock one, please.",
       "az": "Onda saat dördün avtobusuna, xahiş edirəm.",
       "ru": "Тогда, пожалуйста, на четырёхчасовой."
      }
     ]
    },
    {
     "who": "Kassiir",
     "lines": [
      {
       "et": "Kohe vaatan.",
       "en": "Let me have a look.",
       "az": "İndi baxıram.",
       "ru": "Сейчас посмотрю."
      },
      {
       "et": "See on ka välja müüdud.",
       "en": "That one is sold out too.",
       "az": "O da satılıb.",
       "ru": "На него тоже всё продано."
      },
      {
       "et": "Praegu on pileteid veel kella poole neljasele bussile.",
       "en": "At the moment there are still tickets for the half past three bus.",
       "az": "Hazırda hələ saat üç yarımın avtobusuna bilet var.",
       "ru": "Сейчас ещё есть билеты на автобус в половине четвёртого."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Kas see on ekspressbuss?",
       "en": "Is that an express bus?",
       "az": "Bu, ekspress avtobusdur?",
       "ru": "Это экспресс?"
      }
     ]
    },
    {
     "who": "Kassiir",
     "lines": [
      {
       "et": "Ei ole.",
       "en": "No, it isn't.",
       "az": "Xeyr.",
       "ru": "Нет."
      },
      {
       "et": "See on kiirliin.",
       "en": "It's a fast line.",
       "az": "Bu, sürətli xətdir.",
       "ru": "Это скорая линия."
      },
      {
       "et": "Peatub ka Põltsamaal ja Mäos ja Kosel ka.",
       "en": "It also stops at Põltsamaa and at Mäo and at Kose.",
       "az": "Põltsamaada, Mäoda və Kosedə də dayanır.",
       "ru": "Останавливается ещё в Пыльтсамаа, в Мяо и в Козе."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Hm.",
       "en": "Hm.",
       "az": "Hm.",
       "ru": "Хм."
      },
      {
       "et": "Mis kell see buss Tallinna jõuab?",
       "en": "What time does the bus get to Tallinn?",
       "az": "Bu avtobus Tallinnə saat neçədə çatır?",
       "ru": "Во сколько этот автобус приходит в Таллинн?"
      }
     ]
    },
    {
     "who": "Kassiir",
     "lines": [
      {
       "et": "Kolmveerand seitse.",
       "en": "Quarter to seven.",
       "az": "Yeddiyə on beş dəqiqə qalmış.",
       "ru": "Без четверти семь."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Kas selles bussis tasuta internet on?",
       "en": "Is there free internet on this bus?",
       "az": "Bu avtobusda pulsuz internet var?",
       "ru": "В этом автобусе есть бесплатный интернет?"
      }
     ]
    },
    {
     "who": "Kassiir",
     "lines": [
      {
       "et": "Peaks olema.",
       "en": "There should be.",
       "az": "Olmalıdır.",
       "ru": "Должен быть."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Mis seal siis ikka.",
       "en": "Oh well, never mind.",
       "az": "Nə edək, eybi yox.",
       "ru": "Ну что ж поделаешь."
      },
      {
       "et": "Üks sooduspilet siis palun.",
       "en": "One discount ticket, then, please.",
       "az": "Onda bir güzəştli bilet, xahiş edirəm.",
       "ru": "Тогда один льготный билет, пожалуйста."
      }
     ]
    },
    {
     "who": "Kassiir",
     "lines": [
      {
       "et": "Näidake palun dokumenti ka.",
       "en": "Please show me your document too.",
       "az": "Zəhmət olmasa, sənədinizi də göstərin.",
       "ru": "Покажите, пожалуйста, и документ."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Kohe.",
       "en": "Just a moment.",
       "az": "Bu dəqiqə.",
       "ru": "Сейчас."
      },
      {
       "et": "Palun.",
       "en": "Here you are.",
       "az": "Buyurun.",
       "ru": "Пожалуйста."
      }
     ]
    },
    {
     "who": "Kassiir",
     "lines": [
      {
       "et": "Nii, siin on teie pilet.",
       "en": "Right, here is your ticket.",
       "az": "Belə, bu da biletiniz.",
       "ru": "Так, вот ваш билет."
      },
      {
       "et": "Head reisi!",
       "en": "Have a good trip!",
       "az": "Yaxşı yol!",
       "ru": "Счастливого пути!"
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Aitäh.",
       "en": "Thank you.",
       "az": "Sağ olun.",
       "ru": "Спасибо."
      }
     ]
    }
   ]
  }
 ],
