{
 "id": "talk-colours",
 "added": "2026-10-07",
 "name": {
  "en": "Colours at home",
  "az": "Evdə rənglər",
  "ru": "Цвета в доме"
 },
 "why": {
  "en": "Calm Nordic greys, an all-white kitchen, and a yellow one with green wallpaper once",
  "az": "Sakit Şimal boz rəngləri, ağappaq mətbəx və bir vaxtlar yaşıl divar kağızı olan sarı mətbəx",
  "ru": "Спокойные северные серые тона, совсем белая кухня и жёлтая, где когда-то были зелёные обои"
 },
 "taste": "Meie köök on täiesti valge.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Missugused värvid sulle meeldivad?",
    "en": "Which colours do you like?",
    "az": "Hansı rənglər xoşuna gəlir?",
    "ru": "Какие цвета тебе нравятся?"
   },
   "turns": [
    {
     "who": "Aleksandr",
     "lines": [
      {
       "et": "Praegu mulle meeldivad sellised rahulikud värvid.",
       "en": "At the moment I like calm colours.",
       "az": "İndi belə sakit rənglər xoşuma gəlir.",
       "ru": "Сейчас мне нравятся такие спокойные цвета."
      },
      {
       "et": "Seda nimetatakse Põhjamaade disainiks või kujunduseks.",
       "en": "It's called Nordic design, or Nordic style.",
       "az": "Buna Şimal dizaynı və ya Şimal üslubu deyirlər.",
       "ru": "Это называют северным дизайном или оформлением."
      },
      {
       "et": "Mulle ei meeldi eredad või karjuvad värvid.",
       "en": "I don't like bright or loud colours.",
       "az": "Parlaq və ya qışqırıq rənglər xoşuma gəlmir.",
       "ru": "Мне не нравятся яркие или кричащие цвета."
      },
      {
       "et": "Mulle meeldivad rahulikud värvid, mis tekitavad hubasust ja rahu.",
       "en": "I like calm colours that create cosiness and peace.",
       "az": "Rahatlıq və dinclik yaradan sakit rənglər xoşuma gəlir.",
       "ru": "Мне нравятся спокойные цвета, которые создают уют и покой."
      },
      {
       "et": "Näiteks hallid ja rohelised värvid, sellised pastellvärvid.",
       "en": "For instance, grey and green colours, pastel tones like that.",
       "az": "Məsələn, boz və yaşıl rənglər, belə pastel rənglər.",
       "ru": "Например, серые и зелёные цвета, такие пастельные тона."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Mis värvi on sinu köök?",
    "en": "What colour is your kitchen?",
    "az": "Mətbəxin hansı rəngdədir?",
    "ru": "Какого цвета твоя кухня?"
   },
   "turns": [
    {
     "who": "Aleksandr",
     "lines": [
      {
       "et": "Meie köök on täiesti valge.",
       "en": "Our kitchen is completely white.",
       "az": "Bizim mətbəx tamamilə ağdır.",
       "ru": "Наша кухня совсем белая."
      },
      {
       "et": "Meil on suured kõrged valged kapid.",
       "en": "We have big, tall white cupboards.",
       "az": "Böyük, hündür ağ şkaflarımız var.",
       "ru": "У нас большие высокие белые шкафы."
      },
      {
       "et": "Musta värvi on ainult ahi, kraanikauss ja induktsioonpliit.",
       "en": "Only the oven, the sink and the induction hob are black.",
       "az": "Yalnız soba, əlüzyuyan və induksiya plitəsi qara rəngdədir.",
       "ru": "Чёрного цвета только духовка, раковина и индукционная плита."
      },
      {
       "et": "Ja tööpind köögis on loomulikult ka teist värvi, see on selline hallikas-pruun.",
       "en": "And the worktop is of course a different colour too, a sort of greyish brown.",
       "az": "Mətbəxdə iş səthi də təbii ki, başqa rəngdədir, belə bozumtul-qəhvəyi.",
       "ru": "А столешница на кухне, конечно, тоже другого цвета, такая серовато-коричневая."
      },
      {
       "et": "See värv sobib väga hästi kokku valge interjööriga.",
       "en": "That colour goes very well with the white interior.",
       "az": "Bu rəng ağ interyerlə çox yaxşı uyğun gəlir.",
       "ru": "Этот цвет очень хорошо сочетается с белым интерьером."
      },
      {
       "et": "Seinad on ka valged.",
       "en": "The walls are white too.",
       "az": "Divarlar da ağdır.",
       "ru": "Стены тоже белые."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Missugused värvid sulle meeldivad?",
    "en": "Which colours do you like?",
    "az": "Hansı rənglər xoşuna gəlir?",
    "ru": "Какие цвета тебе нравятся?"
   },
   "turns": [
    {
     "who": "Ingrid",
     "lines": [
      {
       "et": "Roheline meeldib, niisugune mitte väga tume roheline värv.",
       "en": "I like green, not a very dark green.",
       "az": "Yaşıl xoşuma gəlir, elə çox da tünd olmayan yaşıl rəng.",
       "ru": "Мне нравится зелёный, такой не очень тёмный зелёный цвет."
      },
      {
       "et": "Mul oli kunagi selline roheline tapeet.",
       "en": "I once had wallpaper of that green.",
       "az": "Bir vaxtlar məndə belə yaşıl divar kağızı vardı.",
       "ru": "У меня когда-то были такие зелёные обои."
      },
      {
       "et": "Siis meeldib mulle väga kollane värv.",
       "en": "Then I like yellow a lot.",
       "az": "Sonra sarı rəng çox xoşuma gəlir.",
       "ru": "Ещё мне очень нравится жёлтый цвет."
      },
      {
       "et": "Minu köök on kollane.",
       "en": "My kitchen is yellow.",
       "az": "Mənim mətbəxim sarıdır.",
       "ru": "Моя кухня жёлтая."
      },
      {
       "et": "Punane mulle eriti ei meeldi.",
       "en": "I don't much like red.",
       "az": "Qırmızı o qədər də xoşuma gəlmir.",
       "ru": "Красный мне не особо нравится."
      },
      {
       "et": "Beež ka meeldib, beež on ka väga armas.",
       "en": "I like beige too, beige is lovely as well.",
       "az": "Bej də xoşuma gəlir, bej də çox şirindir.",
       "ru": "Бежевый тоже нравится, бежевый тоже очень милый."
      },
      {
       "et": "Niisugused tagasihoidlikud värvid meeldivad mulle.",
       "en": "Modest colours like that are what I like.",
       "az": "Belə sadə, təvazökar rənglər xoşuma gəlir.",
       "ru": "Мне нравятся такие сдержанные цвета."
      }
     ]
    }
   ]
  }
 ],
