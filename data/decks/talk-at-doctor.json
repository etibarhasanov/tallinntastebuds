{
 "id": "talk-at-doctor",
 "added": "2026-11-05",
 "name": {
  "en": "At the doctor’s",
  "az": "Həkimin yanında",
  "ru": "У врача"
 },
 "why": {
  "en": "A cook’s right hand has hurt for two months: an injection, a scan next Wednesday, and no fishing",
  "az": "Aşpazın sağ əli iki aydır ağrıyır: iynə, gələn çərşənbə müayinə və balıq tutmaq yox",
  "ru": "У повара два месяца болит правая рука: укол, обследование в следующую среду и никакой рыбалки"
 },
 "taste": "Ma väga kardan süsti.",
 "source": "Keeletee",
 "scenes": [
  {
   "turns": [
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Tervist!",
       "en": "Hello!",
       "az": "Salam!",
       "ru": "Здравствуйте!"
      }
     ]
    },
    {
     "who": "Arst",
     "lines": [
      {
       "et": "Tere-tere!",
       "en": "Hello, hello!",
       "az": "Salam, salam!",
       "ru": "Здравствуйте, здравствуйте!"
      },
      {
       "et": "Kuidas te ennast tunnete?",
       "en": "How are you feeling?",
       "az": "Özünüzü necə hiss edirsiniz?",
       "ru": "Как вы себя чувствуете?"
      },
      {
       "et": "Mille üle kaebate?",
       "en": "What are you complaining of?",
       "az": "Nədən şikayətlənirsiniz?",
       "ru": "На что жалуетесь?"
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Mul see parem käsi valutab kohutavalt.",
       "en": "My right hand hurts terribly.",
       "az": "Sağ əlim dəhşətli ağrıyır.",
       "ru": "У меня ужасно болит правая рука."
      },
      {
       "et": "Päeval valutab, kui liigutan, ja öösel mõnikord on tuim, nii et ma üldse ei tunne enda kätt.",
       "en": "In the daytime it hurts when I move it, and at night it is sometimes numb, so that I can’t feel my hand at all.",
       "az": "Gündüz tərpədəndə ağrıyır, gecə isə bəzən keyiyir, elə ki, əlimi heç hiss etmirəm.",
       "ru": "Днём болит, когда двигаю, а ночью иногда немеет, так что я совсем не чувствую своей руки."
      },
      {
       "et": "Vahel on tunne, nagu sipelgad jookseksid …",
       "en": "Sometimes it feels as if ants were running…",
       "az": "Bəzən elə bil qarışqalar qaçır…",
       "ru": "Иногда такое чувство, будто бегают мурашки…"
      }
     ]
    },
    {
     "who": "Arst",
     "lines": [
      {
       "et": "Hm.",
       "en": "Hm.",
       "az": "Hm.",
       "ru": "Хм."
      },
      {
       "et": "Kas olete ise midagi teinud ka, et valu vähendada?",
       "en": "Have you done anything yourself to reduce the pain?",
       "az": "Ağrını azaltmaq üçün özünüz nəsə etmisinizmi?",
       "ru": "Вы сами что-нибудь делали, чтобы уменьшить боль?"
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Jah.",
       "en": "Yes.",
       "az": "Bəli.",
       "ru": "Да."
      },
      {
       "et": "Alguses võtsin valuvaigisteid.",
       "en": "At first I took painkillers.",
       "az": "Əvvəlcə ağrıkəsici içdim.",
       "ru": "Сначала я принимал обезболивающие."
      },
      {
       "et": "Siis käisin füsioterapeudi juures.",
       "en": "Then I went to a physiotherapist.",
       "az": "Sonra fizioterapevtin yanına getdim.",
       "ru": "Потом ходил к физиотерапевту."
      },
      {
       "et": "Seal tehti massaaži.",
       "en": "There I had a massage.",
       "az": "Orada masaj etdilər.",
       "ru": "Там мне делали массаж."
      },
      {
       "et": "Mitte miski pole aidanud.",
       "en": "Nothing at all has helped.",
       "az": "Heç nə kömək etməyib.",
       "ru": "Ничего не помогло."
      }
     ]
    },
    {
     "who": "Arst",
     "lines": [
      {
       "et": "Ja kui kaua see valu teil on olnud?",
       "en": "And how long have you had this pain?",
       "az": "Bəs bu ağrı sizdə nə vaxtdandır?",
       "ru": "А как давно у вас эта боль?"
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Umbes kaks kuud.",
       "en": "About two months.",
       "az": "Təxminən iki aydır.",
       "ru": "Около двух месяцев."
      }
     ]
    },
    {
     "who": "Arst",
     "lines": [
      {
       "et": "Ahah.",
       "en": "Ahah.",
       "az": "Aha.",
       "ru": "Ага."
      },
      {
       "et": "Vaatame.",
       "en": "Let’s see.",
       "az": "Baxaq.",
       "ru": "Посмотрим."
      },
      {
       "et": "Kas nii on valus?",
       "en": "Does this hurt?",
       "az": "Belə ağrıyır?",
       "ru": "Так больно?"
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Ai!",
       "en": "Ouch!",
       "az": "Ay!",
       "ru": "Ай!"
      },
      {
       "et": "Väga valus on.",
       "en": "It really hurts.",
       "az": "Çox ağrıyır.",
       "ru": "Очень больно."
      }
     ]
    },
    {
     "who": "Arst",
     "lines": [
      {
       "et": "Aga nii?",
       "en": "And like this?",
       "az": "Bəs belə?",
       "ru": "А так?"
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Aa!",
       "en": "Aa!",
       "az": "Aa!",
       "ru": "А-а!"
      }
     ]
    },
    {
     "who": "Arst",
     "lines": [
      {
       "et": "Selge, teeme mõned uuringud.",
       "en": "Right, we’ll do some tests.",
       "az": "Aydındır, bir neçə müayinə edək.",
       "ru": "Ясно, сделаем несколько обследований."
      },
      {
       "et": "Aga ma kardan, et siin on vaja kohe valuvaigistav süst teha.",
       "en": "But I’m afraid this needs a painkilling injection straight away.",
       "az": "Amma qorxuram ki, burada dərhal ağrıkəsici iynə vurmaq lazımdır.",
       "ru": "Но боюсь, что здесь нужно сразу сделать обезболивающий укол."
      },
      {
       "et": "Hiljem võibolla operatsioon.",
       "en": "Maybe an operation later.",
       "az": "Sonra bəlkə də əməliyyat.",
       "ru": "Позже, может быть, операция."
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Kas tõesti on vaja süsti?",
       "en": "Is an injection really necessary?",
       "az": "Doğrudanmı iynə lazımdır?",
       "ru": "Неужели нужен укол?"
      },
      {
       "et": "Ma väga kardan süsti.",
       "en": "I’m really afraid of injections.",
       "az": "Mən iynədən çox qorxuram.",
       "ru": "Я очень боюсь уколов."
      }
     ]
    },
    {
     "who": "Arst",
     "lines": [
      {
       "et": "Pole vaja karta.",
       "en": "There’s no need to be afraid.",
       "az": "Qorxmağa ehtiyac yoxdur.",
       "ru": "Не нужно бояться."
      },
      {
       "et": "Pange lihtsalt silmad kinni.",
       "en": "Just close your eyes.",
       "az": "Sadəcə gözlərinizi yumun.",
       "ru": "Просто закройте глаза."
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Oeeh.",
       "en": "Oeeh.",
       "az": "Uff.",
       "ru": "Ой-ой."
      }
     ]
    },
    {
     "who": "Arst",
     "lines": [
      {
       "et": "Nii.",
       "en": "There.",
       "az": "Bax belə.",
       "ru": "Вот так."
      },
      {
       "et": "Siin on teie saatekiri.",
       "en": "Here is your referral.",
       "az": "Budur göndərişiniz.",
       "ru": "Вот ваше направление."
      },
      {
       "et": "Järgmise kolmapäeva hommikul minge kabinetti number 342.",
       "en": "Next Wednesday morning go to room number 342.",
       "az": "Gələn çərşənbə səhəri 342 nömrəli otağa gedin.",
       "ru": "В следующую среду утром идите в кабинет номер 342."
      },
      {
       "et": "Teile tehakse kompuuteruuring.",
       "en": "You will have a CT scan.",
       "az": "Sizə kompüter tomoqrafiyası ediləcək.",
       "ru": "Вам сделают компьютерную томографию."
      },
      {
       "et": "Pärast seda tulge tagasi minu juurde.",
       "en": "After that, come back to me.",
       "az": "Ondan sonra yenidən mənim yanıma gəlin.",
       "ru": "После этого возвращайтесь ко мне."
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Aga kas ma vahepeal tööl võiksin käia?",
       "en": "But could I go to work in the meantime?",
       "az": "Bəs bu arada işə gedə bilərəmmi?",
       "ru": "А можно мне пока ходить на работу?"
      }
     ]
    },
    {
     "who": "Arst",
     "lines": [
      {
       "et": "Mis tööd te muidu teete?",
       "en": "What work do you do?",
       "az": "Ümumiyyətlə, nə işlə məşğulsunuz?",
       "ru": "А кем вы работаете?"
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Ma olen kokk.",
       "en": "I’m a cook.",
       "az": "Mən aşpazam.",
       "ru": "Я повар."
      }
     ]
    },
    {
     "who": "Arst",
     "lines": [
      {
       "et": "Siis ma arvan, et peaksite mõnda aega tööst puhkama.",
       "en": "Then I think you should take some time off work.",
       "az": "Onda məncə, bir müddət işdən istirahət etməlisiniz.",
       "ru": "Тогда, я думаю, вам стоит какое-то время отдохнуть от работы."
      },
      {
       "et": "Perearstilt saate tervisetõendi.",
       "en": "You can get a sick note from your family doctor.",
       "az": "Ailə həkimindən arayış alarsınız.",
       "ru": "Справку получите у семейного врача."
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Aga kas ma kalale tohiks minna?",
       "en": "But may I go fishing?",
       "az": "Bəs balıq tutmağa gedə bilərəmmi?",
       "ru": "А на рыбалку мне можно?"
      }
     ]
    },
    {
     "who": "Arst",
     "lines": [
      {
       "et": "Kuidas te ise arvate?",
       "en": "What do you think yourself?",
       "az": "Özünüz necə düşünürsünüz?",
       "ru": "А вы сами как думаете?"
      },
      {
       "et": "Ma soovitan teil kalale mitte minna.",
       "en": "I would advise you not to go fishing.",
       "az": "Sizə balıq tutmağa getməməyi məsləhət görürəm.",
       "ru": "Я советую вам не ходить на рыбалку."
      },
      {
       "et": "Praegu on tähtis puhata.",
       "en": "Right now it is important to rest.",
       "az": "İndi dincəlmək vacibdir.",
       "ru": "Сейчас важно отдыхать."
      },
      {
       "et": "Ainult niimoodi saab käsi paraneda.",
       "en": "Only this way can the hand heal.",
       "az": "Əl yalnız belə sağala bilər.",
       "ru": "Только так рука может зажить."
      }
     ]
    }
   ]
  }
 ],
