{
 "id": "talk-subjects",
 "added": "2026-10-07",
 "name": {
  "en": "The subjects you liked, and the ones you didn't",
  "az": "Sevdiyin və sevmədiyin fənlər",
  "ru": "Любимые и нелюбимые предметы"
 },
 "why": {
  "en": "Languages and skiing, physics and PE, and what Jüri, Mai Riin and Mirja did after lessons",
  "az": "Dillər və xizək, fizika və bədən tərbiyəsi, Jüri, Mai Riin və Mirja dərsdən sonra nə edirdilər",
  "ru": "Языки и лыжи, физика и физкультура, и чем Jüri, Mai Riin и Mirja занимались после уроков"
 },
 "taste": "Mulle meeldisid väga keeled",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Missugune õppeaine sulle meeldis?",
    "en": "Which subject did you like?",
    "az": "Hansı fənni sevirdin?",
    "ru": "Какой предмет тебе нравился?"
   },
   "turns": [
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Mulle meeldisid peaaegu kõik õppeained.",
       "en": "I liked almost all subjects.",
       "az": "Demək olar ki, bütün fənləri sevirdim.",
       "ru": "Мне нравились почти все предметы."
      },
      {
       "et": "Reaalained olid natuke raskemad, aga mulle meeldis koolis käia.",
       "en": "The sciences were a little harder, but I liked going to school.",
       "az": "Dəqiq elmlər bir az çətin idi, amma məktəbə getməyi sevirdim.",
       "ru": "Точные науки были чуть труднее, но мне нравилось ходить в школу."
      },
      {
       "et": "Mulle tõesti meeldis koolis käia!",
       "en": "I really liked going to school!",
       "az": "Həqiqətən məktəbə getməyi sevirdim!",
       "ru": "Мне правда нравилось ходить в школу!"
      },
      {
       "et": "Ja eriti toredad olid keeletunnid: eesti keel, inglise keel.",
       "en": "And the language lessons were especially lovely: Estonian, English.",
       "az": "Dil dərsləri isə xüsusilə gözəl idi: eston dili, ingilis dili.",
       "ru": "А особенно хороши были уроки языков: эстонский, английский."
      },
      {
       "et": "Mulle meeldisid veel ka ajalugu ja bioloogia.",
       "en": "I also liked history and biology.",
       "az": "Tarixi və biologiyanı da sevirdim.",
       "ru": "Ещё мне нравились история и биология."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Aga ma ei olnud milleski klassi parim.",
       "en": "But I wasn't the best in the class at anything.",
       "az": "Amma heç nədə sinfin ən yaxşısı deyildim.",
       "ru": "Но я ни в чём не была лучшей в классе."
      },
      {
       "et": "Ma olin lihtsalt selline keskmine.",
       "en": "I was just sort of average.",
       "az": "Sadəcə orta səviyyəli idim.",
       "ru": "Я была просто такой средней."
      },
      {
       "et": "Terve põhikooli olin ma kõiges selline keskmine.",
       "en": "All through basic school I was sort of average at everything.",
       "az": "Bütün əsas məktəb boyu hər şeydə orta idim.",
       "ru": "Всю основную школу я во всём была такой средней."
      },
      {
       "et": "Sain kolmesid, neljasid, mõned viied.",
       "en": "I got threes, fours, some fives.",
       "az": "Üçlər, dördlər, bir neçə beş alırdım.",
       "ru": "Получала тройки, четвёрки, несколько пятёрок."
      },
      {
       "et": "Aga ma olin kõige pikem kogu aeg.",
       "en": "But I was the tallest the whole time.",
       "az": "Amma həmişə ən hündür idim.",
       "ru": "Зато я всё время была самой высокой."
      },
      {
       "et": "Keskkooli lõpus vist enam mitte, aga terve põhikooli ma olin kõige pikem, see loeb ka.",
       "en": "Probably not any more by the end of secondary school, but all through basic school I was the tallest, and that counts too.",
       "az": "Orta məktəbin sonunda, deyəsən, artıq yox, amma bütün əsas məktəb boyu ən hündür mən idim, bu da sayılır.",
       "ru": "К концу средней школы, наверное, уже нет, но всю основную школу я была самой высокой, это тоже считается."
      }
     ]
    },
    {
     "who": "Timo",
     "lines": [
      {
       "et": "Mulle meeldisid väga keeled: soome, rootsi, inglise keel.",
       "en": "I really liked languages: Finnish, Swedish, English.",
       "az": "Dilləri çox sevirdim: fin, isveç, ingilis dili.",
       "ru": "Мне очень нравились языки: финский, шведский, английский."
      },
      {
       "et": "Soomes on natuke teine süsteem, seal on kümnepallisüsteem.",
       "en": "In Finland the system is a bit different; there it's a ten-point system.",
       "az": "Finlandiyada sistem bir az başqadır, orada on ballıq sistemdir.",
       "ru": "В Финляндии немного другая система, там десятибалльная система."
      },
      {
       "et": "Mul olid kõik õppeained kümned, välja arvatud kehaline kasvatus, mis oli üheksa.",
       "en": "I had tens in all my subjects except physical education, which was a nine.",
       "az": "Bütün fənlərdən onluğum vardı, bədən tərbiyəsindən başqa, o, doqquz idi.",
       "ru": "У меня по всем предметам были десятки, кроме физкультуры, по ней было девять."
      }
     ]
    },
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Ma olin kindlasti kõige parem suusatamises.",
       "en": "I was certainly the best at skiing.",
       "az": "Xizək sürməkdə, şübhəsiz, ən yaxşısı mən idim.",
       "ru": "Лучше всех я, конечно, был в лыжах."
      },
      {
       "et": "Aga siis vahel juhtus ka seda, et mõni mu kirjand loeti klassis ette.",
       "en": "But sometimes it also happened that one of my essays was read out in class.",
       "az": "Amma bəzən elə də olurdu ki, inşalarımdan biri sinifdə oxunurdu.",
       "ru": "Но иногда бывало и так, что какое-нибудь моё сочинение зачитывали в классе."
      },
      {
       "et": "Ja ükskord kui ma korraldasin klassi malevõistluse, siis selgus, et mina korraldasin, mina võitsin!",
       "en": "And once, when I organised the class chess competition, it turned out that I organised it and I won it!",
       "az": "Bir dəfə isə sinfin şahmat yarışını mən təşkil edəndə məlum oldu ki, təşkil edən də mənəm, qalib gələn də!",
       "ru": "А однажды, когда я организовал шахматное соревнование в классе, оказалось, что я организовал, я и выиграл!"
      },
      {
       "et": "Ja see sobis mulle hästi!",
       "en": "And that suited me very well!",
       "az": "Bu da mənə çox xoş gəldi!",
       "ru": "И это меня вполне устроило!"
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Missugune õppeaine sulle ei meeldinud?",
    "en": "Which subject didn't you like?",
    "az": "Hansı fənni sevmirdin?",
    "ru": "Какой предмет тебе не нравился?"
   },
   "turns": [
    {
     "who": "Timo",
     "lines": [
      {
       "et": "Füüsika ja keemia ja ajalugu olid sellised teoreetilised ained, mis mulle ei meeldinud.",
       "en": "Physics and chemistry and history were such theoretical subjects, which I didn't like.",
       "az": "Fizika, kimya və tarix elə nəzəri fənlər idi ki, onları sevmirdim.",
       "ru": "Физика, химия и история были такими теоретическими предметами, которые мне не нравились."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Mulle ei meeldinud üldse kehaline kasvatus.",
       "en": "I didn't like physical education at all.",
       "az": "Bədən tərbiyəsini heç sevmirdim.",
       "ru": "Мне совсем не нравилась физкультура."
      },
      {
       "et": "Ilmselt see oli sellepärast, et ma olin klassis kõige halvem, sest ma olin kõige pikem.",
       "en": "Probably that was because I was the worst in the class, because I was the tallest.",
       "az": "Yəqin ona görə ki, sinifdə ən pisi mən idim, çünki ən hündür idim.",
       "ru": "Наверное, это было потому, что я была в классе хуже всех, потому что я была самой высокой."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Mida sa tegid pärast tunde?",
    "en": "What did you do after lessons?",
    "az": "Dərslərdən sonra nə edirdin?",
    "ru": "Что ты делал после уроков?"
   },
   "turns": [
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Talvel käisime uisutamas ja jäähokit mängimas ja suvel oli igasuguseid muid asju.",
       "en": "In winter we went skating and played ice hockey, and in summer there were all sorts of other things.",
       "az": "Qışda konki sürməyə və xokkey oynamağa gedirdik, yayda isə cürbəcür başqa işlər olurdu.",
       "ru": "Зимой мы ходили кататься на коньках и играть в хоккей, а летом были всякие другие дела."
      },
      {
       "et": "Aga kuna kodus oli majapidamine, siis oli ka kodus palju tegemist.",
       "en": "But since there was a farm at home, there was a lot to do at home as well.",
       "az": "Amma evdə təsərrüfat olduğuna görə evdə də görüləsi iş çox idi.",
       "ru": "Но поскольку дома было хозяйство, то и дома было много дел."
      },
      {
       "et": "Ja noh, õppimine võttis ka aega.",
       "en": "And, well, studying took time too.",
       "az": "Bir də ki, oxumaq da vaxt aparırdı.",
       "ru": "Ну и учёба тоже отнимала время."
      }
     ]
    },
    {
     "who": "Mai Riin",
     "lines": [
      {
       "et": "Kui ma olin väiksem, siis ma oli pikapäevarühmas peale kooli.",
       "en": "When I was smaller, I was in the after-school group after school.",
       "az": "Kiçik olanda dərsdən sonra uzadılmış gün qrupunda qalırdım.",
       "ru": "Когда я была поменьше, после школы я была в группе продлённого дня."
      },
      {
       "et": "Aga nüüd mul on hästi kiire elutempo ja siis peale kooli ma lähen kohe trenni tavaliselt.",
       "en": "But now my life is really busy, so after school I usually go straight to training.",
       "az": "Amma indi həyatımın tempi çox sürətlidir, ona görə də dərsdən sonra adətən dərhal məşqə gedirəm.",
       "ru": "А сейчас у меня очень быстрый темп жизни, и после школы я обычно сразу иду на тренировку."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Põhikooli ajal ma ikka käisin trennis.",
       "en": "During basic school I did go to training.",
       "az": "Əsas məktəb illərində, əlbəttə, məşqlərə gedirdim.",
       "ru": "В основной школе я, конечно, ходила на тренировки."
      },
      {
       "et": "Ma käisin balletis, iluvõimlemises, kergejõustikus, aeroobikas, ratsutamas natuke.",
       "en": "I went to ballet, rhythmic gymnastics, athletics, aerobics, and a little horse riding.",
       "az": "Baletə, bədii gimnastikaya, yüngül atletikaya, aerobikaya, bir az da at sürməyə gedirdim.",
       "ru": "Я ходила на балет, художественную гимнастику, лёгкую атлетику, аэробику, немного на верховую езду."
      },
      {
       "et": "Põhikooli teisest poolest hakkasin ma käima näiteringis ja siis viiendast klassist alates kuni peaaegu tänaseni tegelen ma näitlemisega.",
       "en": "In the second half of basic school I started going to a drama club, and since the fifth grade, almost up to today, I've been doing acting.",
       "az": "Əsas məktəbin ikinci yarısından dram dərnəyinə getməyə başladım və beşinci sinifdən demək olar ki, bu günə qədər aktyorluqla məşğulam.",
       "ru": "Со второй половины основной школы я начала ходить в театральный кружок, и с пятого класса почти до сегодняшнего дня я занимаюсь актёрским мастерством."
      }
     ]
    }
   ]
  }
 ],
