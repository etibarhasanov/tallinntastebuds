{
 "id": "talk-workday",
 "added": "2026-11-05",
 "name": {
  "en": "Your workday, and how long you’ve worked",
  "az": "İş günün və nə qədərdir işləyirsən",
  "ru": "Твой рабочий день и сколько ты уже работаешь"
 },
 "why": {
  "en": "Piret works twelve-hour days, Johannes finishes at a quarter to eight, Ott has his mornings free, Marita opened a salon",
  "az": "Piret on iki saat işləyir, Yohannes səkkizə on beş qalmış qurtarır, Ottun səhərləri boşdur, Marita salon açıb",
  "ru": "У Пирет двенадцатичасовой день, Йоханнес заканчивает без четверти восемь, у Отта утро свободно, Марита открыла салон"
 },
 "taste": "Hommikud on mul vabad.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Missugune on sinu tööpäev?",
    "en": "What is your workday like?",
    "az": "İş günün necə keçir?",
    "ru": "Какой у тебя рабочий день?"
   },
   "turns": [
    {
     "who": "Piret",
     "lines": [
      {
       "et": "Ma pean ärkama kell kuus ja tööle jõuan kella seitsmeks.",
       "en": "I have to wake up at six, and I get to work by seven.",
       "az": "Saat altıda oyanmalıyam və saat yeddiyə işə çatıram.",
       "ru": "Мне нужно вставать в шесть, и на работу я прихожу к семи."
      },
      {
       "et": "Ja minu tööpäevad on kaheteisttunnised, algavad poole kaheksast hommikul ja lõppevad õhtul kell kaheksa või pool kaheksa.",
       "en": "And my workdays are twelve hours long: they start at half past seven in the morning and finish at eight or half past seven in the evening.",
       "az": "İş günlərim on iki saatlıqdır: səhər yeddinin yarısında başlayır və axşam saat səkkizdə və ya yeddinin yarısında bitir.",
       "ru": "А рабочие дни у меня двенадцатичасовые: начинаются в половине восьмого утра и заканчиваются вечером в восемь или в половине восьмого."
      }
     ]
    },
    {
     "who": "Johannes",
     "lines": [
      {
       "et": "Õpetajatööd teen esmaspäeviti ja kolmapäeviti.",
       "en": "I do my teaching on Mondays and Wednesdays.",
       "az": "Müəllimlik işini bazar ertəsi və çərşənbə günləri görürəm.",
       "ru": "Преподаю я по понедельникам и средам."
      },
      {
       "et": "Esimene õpilane tuleb kell pool kaks ja viimane tuleb kell seitse.",
       "en": "The first student comes at half past one and the last one comes at seven.",
       "az": "Birinci şagird saat birin yarısında gəlir, sonuncu isə saat yeddidə.",
       "ru": "Первый ученик приходит в половине второго, а последний — в семь."
      },
      {
       "et": "Nii et kolmveerand kaheksa mu tööpäev lõppeb.",
       "en": "So my workday finishes at a quarter to eight.",
       "az": "Belə ki, iş günüm səkkizə on beş dəqiqə qalmış bitir.",
       "ru": "Так что мой рабочий день заканчивается без четверти восемь."
      }
     ]
    },
    {
     "who": "Ott",
     "lines": [
      {
       "et": "Mina töötan jalgpalliklubis jalgpallitreenerina ja tenniseklubis olen laste liikumistreener ning samal ajal õpin ka ülikoolis.",
       "en": "I work at a football club as a football coach, and at a tennis club I am a children’s fitness coach, and at the same time I study at university too.",
       "az": "Mən futbol klubunda futbol məşqçisi işləyirəm, tennis klubunda isə uşaqların hərəkət məşqçisiyəm və eyni zamanda universitetdə də oxuyuram.",
       "ru": "Я работаю футбольным тренером в футбольном клубе, а в теннисном клубе я детский тренер по движению, и в то же время ещё учусь в университете."
      },
      {
       "et": "Töötanud olen kaks aastat mõlemal kohal.",
       "en": "I have worked at both places for two years.",
       "az": "Hər iki yerdə iki ildir işləyirəm.",
       "ru": "В обоих местах я работаю два года."
      },
      {
       "et": "Jalgpallitrenni teen kaks korda nädalas, seal on mul hetkel üks grupp - väikesed mudilased.",
       "en": "I run football training twice a week; there I have one group at the moment - little toddlers.",
       "az": "Futbol məşqini həftədə iki dəfə keçirəm, orada hazırda bir qrupum var - balaca körpələr.",
       "ru": "Футбольные тренировки я провожу два раза в неделю, там у меня сейчас одна группа — малыши."
      },
      {
       "et": "Ja tenniseklubis töötan ühe päeva nädalas, aga mitme grupiga.",
       "en": "And at the tennis club I work one day a week, but with several groups.",
       "az": "Tennis klubunda isə həftədə bir gün işləyirəm, amma bir neçə qrupla.",
       "ru": "А в теннисном клубе я работаю один день в неделю, но с несколькими группами."
      },
      {
       "et": "Tavaliselt kestab trenn tund aega.",
       "en": "A training session usually lasts an hour.",
       "az": "Adətən məşq bir saat çəkir.",
       "ru": "Обычно тренировка длится час."
      }
     ]
    },
    {
     "who": "Ott",
     "lines": [
      {
       "et": "Hommikud on mul vabad.",
       "en": "My mornings are free.",
       "az": "Səhərlərim boşdur.",
       "ru": "По утрам я свободен."
      },
      {
       "et": "Minu tööpäev algab siis, kui lastel kool või lasteaed läbi saab, siis umbes kella neljast.",
       "en": "My workday begins when the children’s school or kindergarten is over, so at about four o’clock.",
       "az": "İş günüm uşaqların məktəbi və ya bağçası qurtaranda başlayır, yəni təxminən saat dörddən.",
       "ru": "Мой рабочий день начинается, когда у детей заканчивается школа или садик, то есть примерно с четырёх."
      },
      {
       "et": "Tööpäev on lühike: kolm-neli tundi, olenevalt sellest, kui palju gruppe on ja oleneb perioodist.",
       "en": "The workday is short: three or four hours, depending on how many groups there are, and it depends on the season.",
       "az": "İş günü qısadır: üç-dörd saat, neçə qrup olmasından asılı olaraq, bir də dövrdən asılıdır.",
       "ru": "Рабочий день короткий: три-четыре часа, в зависимости от того, сколько групп, и от периода."
      },
      {
       "et": "Tööpäev saab tavaliselt ikkagi enne kella seitset läbi.",
       "en": "The workday is usually over before seven all the same.",
       "az": "İş günü adətən yenə də saat yeddidən əvvəl bitir.",
       "ru": "Рабочий день обычно всё-таки заканчивается до семи."
      },
      {
       "et": "Mulle endale meeldib see vabadus, et mul on hommikud vabad ja õhtud vabad.",
       "en": "I myself like the freedom of having my mornings free and my evenings free.",
       "az": "Özümə bu azadlıq xoşdur ki, səhərlərim də, axşamlarım da boşdur.",
       "ru": "Мне самому нравится эта свобода — что у меня свободны и утро, и вечер."
      }
     ]
    },
    {
     "who": "Marita",
     "lines": [
      {
       "et": "Ma töötan juuksurisalongis.",
       "en": "I work in a hair salon.",
       "az": "Mən bərbər salonunda işləyirəm.",
       "ru": "Я работаю в парикмахерской."
      },
      {
       "et": "Ma olen selle salongi loonud, olen selle juht ja töötan ka juuksurina.",
       "en": "I set up this salon, I am its manager and I also work as a hairdresser.",
       "az": "Bu salonu mən yaratmışam, onun rəhbəriyəm və həm də bərbər işləyirəm.",
       "ru": "Я создала этот салон, я его руководитель и работаю ещё и парикмахером."
      },
      {
       "et": "Salongi avasin ma kaks aastat tagasi.",
       "en": "I opened the salon two years ago.",
       "az": "Salonu iki il əvvəl açmışam.",
       "ru": "Салон я открыла два года назад."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Kui kaua sa oled töötanud?",
    "en": "How long have you been working?",
    "az": "Nə qədərdir işləyirsən?",
    "ru": "Сколько ты уже работаешь?"
   },
   "turns": [
    {
     "who": "Piret",
     "lines": [
      {
       "et": "Ma olen töötanud umbes kaheksateist aastat.",
       "en": "I have been working for about eighteen years.",
       "az": "Təxminən on səkkiz ildir işləyirəm.",
       "ru": "Я работаю примерно восемнадцать лет."
      }
     ]
    },
    {
     "who": "Johannes",
     "lines": [
      {
       "et": "See on mu kolmas töökoht muusikaõpetajana.",
       "en": "This is my third job as a music teacher.",
       "az": "Bu, musiqi müəllimi kimi üçüncü iş yerimdir.",
       "ru": "Это моё третье место работы учителем музыки."
      },
      {
       "et": "Alustasin Tartus juba varem ja siis eelmisel aastal õpetasin Tallinnas veel ühes kohas.",
       "en": "I started out in Tartu earlier, and then last year I taught at another place in Tallinn.",
       "az": "Daha əvvəl Tartuda başlamışdım, sonra keçən il Tallində daha bir yerdə dərs dedim.",
       "ru": "Начинал я ещё раньше в Тарту, а потом в прошлом году преподавал в Таллинне ещё в одном месте."
      },
      {
       "et": "Nii et kokku on mul kolm töökohta olnud ja selle viimase koha peal ma olen praegu töötanud pool aastat.",
       "en": "So altogether I have had three jobs, and at this last one I have been working for half a year now.",
       "az": "Belə ki, ümumilikdə üç iş yerim olub və bu sonuncu yerdə hazırda yarım ildir işləyirəm.",
       "ru": "Так что всего у меня было три места работы, и на последнем я сейчас работаю полгода."
      }
     ]
    },
    {
     "who": "Ott",
     "lines": [
      {
       "et": "Esialgu alustasin jalgpallitreenerina umbes kaks aastat tagasi, täiesti juhuslikult.",
       "en": "I first started as a football coach about two years ago, quite by chance.",
       "az": "Futbol məşqçisi kimi təxminən iki il əvvəl, tamamilə təsadüfən başladım.",
       "ru": "Начал я футбольным тренером примерно два года назад, совершенно случайно."
      },
      {
       "et": "Pakuti tööd.",
       "en": "I was offered work.",
       "az": "İş təklif etdilər.",
       "ru": "Предложили работу."
      },
      {
       "et": "Ja kuna ma olen eluaeg sporti teinud, siis see treeneritöö pakkus mulle väga huvi.",
       "en": "And since I have done sport all my life, coaching interested me a lot.",
       "az": "Bütün ömrüm boyu idmanla məşğul olduğum üçün bu məşqçilik işi mənə çox maraqlı gəldi.",
       "ru": "А так как я всю жизнь занимался спортом, эта тренерская работа меня очень заинтересовала."
      },
      {
       "et": "Olen siiamaani tööl samas klubis ja olen töötanud väga paljude erinevate gruppide ja laagritega.",
       "en": "I am still working at the same club, and I have worked with a great many different groups and camps.",
       "az": "Hələ də həmin klubda işləyirəm və çox müxtəlif qruplar və düşərgələrlə işləmişəm.",
       "ru": "Я до сих пор работаю в том же клубе и работал с очень многими разными группами и лагерями."
      }
     ]
    }
   ]
  }
 ],
