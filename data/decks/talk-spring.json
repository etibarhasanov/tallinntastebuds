{
 "id": "talk-spring",
 "added": "2026-11-05",
 "name": {
  "en": "What you do in spring",
  "az": "Yazda nə edirsən",
  "ru": "Что ты делаешь весной"
 },
 "why": {
  "en": "Longer days, the first grill of the season, birdsong, a lawn to tidy and seeds put in to grow",
  "az": "Uzun günlər, mövsümün ilk manqalı, quş səsləri, səliqəyə salınacaq çəmən və cücərməyə qoyulan toxumlar",
  "ru": "Длинные дни, первый гриль сезона, пение птиц, газон, который надо привести в порядок, и посеянные семена"
 },
 "taste": "Kevadel istutame lilli.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Mida sa teed kevadel?",
    "en": "What do you do in spring?",
    "az": "Yazda nə edirsən?",
    "ru": "Что ты делаешь весной?"
   },
   "turns": [
    {
     "who": "Martin",
     "lines": [
      {
       "et": "Kevaditi saab rohkem käia jalutamas.",
       "en": "In spring you can go for walks more.",
       "az": "Yazda daha çox gəzməyə çıxmaq olur.",
       "ru": "Весной можно больше гулять."
      },
      {
       "et": "Kevaditi läheb varem valgeks ja hiljem pimedaks, nii et saab rohkem tööd teha, mis on ka väga tore!",
       "en": "In spring it gets light earlier and dark later, so you can work more, which is also very nice!",
       "az": "Yazda tez işıqlanır, gec qaralır, belə ki, daha çox iş görmək olur, bu da çox gözəldir!",
       "ru": "Весной раньше светает и позже темнеет, так что можно больше работать, что тоже очень здорово!"
      },
      {
       "et": "Kõigile väga meeldib töö!",
       "en": "Everybody loves work!",
       "az": "Hamı işi çox sevir!",
       "ru": "Все ведь очень любят работать!"
      },
      {
       "et": "Aprilli teises pooles, mai alguses algab ju ka grillihooaeg, nii et saab hakata väljas liha grillima.",
       "en": "In the second half of April or early May the grilling season starts too, so you can start grilling meat outdoors.",
       "az": "Aprelin ikinci yarısında, mayın əvvəlində manqal mövsümü də başlayır, belə ki, çöldə ət qızartmağa başlamaq olar.",
       "ru": "Во второй половине апреля, в начале мая ведь начинается и сезон гриля, так что можно начинать жарить мясо на улице."
      },
      {
       "et": "Kutsun sõbrad endale külla või lähen sõpradele külla, võtan kaasa liha, grillime seda, ajame juttu.",
       "en": "I invite friends over or go to friends’ places, I take meat along, we grill it and chat.",
       "az": "Dostları qonaq çağırıram ya da dostlara qonaq gedirəm, özümlə ət götürürəm, onu qızardırıq, söhbət edirik.",
       "ru": "Приглашаю друзей к себе или иду в гости к друзьям, беру с собой мясо, жарим его, болтаем."
      },
      {
       "et": "Linnud, muuseas, hakkavad ka laulma.",
       "en": "The birds, by the way, start singing too.",
       "az": "Yeri gəlmişkən, quşlar da oxumağa başlayır.",
       "ru": "Птицы, кстати, тоже начинают петь."
      },
      {
       "et": "Lindude laulu kuulamine on ka väga tore asi, millega kevadet sisustada.",
       "en": "Listening to the birds singing is also a very nice way to fill the spring.",
       "az": "Quşların səsini dinləmək də yazı doldurmaq üçün çox gözəl bir şeydir.",
       "ru": "Слушать пение птиц — тоже прекрасное занятие, которым можно заполнить весну."
      },
      {
       "et": "Praegu nad juba laulavad.",
       "en": "They are already singing now.",
       "az": "İndi artıq oxuyurlar.",
       "ru": "Сейчас они уже поют."
      }
     ]
    },
    {
     "who": "Anastassia",
     "lines": [
      {
       "et": "Kevadel käin jooksmas ja siis käin kodus aias ringi, võib-olla kõpitsen muru natukene ja vaatan, kuidas kevadlilledel läheb.",
       "en": "In spring I go running, and then I walk round the garden at home, maybe tidy the lawn a little and see how the spring flowers are doing.",
       "az": "Yazda qaçmağa gedirəm, sonra evdə bağda gəzişirəm, bəlkə çəməni bir az səliqəyə salıram və yaz çiçəklərinin necə olduğuna baxıram.",
       "ru": "Весной я бегаю, а потом хожу по саду у дома, может, немного вожусь с газоном и смотрю, как там весенние цветы."
      },
      {
       "et": "Ja olen niisama.",
       "en": "And I just take it easy.",
       "az": "Bir də elə-belə vaxt keçirirəm.",
       "ru": "И просто отдыхаю."
      },
      {
       "et": "Pesen grilli puhtaks ja valmistun grillihooajaks.",
       "en": "I wash the grill clean and get ready for the grilling season.",
       "az": "Manqalı təmiz yuyuram və manqal mövsümünə hazırlaşıram.",
       "ru": "Отмываю гриль дочиста и готовлюсь к сезону гриля."
      }
     ]
    },
    {
     "who": "Maria Liis",
     "lines": [
      {
       "et": "Kevadel istutame lilli.",
       "en": "In spring we plant flowers.",
       "az": "Yazda gül əkirik.",
       "ru": "Весной мы сажаем цветы."
      },
      {
       "et": "Kui lumi ära sulab, siis kõigepealt vaatame, mis lilled on alles.",
       "en": "When the snow melts, the first thing we do is look at which flowers have survived.",
       "az": "Qar əriyəndə əvvəlcə baxırıq ki, hansı güllər qalıb.",
       "ru": "Когда снег растает, мы первым делом смотрим, какие цветы уцелели."
      },
      {
       "et": "Siis kaevame aiamaa üles, paneme seemned kasvama.",
       "en": "Then we dig over the vegetable patch and put seeds in to grow.",
       "az": "Sonra bostanı belləyirik, toxumları cücərməyə qoyuruq.",
       "ru": "Потом вскапываем огород, ставим семена прорастать."
      },
      {
       "et": "Ja siis istutame taimed maha.",
       "en": "And then we plant the seedlings out.",
       "az": "Sonra da şitilləri torpağa əkirik.",
       "ru": "А потом высаживаем рассаду в землю."
      }
     ]
    }
   ]
  }
 ],
