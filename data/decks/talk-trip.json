{
 "id": "talk-trip",
 "added": "2026-10-07",
 "name": {
  "en": "A trip, and what came home from it",
  "az": "Bir səfər və ondan gətirilənlər",
  "ru": "Одна поездка и что из неё привезли"
 },
 "why": {
  "en": "Backpacking in Cuba, a plane that seems to land in the sea at Istanbul, the desert in Morocco, and the souvenirs",
  "az": "Kubada bel çantası ilə səyahət, İstanbulda sanki dənizə enən təyyarə, Mərakeşdə səhra və suvenirlər",
  "ru": "С рюкзаком по Кубе, самолёт, который будто садится в воду в Стамбуле, пустыня в Марокко и сувениры"
 },
 "taste": "Oli selline mõnus olemine!",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Räägi ühest reisist!",
    "en": "Tell us about one trip!",
    "az": "Bir səfərindən danış!",
    "ru": "Расскажи об одной поездке!"
   },
   "turns": [
    {
     "who": "Timo",
     "lines": [
      {
       "et": "2011. aastal käisime kolme sõbraga seljakotireisil Kuubal.",
       "en": "In 2011 three friends and I went backpacking in Cuba.",
       "az": "2011-ci ildə üç dostla Kubaya bel çantası ilə səyahətə getdik.",
       "ru": "В 2011 году мы с тремя друзьями ездили на Кубу с рюкзаками."
      },
      {
       "et": "Otsisime lihtsalt internetist odavad lennud Helsingist läbi Hispaania ja läbi Mehhiko Kuubale.",
       "en": "We just found cheap flights on the internet from Helsinki through Spain and through Mexico to Cuba.",
       "az": "Sadəcə internetdə Helsinkidən İspaniya və Meksika üzərindən Kubaya ucuz uçuşlar tapdıq.",
       "ru": "Мы просто нашли в интернете дешёвые билеты из Хельсинки через Испанию и через Мексику на Кубу."
      }
     ]
    },
    {
     "who": "Timo",
     "lines": [
      {
       "et": "Ja olime seal nii pealinnas Havannas kui ka väikelinnas Cienfuegoses.",
       "en": "And we were both in the capital, Havana, and in a small town, Cienfuegos.",
       "az": "Həm paytaxt Havanada, həm də kiçik şəhər Sienfuegosda olduq.",
       "ru": "И мы были там и в столице, Гаване, и в маленьком городе Сьенфуэгосе."
      },
      {
       "et": "Ja otsisime kodumajutused endale, tšillisime rannas, tutvusime kohaliku kultuuri ja vaatamisväärsustega.",
       "en": "And we found ourselves homestays, chilled on the beach, and got to know the local culture and sights.",
       "az": "Özümüzə ev qonaqlıqları tapdıq, çimərlikdə dincəldik, yerli mədəniyyət və görməli yerlərlə tanış olduq.",
       "ru": "Мы нашли себе жильё у местных, отдыхали на пляже, знакомились с местной культурой и достопримечательностями."
      },
      {
       "et": "Oli selline mõnus olemine!",
       "en": "It was such a good time!",
       "az": "Elə xoş vaxt idi ki!",
       "ru": "Было так хорошо!"
      }
     ]
    },
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Ma mõtlesin, et ma räägin ühest 2009. aastal toimunud reisist ja see oli Türki, Istanbuli.",
       "en": "I thought I would talk about a trip that took place in 2009, and it was to Turkey, to Istanbul.",
       "az": "Düşündüm ki, 2009-cu ildə olmuş bir səfərdən danışım, o da Türkiyəyə, İstanbula idi.",
       "ru": "Я подумал, что расскажу об одной поездке 2009 года, и это была Турция, Стамбул."
      },
      {
       "et": "Otsustasime naisega, et läheme ja käime.",
       "en": "My wife and I decided that we would go and visit.",
       "az": "Arvadımla qərara gəldik ki, gedib görək.",
       "ru": "Мы с женой решили, что съездим."
      },
      {
       "et": "Me tellisime ise internetist oma elamise.",
       "en": "We booked our accommodation on the internet ourselves.",
       "az": "Qalacağımız yeri özümüz internetdən sifariş etdik.",
       "ru": "Мы сами заказали себе жильё в интернете."
      },
      {
       "et": "Me tellisime piletid ja läksime kahekesi, et minna sinna, kuhu me tahame, ja teha nii, nagu meile meeldib.",
       "en": "We booked tickets and went just the two of us, to go where we wanted and do things the way we liked.",
       "az": "Biletləri sifariş etdik və ikimiz getdik ki, istədiyimiz yerə gedək və xoşumuza gələn kimi edək.",
       "ru": "Мы заказали билеты и поехали вдвоём, чтобы ходить туда, куда хотим, и делать так, как нам нравится."
      },
      {
       "et": "Ja see kõik oli kuidagi erakordselt meeldiv.",
       "en": "And it was all somehow incredibly pleasant.",
       "az": "Və bütün bunlar nədənsə qeyri-adi dərəcədə xoş idi.",
       "ru": "И всё это было как-то необычайно приятно."
      }
     ]
    },
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Väike ehmatus oli küll see, et kui lennuk Istanbulis maandub, siis ümberringi on vesi.",
       "en": "A little fright, though, was that when the plane lands in Istanbul there is water all around.",
       "az": "Bir az qorxu isə o idi ki, təyyarə İstanbulda enəndə ətrafda hər yer sudur.",
       "ru": "Небольшим испугом, правда, было то, что, когда самолёт садится в Стамбуле, вокруг вода."
      },
      {
       "et": "Ja esimene mulje on, et lennuk maanduks justnagu vette.",
       "en": "And the first impression is as if the plane were landing in the water.",
       "az": "İlk təəssürat da elədir ki, sanki təyyarə suya enir.",
       "ru": "И первое впечатление — будто самолёт садится прямо в воду."
      },
      {
       "et": "Et kas seal maad ikkagi on all?",
       "en": "Like, is there any land down there at all?",
       "az": "Yəni orada altda torpaq varmı, ümumiyyətlə?",
       "ru": "Мол, есть ли там внизу вообще земля?"
      },
      {
       "et": "Aga muidugi oli!",
       "en": "But of course there was!",
       "az": "Amma əlbəttə ki, var idi!",
       "ru": "Но, конечно, была!"
      }
     ]
    },
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Hotell oli vanalinnas, vanalinn oli vana.",
       "en": "The hotel was in the old town, and the old town was old.",
       "az": "Otel köhnə şəhərdə idi, köhnə şəhər də köhnə idi.",
       "ru": "Гостиница была в старом городе, а старый город был старым."
      },
      {
       "et": "Seal oli tõepoolest Konstantinoopoli- ja Bütsantsi-aegseid maju ja müüre ja muud ning see oli väga huvitav.",
       "en": "There really were houses and walls and other things from the times of Constantinople and Byzantium, and it was very interesting.",
       "az": "Orada həqiqətən Konstantinopol və Bizans dövründən qalma evlər, divarlar və başqa şeylər var idi və bu, çox maraqlı idi.",
       "ru": "Там действительно были дома, стены и прочее времён Константинополя и Византии, и это было очень интересно."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Me käisime viimati Marokos elukaaslasega, see oli eelmisel sügisel, novembrikuus.",
       "en": "The last place my partner and I went was Morocco; that was last autumn, in November.",
       "az": "Sonuncu dəfə həyat yoldaşımla Mərakeşə getmişdik, bu, keçən payız, noyabr ayında idi.",
       "ru": "Последний раз мы с моим спутником жизни ездили в Марокко, это было прошлой осенью, в ноябре."
      },
      {
       "et": "Me valisime sihtkoha selle järgi, mis on Euroopas või Euroopa lähedal ja kus on enam-vähem soe novembrikuus.",
       "en": "We chose the destination by what is in Europe or near Europe and where it is more or less warm in November.",
       "az": "İstiqaməti ona görə seçdik ki, Avropada və ya Avropaya yaxın olsun və noyabrda az-çox isti olsun.",
       "ru": "Мы выбирали направление по тому, что находится в Европе или рядом с Европой и где в ноябре более-менее тепло."
      },
      {
       "et": "Ja nii me sõitsimegi Marokosse.",
       "en": "And so off to Morocco we went.",
       "az": "Belə də Mərakeşə getdik.",
       "ru": "Так мы и поехали в Марокко."
      },
      {
       "et": "Käisime kolmes eri linnas, aga ükski meie meelest vaimustav ei olnud.",
       "en": "We visited three different cities, but in our view none of them was thrilling.",
       "az": "Üç fərqli şəhərdə olduq, amma fikrimizcə, heç biri valehedici deyildi.",
       "ru": "Мы побывали в трёх разных городах, но ни один, на наш взгляд, не был восхитительным."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Me lendasime lennukiga Tallinnast Casablancasse.",
       "en": "We flew from Tallinn to Casablanca.",
       "az": "Tallindən Kasablankaya təyyarə ilə uçduq.",
       "ru": "Мы прилетели на самолёте из Таллина в Касабланку."
      },
      {
       "et": "Olime mõned päevad Casablancas ja siis sõitsime rongiga edasi Marrakechi.",
       "en": "We spent a few days in Casablanca and then went on by train to Marrakech.",
       "az": "Bir neçə gün Kasablankada qaldıq, sonra qatarla Marrakeşə getdik.",
       "ru": "Несколько дней мы были в Касабланке, а потом поехали дальше на поезде в Марракеш."
      },
      {
       "et": "Kokku me olime kümme päeva Marokos ja kõige põnevam asi oli seal kõrbematk.",
       "en": "Altogether we were in Morocco for ten days, and the most exciting thing there was a trip into the desert.",
       "az": "Ümumilikdə Mərakeşdə on gün olduq və oradakı ən maraqlı şey səhra gəzintisi idi.",
       "ru": "Всего мы были в Марокко десять дней, и самым интересным там был поход в пустыню."
      },
      {
       "et": "See oli tõesti nii maaliline, et seda ei saa kirjeldada, seda ei saa pildistada…!",
       "en": "It was really so picturesque that it’s impossible to describe, impossible to photograph…!",
       "az": "Bu, həqiqətən elə mənzərəli idi ki, onu təsvir etmək olmur, şəklini çəkmək olmur…!",
       "ru": "Это было правда так живописно, что это невозможно описать, невозможно сфотографировать…!"
      },
      {
       "et": "Sa oled seal nende punaste düünide vahel ja siis sa saad aru, et see on äge!",
       "en": "You’re there among those red dunes, and then you realise that this is cool!",
       "az": "Sən orada o qırmızı dünlərin arasında olursan və onda başa düşürsən ki, bu, möhtəşəmdir!",
       "ru": "Ты там, среди этих красных дюн, и тогда понимаешь, что это круто!"
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Mida sa reisilt kaasa tõid?",
    "en": "What did you bring back from your trip?",
    "az": "Səfərdən nə gətirdin?",
    "ru": "Что ты привёз из поездки?"
   },
   "turns": [
    {
     "who": "Timo",
     "lines": [
      {
       "et": "Mõned meened.",
       "en": "A few souvenirs.",
       "az": "Bir neçə suvenir.",
       "ru": "Несколько сувениров."
      },
      {
       "et": "Minu hobi on külmkapimagnetite kogumine, neid siis tõin.",
       "en": "My hobby is collecting fridge magnets, so I brought those.",
       "az": "Mənim hobbim soyuducu maqnitləri toplamaqdır, onlardan gətirdim.",
       "ru": "Моё хобби — собирать магниты на холодильник, их я и привёз."
      },
      {
       "et": "Aga eelkõige tõin sealt kaasa ikka elamusi, kogemusi, mälestusi.",
       "en": "But above all I brought back thrills, experiences, memories.",
       "az": "Amma hər şeydən əvvəl oradan təəssüratlar, təcrübələr, xatirələr gətirdim.",
       "ru": "Но прежде всего я привёз оттуда впечатления, опыт, воспоминания."
      }
     ]
    },
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Minul on selline rumal komme, et kui ma mingis riigis käin, siis kõik kohalikud käibel olevad mündid proovin ma sealt kokku saada.",
       "en": "I have this silly habit: if I visit a country, I try to collect all the local coins in circulation there.",
       "az": "Məndə belə bir axmaq vərdiş var ki, hansısa ölkəyə gedəndə oradakı dövriyyədə olan bütün yerli sikkələri toplamağa çalışıram.",
       "ru": "У меня есть такая глупая привычка: когда я бываю в какой-нибудь стране, я стараюсь собрать все местные монеты, что там в ходу."
      },
      {
       "et": "Nii et sealt ma tulin niisuguse suure koliseva kotiga.",
       "en": "So I came back from there with quite a big jingling bag.",
       "az": "Belə ki, oradan elə böyük cingildəyən torba ilə qayıtdım.",
       "ru": "Так что оттуда я вернулся вот с таким большим звенящим мешком."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Me ostsime kilo komme.",
       "en": "We bought a kilo of sweets.",
       "az": "Bir kilo konfet aldıq.",
       "ru": "Мы купили кило конфет."
      },
      {
       "et": "Ja nüüd maikuus sai nende “parim enne” mööda, seega me viskasime need kõik ära, sest need olid erakordselt halvad kommid.",
       "en": "And now in May their “best before” date passed, so we threw them all out, because they were extraordinarily bad sweets.",
       "az": "İndi may ayında onların “son istifadə tarixi” keçdi, ona görə hamısını atdıq, çünki çox pis konfetlər idi.",
       "ru": "А теперь, в мае, у них истёк срок «годен до», так что мы их все выбросили, потому что конфеты были на редкость плохие."
      },
      {
       "et": "Elukaaslane ostis ka mingisuguse jope või jaki, mida ta ei ole kordagi kandnud.",
       "en": "My partner also bought some kind of coat or jacket, which he has never once worn.",
       "az": "Həyat yoldaşım da hansısa gödəkcə ya pencək aldı, onu bir dəfə də geyinməyib.",
       "ru": "Мой спутник ещё купил какую-то куртку или пиджак, который ни разу не надел."
      },
      {
       "et": "Mina ostsin mingi näokreemi, sest nad on väga kuulsad oma kreemide ja õlide poolest.",
       "en": "I bought some face cream, because they are very famous for their creams and oils.",
       "az": "Mən isə hansısa üz kremi aldım, çünki onlar kremləri və yağları ilə çox məşhurdurlar.",
       "ru": "А я купила какой-то крем для лица, потому что они очень славятся своими кремами и маслами."
      },
      {
       "et": "Ja see kreem kulus küll ära!",
       "en": "And that cream certainly came in handy!",
       "az": "O krem isə, doğrudan da, işə yaradı!",
       "ru": "И этот крем уж точно пригодился!"
      }
     ]
    }
   ]
  }
 ],
