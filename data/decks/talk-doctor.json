{
 "id": "talk-doctor",
 "added": "2026-10-07",
 "name": {
  "en": "Making a doctor’s appointment",
  "az": "Həkim qəbuluna yazılmaq",
  "ru": "Запись на приём к врачу"
 },
 "why": {
  "en": "A referral, a driving licence for ID, and the first free time with a neurologist two months away",
  "az": "Göndəriş, şəxsiyyət vəsiqəsi əvəzinə sürücülük vəsiqəsi və nevroloqda ilk boş vaxt iki ay sonra",
  "ru": "Направление, водительские права вместо паспорта и первое свободное время у невролога через два месяца"
 },
 "taste": "Kas juhiluba sobib?",
 "source": "Keeletee",
 "scenes": [
  {
   "turns": [
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Tere, ma tahaksin minna eriarsti vastuvõtule.",
       "en": "Hello, I would like an appointment with a specialist.",
       "az": "Salam, mütəxəssis həkimin qəbuluna getmək istərdim.",
       "ru": "Здравствуйте, я хотел бы попасть на приём к специалисту."
      }
     ]
    },
    {
     "who": "Registratuuritöötaja",
     "lines": [
      {
       "et": "Tere jah!",
       "en": "Hello, yes!",
       "az": "Salam, bəli!",
       "ru": "Здравствуйте, да!"
      },
      {
       "et": "Võtke palun järjekorranumber!",
       "en": "Please take a number!",
       "az": "Zəhmət olmasa, növbə nömrəsi götürün!",
       "ru": "Возьмите, пожалуйста, номерок!"
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Oi, vabandust!",
       "en": "Oh, sorry!",
       "az": "Oy, bağışlayın!",
       "ru": "Ой, извините!"
      },
      {
       "et": "Ma sooviks minna eriarsti, täpsemalt neuroloogi vastuvõtule.",
       "en": "I would like to see a specialist - a neurologist, to be more precise.",
       "az": "Mütəxəssisin, daha dəqiq desək, nevroloqun qəbuluna getmək istərdim.",
       "ru": "Я хотел бы попасть на приём к специалисту, точнее, к неврологу."
      }
     ]
    },
    {
     "who": "Registratuuritöötaja",
     "lines": [
      {
       "et": "Kas teil perearsti saatekiri on?",
       "en": "Do you have a referral from your family doctor?",
       "az": "Ailə həkimindən göndərişiniz varmı?",
       "ru": "У вас есть направление от семейного врача?"
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Jah, on ikka.",
       "en": "Yes, of course I do.",
       "az": "Bəli, əlbəttə var.",
       "ru": "Да, конечно, есть."
      },
      {
       "et": "Palun.",
       "en": "Here you are.",
       "az": "Buyurun.",
       "ru": "Пожалуйста."
      }
     ]
    },
    {
     "who": "Registratuuritöötaja",
     "lines": [
      {
       "et": "Näidake palun isikut tõendavat dokumenti ka.",
       "en": "Please show me some identification too.",
       "az": "Zəhmət olmasa, şəxsiyyəti təsdiq edən sənəd də göstərin.",
       "ru": "Покажите, пожалуйста, и документ, удостоверяющий личность."
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Kas juhiluba sobib?",
       "en": "Will my driving licence do?",
       "az": "Sürücülük vəsiqəsi olar?",
       "ru": "Водительские права подойдут?"
      }
     ]
    },
    {
     "who": "Registratuuritöötaja",
     "lines": [
      {
       "et": "Ikka.",
       "en": "Sure.",
       "az": "Əlbəttə.",
       "ru": "Конечно."
      },
      {
       "et": "Kas teie telefoninumber lõppeb 9898?",
       "en": "Does your phone number end in 9898?",
       "az": "Telefon nömrəniz 9898 ilə bitir?",
       "ru": "Ваш номер телефона заканчивается на 9898?"
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Jah.",
       "en": "Yes.",
       "az": "Bəli.",
       "ru": "Да."
      }
     ]
    },
    {
     "who": "Registratuuritöötaja",
     "lines": [
      {
       "et": "Vaatame.",
       "en": "Let’s see.",
       "az": "Baxaq.",
       "ru": "Посмотрим."
      },
      {
       "et": "Neuroloogi juurde saaks minna kahe kuu pärast, 13. märtsil kell 15.30.",
       "en": "You could see a neurologist in two months, on the thirteenth of March at 3:30 pm.",
       "az": "Nevroloqun yanına iki aydan sonra, martın 13-də saat 15:30-da getmək olar.",
       "ru": "К неврологу можно попасть через два месяца, 13 марта в 15:30."
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Selge.",
       "en": "I see.",
       "az": "Aydındır.",
       "ru": "Понятно."
      },
      {
       "et": "Ega varem ei ole aega?",
       "en": "There isn’t an earlier time, is there?",
       "az": "Bəlkə daha tez vaxt yoxdur?",
       "ru": "А раньше времени нет?"
      }
     ]
    },
    {
     "who": "Registratuuritöötaja",
     "lines": [
      {
       "et": "Ei, kahjuks mitte.",
       "en": "No, unfortunately not.",
       "az": "Xeyr, təəssüf ki, yoxdur.",
       "ru": "Нет, к сожалению."
      },
      {
       "et": "Varem ei ole mitte ühtegi vaba aega.",
       "en": "There isn’t a single free time any earlier.",
       "az": "Daha tez heç bir boş vaxt yoxdur.",
       "ru": "Раньше нет ни одного свободного времени."
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "No siis sobib.",
       "en": "Well, then it will do.",
       "az": "Yaxşı, onda olar.",
       "ru": "Ну, тогда подходит."
      }
     ]
    },
    {
     "who": "Registratuuritöötaja",
     "lines": [
      {
       "et": "13. märtsil minge otse kabinetti number 307.",
       "en": "On the thirteenth of March go straight to room number 307.",
       "az": "Martın 13-də birbaşa 307 nömrəli kabinetə gedin.",
       "ru": "13 марта идите прямо в кабинет номер 307."
      },
      {
       "et": "See on neljandal, mitte kolmandal korrusel.",
       "en": "It’s on the fourth floor, not the third.",
       "az": "O, üçüncü yox, dördüncü mərtəbədədir.",
       "ru": "Он на четвёртом, а не на третьем этаже."
      }
     ]
    },
    {
     "who": "Patsient",
     "lines": [
      {
       "et": "Ahah, tänan.",
       "en": "Ah, thank you.",
       "az": "Aha, təşəkkür edirəm.",
       "ru": "Ага, спасибо."
      },
      {
       "et": "Head päeva!",
       "en": "Good day!",
       "az": "Xeyirli gün!",
       "ru": "Хорошего дня!"
      }
     ]
    },
    {
     "who": "Registratuuritöötaja",
     "lines": [
      {
       "et": "Head päeva!",
       "en": "Good day!",
       "az": "Xeyirli gün!",
       "ru": "Хорошего дня!"
      }
     ]
    }
   ]
  }
 ],
