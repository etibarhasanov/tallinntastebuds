{
 "id": "talk-tools",
 "added": "2026-11-05",
 "name": {
  "en": "The tools of your trade",
  "az": "İşində istifadə etdiyin alətlər",
  "ru": "Инструменты твоей работы"
 },
 "why": {
  "en": "Piret’s pens and syringe, a guitar teacher’s pick and music stand, a coach’s balls and a hairdresser’s scissors",
  "az": "Piretin qələmləri və şprisi, gitara müəlliminin mediatoru və not altlığı, məşqçinin topları və bərbərin qayçısı",
  "ru": "Ручки и шприц Пирет, медиатор и пюпитр учителя гитары, мячи тренера и ножницы парикмахера"
 },
 "taste": "Ilma selleta ei saa!",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Mis vahendeid sa kasutad oma töös?",
    "en": "What tools do you use in your work?",
    "az": "İşində hansı vasitələrdən istifadə edirsən?",
    "ru": "Какими инструментами ты пользуешься в работе?"
   },
   "turns": [
    {
     "who": "Piret",
     "lines": [
      {
       "et": "Mu lihtsamad töövahendid on sinine ja punane pastapliiats, sest osa tööst ma teen ikkagi paberi ja pastakaga.",
       "en": "My simplest tools are a blue and a red ballpoint pen, because I still do part of the work with paper and pen.",
       "az": "Ən sadə iş alətlərim göy və qırmızı diyircəkli qələmdir, çünki işin bir hissəsini yenə də kağız və qələmlə görürəm.",
       "ru": "Мои самые простые рабочие инструменты — синяя и красная шариковые ручки, потому что часть работы я всё-таки делаю на бумаге и ручкой."
      },
      {
       "et": "Mul on väga palju töövahendeid, näiteks süstal.",
       "en": "I have a great many tools, for example a syringe.",
       "az": "Çoxlu iş alətim var, məsələn, şpris.",
       "ru": "У меня очень много рабочих инструментов, например шприц."
      },
      {
       "et": "Väga tähtis on tööl olles ise terveks jääda ja seega kuuluvad minu töövahendite hulka sellised enesekaitsevahendid nagu müts, mask, kindad ja kittel.",
       "en": "It is very important to stay healthy yourself while you are at work, so my tools include protective equipment like a cap, a mask, gloves and a gown.",
       "az": "İşdə olarkən özün sağlam qalmaq çox vacibdir, ona görə də iş alətlərimin arasında papaq, maska, əlcək və xalat kimi qoruyucu vasitələr var.",
       "ru": "Очень важно самой оставаться здоровой на работе, поэтому к моим рабочим инструментам относятся такие средства защиты, как шапочка, маска, перчатки и халат."
      }
     ]
    },
    {
     "who": "Johannes",
     "lines": [
      {
       "et": "Tunni läbiviimiseks on mul vajalik kitarr.",
       "en": "To give a lesson I need a guitar.",
       "az": "Dərs keçmək üçün mənə gitara lazımdır.",
       "ru": "Чтобы провести урок, мне нужна гитара."
      },
      {
       "et": "Ma õpetan lastele klassikalist kitarri, mis tähendab seda, et tegelikult peaks kitarr olema vasaku jala peal.",
       "en": "I teach children classical guitar, which means that the guitar should actually rest on the left leg.",
       "az": "Uşaqlara klassik gitara öyrədirəm, bu da o deməkdir ki, əslində gitara sol ayağın üstündə olmalıdır.",
       "ru": "Я учу детей классической гитаре, а это значит, что гитара, вообще-то, должна лежать на левой ноге."
      },
      {
       "et": "See on natukene teine lähenemine.",
       "en": "That is a slightly different approach.",
       "az": "Bu, bir az başqa yanaşmadır.",
       "ru": "Это немного другой подход."
      },
      {
       "et": "Siis ma kasutan veel oma sõrmi ja tavaliselt ma kasutan sihukest plastmassist… Oota, ma vaatan, kas ma leian selle üles… Kasutan sellist plastmassist medikat.",
       "en": "Then I also use my own fingers, and usually I use this plastic… Wait, I’ll see if I can find it… I use this kind of plastic pick.",
       "az": "Sonra öz barmaqlarımdan da istifadə edirəm, adətən də belə plastik bir… Dayan, baxım, tapa bilərəmmi… Belə plastik mediatordan istifadə edirəm.",
       "ru": "Ещё я пользуюсь своими пальцами и обычно такой пластмассовой… Подожди, посмотрю, найду ли я её… Пользуюсь таким пластмассовым медиатором."
      },
      {
       "et": "Ja siis ma natukene mängin mingeid asju, akorde või lugusid, näiteks mängin Bachi.",
       "en": "And then I play a few things, chords or pieces — I play Bach, for example.",
       "az": "Sonra da bir az nəsə çalıram, akkordlar ya da əsərlər, məsələn, Bax çalıram.",
       "ru": "А потом немного играю что-нибудь, аккорды или пьесы, например играю Баха."
      }
     ]
    },
    {
     "who": "Johannes",
     "lines": [
      {
       "et": "Ja teine oluline asi, mida ma kasutan, kui ma õpetan väikeseid lapsi, on noodipult.",
       "en": "And another important thing I use when I teach little children is a music stand.",
       "az": "Balaca uşaqlara dərs deyəndə istifadə etdiyim başqa vacib bir şey də not altlığıdır.",
       "ru": "И ещё одна важная вещь, которой я пользуюсь, когда учу маленьких детей, — это пюпитр."
      },
      {
       "et": "Ilma selleta ei saa!",
       "en": "You can’t do without it!",
       "az": "Onsuz olmaz!",
       "ru": "Без него никак!"
      },
      {
       "et": "Lapsed peavad kuskilt nooti vaatama.",
       "en": "Children have to read their music from somewhere.",
       "az": "Uşaqlar notlara haradansa baxmalıdırlar.",
       "ru": "Детям ведь надо откуда-то смотреть в ноты."
      }
     ]
    },
    {
     "who": "Ott",
     "lines": [
      {
       "et": "Treeneritöös oleneb kõik erialast ja spordialast.",
       "en": "In a coach’s work everything depends on the field and the sport.",
       "az": "Məşqçi işində hər şey ixtisasdan və idman növündən asılıdır.",
       "ru": "В работе тренера всё зависит от специальности и вида спорта."
      },
      {
       "et": "Jalgpallitreenerina kasutan ma hästi palju palle, neid läheb mul palju vaja.",
       "en": "As a football coach I use a great many balls; I need a lot of them.",
       "az": "Futbol məşqçisi kimi çoxlu top işlədirəm, onlar mənə çox lazım olur.",
       "ru": "Как футбольный тренер я использую очень много мячей, они мне нужны в большом количестве."
      },
      {
       "et": "Talvel on mul vaja kasutada saali ja suvel väljakut.",
       "en": "In winter I need a sports hall, and in summer a pitch.",
       "az": "Qışda mənə zal, yayda isə meydança lazımdır.",
       "ru": "Зимой мне нужен зал, а летом — поле."
      },
      {
       "et": "Ilma nendeta on raske.",
       "en": "Without them it is hard.",
       "az": "Onlarsız çətindir.",
       "ru": "Без них трудно."
      }
     ]
    },
    {
     "who": "Marita",
     "lines": [
      {
       "et": "Oma juuksuritöös kasutan ma kääre, erinevaid kamme, harjasid, fööne ja igasuguseid viimistlusvahendeid.",
       "en": "In my work as a hairdresser I use scissors, different combs, brushes, hairdryers and all kinds of styling products.",
       "az": "Bərbər işimdə qayçıdan, müxtəlif daraqlardan, fırçalardan, fenlərdən və hər cür üslub vasitələrindən istifadə edirəm.",
       "ru": "В своей парикмахерской работе я пользуюсь ножницами, разными расчёсками, щётками, фенами и всевозможными средствами для укладки."
      },
      {
       "et": "Peapesu puhul on olulised ka šampoonid, palsamid ja maskid.",
       "en": "For washing hair, shampoos, conditioners and masks matter too.",
       "az": "Baş yuyulanda şampunlar, balzamlar və maskalar da vacibdir.",
       "ru": "Для мытья головы важны ещё шампуни, бальзамы и маски."
      }
     ]
    }
   ]
  }
 ],
