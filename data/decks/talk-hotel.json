{
 "id": "talk-hotel",
 "added": "2026-10-07",
 "name": {
  "en": "Booking a hotel room",
  "az": "Oteldə otaq sifarişi",
  "ru": "Бронирование номера в гостинице"
 },
 "why": {
  "en": "A double room for two nights, an extra bed for a twelve-year-old, and the spa included in the price",
  "az": "İki gecəlik ikinəfərlik otaq, on iki yaşlı uşaq üçün əlavə çarpayı və qiymətə daxil olan spa",
  "ru": "Двухместный номер на две ночи, дополнительная кровать для двенадцатилетнего и спа, включённое в цену"
 },
 "taste": "Mitmeks ööks ma broneerin?",
 "source": "Keeletee",
 "scenes": [
  {
   "turns": [
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Tere!",
       "en": "Hello!",
       "az": "Salam!",
       "ru": "Здравствуйте!"
      },
      {
       "et": "Hotell “Vaikus ja Rahu”.",
       "en": "Hotel “Peace and Quiet”.",
       "az": "“Vaikus ja Rahu” oteli.",
       "ru": "Гостиница «Vaikus ja Rahu»."
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "Tere!",
       "en": "Hello!",
       "az": "Salam!",
       "ru": "Здравствуйте!"
      },
      {
       "et": "Ma proovisin täna netis tuba broneerida, aga millegipärast see ei õnnestunud.",
       "en": "I tried booking a room on the internet today, but for some reason it didn’t go through.",
       "az": "Bu gün internetdə otaq sifariş etməyə çalışdım, amma nədənsə alınmadı.",
       "ru": "Я сегодня пыталась забронировать номер в интернете, но почему-то не получилось."
      }
     ]
    },
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Imelik.",
       "en": "Strange.",
       "az": "Qəribədir.",
       "ru": "Странно."
      },
      {
       "et": "Minu teada täna kodulehega probleeme ei ole olnud.",
       "en": "As far as I know we haven’t had any problems with our website today.",
       "az": "Bildiyimə görə, bu gün saytla heç bir problem olmayıb.",
       "ru": "Насколько я знаю, сегодня с сайтом проблем не было."
      },
      {
       "et": "Missugust tuba te broneerida soovisite?",
       "en": "What kind of room did you want to book?",
       "az": "Hansı otağı sifariş etmək istəyirdiniz?",
       "ru": "Какой номер вы хотели забронировать?"
      },
      {
       "et": "Ma teen teile broneeringu kohe ära.",
       "en": "I’ll make your reservation right away.",
       "az": "Sifarişinizi indi edərəm.",
       "ru": "Я сейчас же оформлю вам бронь."
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "Ma tahtsin üht suuremat kahekohalist tuba.",
       "en": "I wanted a larger double room.",
       "az": "Bir az böyük ikiyerlik otaq istəyirdim.",
       "ru": "Я хотела номер побольше, двухместный."
      }
     ]
    },
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Ahah.",
       "en": "I see.",
       "az": "Aha.",
       "ru": "Ага."
      },
      {
       "et": "Ja mis ajaks te broneerida soovisite?",
       "en": "And for when did you wish to make the reservation?",
       "az": "Bəs hansı vaxta sifariş etmək istəyirdiniz?",
       "ru": "А на какое время вы хотели бы забронировать?"
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "Mul oleks tuba vaja järgmisel neljapäeval, kuueteistkümnendal augustil.",
       "en": "I would need the room next Thursday, on the sixteenth of August.",
       "az": "Otaq mənə gələn cümə axşamı, avqustun on altısında lazım olardı.",
       "ru": "Номер мне нужен в следующий четверг, шестнадцатого августа."
      }
     ]
    },
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Nii.",
       "en": "So.",
       "az": "Belə.",
       "ru": "Так."
      },
      {
       "et": "Mitmekesi te siis olete?",
       "en": "And how many of you are there?",
       "az": "Bəs neçə nəfərsiniz?",
       "ru": "А сколько вас будет?"
      },
      {
       "et": "Kahekesi, jah?",
       "en": "Two, right?",
       "az": "İki nəfər, hə?",
       "ru": "Двое, да?"
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "Kaks täiskasvanut ja meil on laps ka kaasas.",
       "en": "Two adults, and we have a child with us too.",
       "az": "İki böyük, bir də yanımızda uşaq var.",
       "ru": "Двое взрослых, и с нами ещё ребёнок."
      }
     ]
    },
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Kui vana laps on?",
       "en": "How old is the child?",
       "az": "Uşaq neçə yaşındadır?",
       "ru": "Сколько лет ребёнку?"
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "Kaksteist.",
       "en": "Twelve.",
       "az": "On iki.",
       "ru": "Двенадцать."
      }
     ]
    },
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Mmh, kuni kaheteistaastastele lastele saame vanemate toas pakkuda lisavoodit kümne euroga.",
       "en": "Mm, for children up to twelve years old we can offer an extra bed in the parents’ room for ten euros.",
       "az": "Mm, on iki yaşa qədər uşaqlar üçün valideynlərin otağında on avroya əlavə çarpayı təklif edə bilərik.",
       "ru": "Мм, детям до двенадцати лет мы можем предложить дополнительную кровать в номере родителей за десять евро."
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "See sobib hästi.",
       "en": "That suits me fine.",
       "az": "Bu, yaxşıdır.",
       "ru": "Это хорошо подходит."
      }
     ]
    },
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Nii, kas teile sobib kaheinimesevoodiga tuba või soovite eraldi voodeid?",
       "en": "So, would a room with a double bed suit you, or would you like separate beds?",
       "az": "Belə, sizə ikinəfərlik çarpayılı otaq uyğundur, yoxsa ayrı çarpayılar istəyirsiniz?",
       "ru": "Так, вам подойдёт номер с двуспальной кроватью или вы хотите отдельные кровати?"
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "Kaheinimesevoodi sobib.",
       "en": "The double bed is fine.",
       "az": "İkinəfərlik çarpayı uyğundur.",
       "ru": "Двуспальная кровать подойдёт."
      }
     ]
    },
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Väga hea.",
       "en": "Very good.",
       "az": "Çox yaxşı.",
       "ru": "Очень хорошо."
      },
      {
       "et": "Kahesed toad on meil praegu kampaaniahinnaga 80 eurot tuba ja lisandub siis see kümme eurot lapse voodi eest.",
       "en": "Our double rooms are on a special offer just now at 80 euros a room, and then there are the ten euros for the child’s bed on top.",
       "az": "İkinəfərlik otaqlarımız indi aksiya qiymətinə otağı 80 avrodur, üstünə də uşaq çarpayısı üçün o on avro gəlir.",
       "ru": "Двухместные номера у нас сейчас по акционной цене, 80 евро за номер, и к этому добавляются десять евро за кровать для ребёнка."
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "Hm, ma lootsin saada veel odavamalt.",
       "en": "Hm, I was hoping to get it cheaper still.",
       "az": "Hm, daha ucuz alacağımı ümid edirdim.",
       "ru": "Хм, я надеялась получить ещё дешевле."
      }
     ]
    },
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Teate, tegelikult see on päris hea hind, sest hinna sees on ka hommikusöök ja spaa ning saunade kasutus kogu perele.",
       "en": "You know, it’s actually quite a good price, because breakfast is included, and the use of the spa and the saunas for the whole family.",
       "az": "Bilirsiniz, əslində bu, olduqca yaxşı qiymətdir, çünki qiymətə səhər yeməyi, bütün ailə üçün spa və saunalardan istifadə də daxildir.",
       "ru": "Знаете, на самом деле это очень хорошая цена, ведь в неё входят завтрак, спа и сауны для всей семьи."
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "Nii et eraldi spaapiletit ei ole vaja osta?",
       "en": "So I don’t have to buy a separate spa ticket?",
       "az": "Yəni ayrıca spa bileti almaq lazım deyil?",
       "ru": "То есть отдельный билет в спа покупать не нужно?"
      }
     ]
    },
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Ei ole.",
       "en": "No, you don’t.",
       "az": "Lazım deyil.",
       "ru": "Не нужно."
      },
      {
       "et": "Ja parkimine on ka tasuta.",
       "en": "And the parking is free, too.",
       "az": "Parklanma da pulsuzdur.",
       "ru": "И парковка тоже бесплатная."
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "Olgu, broneerige siis ära.",
       "en": "All right, make the reservation, then.",
       "az": "Yaxşı, onda sifariş edin.",
       "ru": "Хорошо, тогда бронируйте."
      }
     ]
    },
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Mitmeks ööks ma broneerin?",
       "en": "For how many nights shall I book?",
       "az": "Neçə gecəlik sifariş edim?",
       "ru": "На сколько ночей мне бронировать?"
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "Broneerige kaheks ööks Minni Mustika nimele.",
       "en": "Book it for two nights, in the name of Minni Mustikas.",
       "az": "İki gecəlik, Minni Mustikasın adına sifariş edin.",
       "ru": "Забронируйте на две ночи на имя Минни Мустикас."
      }
     ]
    },
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Teie telefoninumber ka palun.",
       "en": "Your phone number too, please.",
       "az": "Telefon nömrənizi də, zəhmət olmasa.",
       "ru": "И ваш номер телефона, пожалуйста."
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "55 88 921.",
       "en": "55 88 921.",
       "az": "55 88 921.",
       "ru": "55 88 921."
      },
      {
       "et": "Kas ma tasuma pean kohe või hiljem?",
       "en": "Do I have to pay right away or later?",
       "az": "Pulu dərhal ödəməliyəm, yoxsa sonra?",
       "ru": "Мне нужно заплатить сразу или потом?"
      }
     ]
    },
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Maksta saate kohapeal.",
       "en": "You can pay on arrival.",
       "az": "Yerində ödəyə bilərsiniz.",
       "ru": "Оплатить можно на месте."
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "Hästi, siis vist on kõik.",
       "en": "Good, then that’s probably everything.",
       "az": "Yaxşı, onda deyəsən, hamısı budur.",
       "ru": "Хорошо, тогда, кажется, всё."
      }
     ]
    },
    {
     "who": "Administraator",
     "lines": [
      {
       "et": "Jah, minu poolt küll.",
       "en": "Yes, from my side it is.",
       "az": "Bəli, mənim tərəfimdən, hə.",
       "ru": "Да, с моей стороны всё."
      },
      {
       "et": "Ilusat päeva!",
       "en": "Have a nice day!",
       "az": "Gözəl gün arzulayıram!",
       "ru": "Хорошего дня!"
      }
     ]
    },
    {
     "who": "Naine",
     "lines": [
      {
       "et": "Teile ka!",
       "en": "You too!",
       "az": "Sizə də!",
       "ru": "И вам тоже!"
      }
     ]
    }
   ]
  }
 ],
