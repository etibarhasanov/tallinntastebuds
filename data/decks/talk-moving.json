{
 "id": "talk-moving",
 "added": "2026-10-07",
 "name": {
  "en": "Moving house",
  "az": "Köçmək",
  "ru": "Переезды"
 },
 "why": {
  "en": "Seven or eight moves, and a student's dozen from Kohtla-Järve to Tartu and back",
  "az": "Yeddi-səkkiz köç və bir tələbənin Kohtla-Järvedən Tartuya və geri on iki köçü",
  "ru": "Семь или восемь переездов и студенческая дюжина из Кохтла-Ярве в Тарту и обратно"
 },
 "taste": "Üks, kaks, kolm, neli, viis, kuus",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Mitu korda sa elus kolinud oled?",
    "en": "How many times have you moved in your life?",
    "az": "Həyatında neçə dəfə köçmüsən?",
    "ru": "Сколько раз в жизни ты переезжал?"
   },
   "turns": [
    {
     "who": "Arvo",
     "lines": [
      {
       "et": "Üks, kaks, kolm, neli, viis, kuus, ma arvan, et seitse või kaheksa korda.",
       "en": "One, two, three, four, five, six — I think seven or eight times.",
       "az": "Bir, iki, üç, dörd, beş, altı — məncə, yeddi, ya da səkkiz dəfə.",
       "ru": "Раз, два, три, четыре, пять, шесть — я думаю, семь или восемь раз."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Mitu korda sa elus kolinud oled? Kust kuhu sa kolinud oled?",
    "en": "How many times have you moved in your life? Where have you moved from and to?",
    "az": "Həyatında neçə dəfə köçmüsən? Haradan haraya köçmüsən?",
    "ru": "Сколько раз в жизни ты переезжал? Откуда и куда ты переезжал?"
   },
   "turns": [
    {
     "who": "Aleksandr",
     "lines": [
      {
       "et": "Päris tihti, kuna ma õppisin ja õpingute ajal oli vaja kolida ühest ühiselamust teise ja ühest linnast teise.",
       "en": "Quite often, since I was studying, and while I studied I had to move from one dormitory to another and from one town to another.",
       "az": "Kifayət qədər tez-tez, çünki oxuyurdum və təhsil illərində bir yataqxanadan digərinə, bir şəhərdən digərinə köçmək lazım gəlirdi.",
       "ru": "Довольно часто, потому что я учился, и во время учёбы нужно было переезжать из одного общежития в другое и из одного города в другой."
      },
      {
       "et": "Ma ei tea, kas kümme või kaksteist korda.",
       "en": "I don't know if it was ten or twelve times.",
       "az": "Bilmirəm, on dəfə, ya on iki dəfə.",
       "ru": "Не знаю, десять или двенадцать раз."
      }
     ]
    },
    {
     "who": "Aleksandr",
     "lines": [
      {
       "et": "Esialgu kolisin Kohtla-Järvelt Tallinna, siis Tallinnast Tartusse ja siis Tartust tagasi Tallinna.",
       "en": "First I moved from Kohtla-Järve to Tallinn, then from Tallinn to Tartu, and then from Tartu back to Tallinn.",
       "az": "Əvvəlcə Kohtla-Järvedən Tallinnə köçdüm, sonra Tallinndən Tartuya, sonra da Tartudan yenidən Tallinnə.",
       "ru": "Сначала я переехал из Кохтла-Ярве в Таллинн, потом из Таллинна в Тарту, а потом из Тарту обратно в Таллинн."
      }
     ]
    }
   ]
  }
 ],
