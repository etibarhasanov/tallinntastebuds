{
 "id": "talk-content-work",
 "added": "2026-11-05",
 "name": {
  "en": "Are you happy with your work?",
  "az": "İşindən razısanmı?",
  "ru": "Ты доволен своей работой?"
 },
 "why": {
  "en": "Good colleagues make the work fly, a pupil scores a goal for the first time, and the feedback is mostly kind",
  "az": "Yaxşı həmkarlarla iş uçub gedir, şagird ilk dəfə qol vurur, rəylər də çox vaxt xoşdur",
  "ru": "С хорошими коллегами работа летит, ученик впервые забивает гол, а отзывы в основном добрые"
 },
 "taste": "Ma olen väga rahul.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Kas sa oled oma tööga rahul?",
    "en": "Are you happy with your work?",
    "az": "İşindən razısanmı?",
    "ru": "Ты доволен своей работой?"
   },
   "turns": [
    {
     "who": "Piret",
     "lines": [
      {
       "et": "Kuna ma olen siin osakonnas nii kaua töötanud, siis see vist näitabki seda, et ma olen rahul.",
       "en": "Since I have worked in this department for so long, that probably shows that I am happy.",
       "az": "Bu şöbədə bu qədər uzun müddət işlədiyimə görə, yəqin, elə bu da razı olduğumu göstərir.",
       "ru": "Раз я так долго работаю в этом отделении, это, наверное, и показывает, что я довольна."
      },
      {
       "et": "Ma arvan, et ma olen rahul!",
       "en": "I think I am happy!",
       "az": "Məncə, razıyam!",
       "ru": "Думаю, я довольна!"
      },
      {
       "et": "Ma ei ole suutnud välja mõelda ühtegi teist kohta, kus ma tahaksin töötada.",
       "en": "I haven’t been able to think of any other place where I would want to work.",
       "az": "İşləmək istədiyim başqa heç bir yer ağlıma gəlməyib.",
       "ru": "Я не смогла придумать ни одного другого места, где мне хотелось бы работать."
      }
     ]
    },
    {
     "who": "Piret",
     "lines": [
      {
       "et": "Mulle meeldib see, kui kõik sujub ja töö õnnestub.",
       "en": "I like it when everything goes smoothly and the work goes well.",
       "az": "Hər şey qaydasında gedəndə və iş alınanda xoşuma gəlir.",
       "ru": "Мне нравится, когда всё идёт гладко и работа удаётся."
      },
      {
       "et": "Mulle meeldib see, kui tööl on toredad kolleegid, kellega koos on hea ja mõnus töötada.",
       "en": "I like it when there are nice colleagues at work whom it is good and pleasant to work with.",
       "az": "İşdə birlikdə işləmək yaxşı və xoş olan gözəl həmkarlar olanda xoşuma gəlir.",
       "ru": "Мне нравится, когда на работе славные коллеги, с которыми хорошо и приятно работать."
      },
      {
       "et": "Siis töö lihtsalt lendab käes!",
       "en": "Then the work simply flies!",
       "az": "Onda iş sadəcə uçub gedir!",
       "ru": "Тогда работа просто горит в руках!"
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Mis on sinu töös kõige toredam?",
    "en": "What is the best thing about your work?",
    "az": "İşində ən gözəl şey nədir?",
    "ru": "Что в твоей работе самое приятное?"
   },
   "turns": [
    {
     "who": "Johannes",
     "lines": [
      {
       "et": "Kõige toredam õpetajatöös on see, kui ma näen, et mõni õpilane areneb.",
       "en": "The best thing in a teacher’s work is when I see a pupil developing.",
       "az": "Müəllim işində ən gözəl şey hansısa şagirdin inkişaf etdiyini görməkdir.",
       "ru": "Самое приятное в работе учителя — когда я вижу, что какой-то ученик развивается."
      }
     ]
    },
    {
     "who": "Johannes",
     "lines": [
      {
       "et": "Saladuskatte all võin öelda, et tegelikult kõige tublimad õpilased on tublid sellepärast, et nad on ise tublid, nad on ise töökad ja harjutavad.",
       "en": "Strictly between us, I can say that the best pupils are actually good because they are good themselves — they are hard-working themselves, and they practise.",
       "az": "Aramızda qalsın, deyə bilərəm ki, əslində ən bacarıqlı şagirdlər ona görə bacarıqlıdırlar ki, özləri bacarıqlıdırlar, özləri çalışqandırlar və məşq edirlər.",
       "ru": "По секрету могу сказать, что на самом деле лучшие ученики хороши потому, что они сами молодцы, сами трудолюбивы и занимаются."
      }
     ]
    },
    {
     "who": "Johannes",
     "lines": [
      {
       "et": "Ma usun, et õpetaja töö… Kuidas ma ütlen?",
       "en": "I believe that a teacher’s work… How shall I put it?",
       "az": "Məncə, müəllimin işi… Necə deyim?",
       "ru": "Я считаю, что работа учителя… Как бы сказать?"
      },
      {
       "et": "Õpetajatööst võib sõltuda nii mõndagi, aga tegelikult, kui keegi tahab õppida klaverit või kitarri või ükskõik mis instrumenti, siis kõige tähtsam on enda motivatsioon ja töökus.",
       "en": "A good deal can depend on the teacher’s work, but actually, when someone wants to learn the piano or the guitar or any instrument at all, the most important thing is their own motivation and hard work.",
       "az": "Müəllimin işindən çox şey asılı ola bilər, amma əslində kimsə pianino, gitara və ya hər hansı bir alət öyrənmək istəyirsə, ən vacibi öz motivasiyası və çalışqanlığıdır.",
       "ru": "От работы учителя может зависеть многое, но на самом деле, если кто-то хочет научиться играть на пианино, гитаре или на любом инструменте, самое важное — собственная мотивация и трудолюбие."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Kas sa oled oma tööga rahul?",
    "en": "Are you happy with your work?",
    "az": "İşindən razısanmı?",
    "ru": "Ты доволен своей работой?"
   },
   "turns": [
    {
     "who": "Ott",
     "lines": [
      {
       "et": "Minu töö mulle tegelikult väga meeldib.",
       "en": "I actually like my work a lot.",
       "az": "Əslində işimi çox sevirəm.",
       "ru": "Мне на самом деле очень нравится моя работа."
      },
      {
       "et": "Esimene suur pluss ongi see, et minu tööaeg on väga paindlik ja suhteliselt vaba.",
       "en": "The first big plus is that my working hours are very flexible and fairly free.",
       "az": "Birinci böyük üstünlük elə odur ki, iş vaxtım çox çevik və nisbətən sərbəstdir.",
       "ru": "Первый большой плюс как раз в том, что мой рабочий график очень гибкий и довольно свободный."
      },
      {
       "et": "See on esimene pluss.",
       "en": "That is the first plus.",
       "az": "Bu, birinci üstünlükdür.",
       "ru": "Это первый плюс."
      }
     ]
    },
    {
     "who": "Ott",
     "lines": [
      {
       "et": "Teiseks ma ei teadnud, et mulle väga meeldib lastega suhelda ja nendega koos töötada.",
       "en": "Second, I didn’t know that I really like talking with children and working with them.",
       "az": "İkincisi, bilmirdim ki, uşaqlarla ünsiyyət qurmaq və onlarla birlikdə işləmək mənim çox xoşuma gəlir.",
       "ru": "Во-вторых, я не знал, что мне очень нравится общаться с детьми и работать с ними."
      }
     ]
    },
    {
     "who": "Ott",
     "lines": [
      {
       "et": "Ja kõige rohkem meeldib mulle see, kui laps ise tunnetab, et ta on midagi saavutanud ja tal on tõesti hästi läinud.",
       "en": "And what I like most is when a child feels for themselves that they have achieved something and have really done well.",
       "az": "Ən çox da o xoşuma gəlir ki, uşaq özü hiss edir ki, nəyəsə nail olub və həqiqətən yaxşı alınıb.",
       "ru": "А больше всего мне нравится, когда ребёнок сам чувствует, что чего-то добился и у него действительно хорошо получилось."
      },
      {
       "et": "Näiteks lööb jalgpallis värava, mida ta varem võib-olla ei ole teinud.",
       "en": "For example, they score a goal in football, which perhaps they have never done before.",
       "az": "Məsələn, futbolda qol vurur, bəlkə də əvvəllər heç vurmayıb.",
       "ru": "Например, забивает гол в футболе, чего раньше, может быть, не делал."
      },
      {
       "et": "Siis ma tunnen, et mina olen midagi talle õpetanud.",
       "en": "Then I feel that I have taught them something.",
       "az": "Onda hiss edirəm ki, ona nəsə öyrətmişəm.",
       "ru": "Тогда я чувствую, что я чему-то его научил."
      },
      {
       "et": "Ja ma näen ka tema rõõmu.",
       "en": "And I see their joy too.",
       "az": "Onun sevincini də görürəm.",
       "ru": "И я вижу его радость."
      },
      {
       "et": "See on kõige suurem rõõm.",
       "en": "That is the greatest joy.",
       "az": "Bu, ən böyük sevincdir.",
       "ru": "Это самая большая радость."
      },
      {
       "et": "Sealt ma saan kõige suurema rahulolu.",
       "en": "That is where I get my greatest satisfaction.",
       "az": "Ən böyük məmnunluğu elə ondan alıram.",
       "ru": "Вот откуда я получаю самое большое удовлетворение."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Kas sa oled oma tööga rahul?",
    "en": "Are you happy with your work?",
    "az": "İşindən razısanmı?",
    "ru": "Ты довольна своей работой?"
   },
   "turns": [
    {
     "who": "Marita",
     "lines": [
      {
       "et": "Ma olen väga rahul.",
       "en": "I am very happy.",
       "az": "Çox razıyam.",
       "ru": "Я очень довольна."
      },
      {
       "et": "Väga rahul!",
       "en": "Very happy!",
       "az": "Çox razı!",
       "ru": "Очень довольна!"
      },
      {
       "et": "Ma armastan seda, mida ma teen.",
       "en": "I love what I do.",
       "az": "Gördüyüm işi sevirəm.",
       "ru": "Я люблю то, что делаю."
      },
      {
       "et": "Minu töös on kõige toredam, et ma saan suhelda inimestega.",
       "en": "The best thing in my work is that I get to talk with people.",
       "az": "İşimdə ən gözəl şey insanlarla ünsiyyət qura bilməyimdir.",
       "ru": "Самое приятное в моей работе то, что я могу общаться с людьми."
      }
     ]
    },
    {
     "who": "Marita",
     "lines": [
      {
       "et": "See, mis mulle tegelikult kõige rohkem meeldib, on inimeste aus tagasiside.",
       "en": "What I actually like most is people’s honest feedback.",
       "az": "Əslində ən çox xoşuma gələn insanların səmimi rəyidir.",
       "ru": "Что мне на самом деле нравится больше всего — это честные отзывы людей."
      },
      {
       "et": "Olgu see ükskõik, milline.",
       "en": "Whatever it is like.",
       "az": "Necə olursa olsun.",
       "ru": "Какими бы они ни были."
      },
      {
       "et": "Aga mina olen positiivset tagasisidet rohkem saanud.",
       "en": "But I have had more positive feedback.",
       "az": "Amma mən daha çox müsbət rəy almışam.",
       "ru": "Но я получала больше положительных отзывов."
      }
     ]
    }
   ]
  }
 ],
