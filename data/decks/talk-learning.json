{
 "id": "talk-learning",
 "added": "2026-10-07",
 "name": {
  "en": "What you learnt last, and what you'd learn next",
  "az": "Ən son nə öyrəndin, növbəti nəyi öyrənərdin",
  "ru": "Чему ты учился недавно и чему учился бы дальше"
 },
 "why": {
  "en": "A driving school, a plastering course, a dancer at three, and learning to manage the last part of life",
  "az": "Sürücülük məktəbi, suvaq kursu, üç yaşından rəqqasə və həyatın son hissəsinin öhdəsindən gəlməyi öyrənmək",
  "ru": "Автошкола, курсы штукатурки, танцовщица с трёх лет и умение справиться с последней частью жизни"
 },
 "taste": "Hetkel ma lõpetan autokooli.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Mida sa viimati õppisid?",
    "en": "What did you learn most recently?",
    "az": "Ən son nə öyrəndin?",
    "ru": "Чему ты учился в последний раз?"
   },
   "turns": [
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Programmeerimist.",
       "en": "Programming.",
       "az": "Proqramlaşdırma.",
       "ru": "Программирование."
      },
      {
       "et": "Ma tegin ka netis programmeerimise kursuse.",
       "en": "I also did an online course in programming.",
       "az": "İnternetdə proqramlaşdırma kursu da keçdim.",
       "ru": "Я прошла ещё и онлайн-курс по программированию."
      },
      {
       "et": "See oli selline lihtne Tartu Ülikooli põhikursus “Maalähedane programmeerimine” ja see oli päris huvitav.",
       "en": "It was a simple introductory course from the University of Tartu, “Down-to-Earth Programming”, and it was quite interesting.",
       "az": "Bu, Tartu Universitetinin “Sadə proqramlaşdırma” adlı sadə əsas kursu idi və kifayət qədər maraqlı idi.",
       "ru": "Это был такой простой базовый курс Тартуского университета «Приземлённое программирование», и он был довольно интересным."
      }
     ]
    },
    {
     "who": "Mai Riin",
     "lines": [
      {
       "et": "Hetkel ma lõpetan autokooli.",
       "en": "At the moment I'm finishing driving school.",
       "az": "Hazırda sürücülük məktəbini bitirirəm.",
       "ru": "Сейчас я заканчиваю автошколу."
      },
      {
       "et": "Nii et ma õppisin autoga sõitma.",
       "en": "So I've learnt to drive a car.",
       "az": "Yəni maşın sürməyi öyrəndim.",
       "ru": "Так что я научилась водить машину."
      }
     ]
    },
    {
     "who": "Timo",
     "lines": [
      {
       "et": "Sellel kevadel osalesin ma ühel Tallinna Kutsehariduskeskuse korraldatud siseviimistlustööde kursusel, õppisime koduste remonditööde jaoks pahteldamist, tapetseerimist, värvimist, põhjatöid.",
       "en": "This spring I took part in an interior finishing course run by the Tallinn Vocational Education Centre; we learnt filling, wallpapering, painting and preparation work for home renovation.",
       "az": "Bu yaz Tallinn Peşə Təhsili Mərkəzinin təşkil etdiyi daxili bəzək işləri kursunda iştirak etdim; ev təmiri üçün şpaklyovka, divar kağızı yapışdırmaq, rəngləmək və hazırlıq işlərini öyrəndik.",
       "ru": "Этой весной я участвовал в курсе по внутренней отделке, который организовал Таллиннский центр профессионального образования; мы учились для домашнего ремонта шпаклевать, клеить обои, красить и делать подготовительные работы."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Kelleks sa saada tahad?",
    "en": "What do you want to become?",
    "az": "Kim olmaq istəyirsən?",
    "ru": "Кем ты хочешь стать?"
   },
   "turns": [
    {
     "who": "Mai Riin",
     "lines": [
      {
       "et": "Kui ma olin väike, siis ma tahtsin saada hambaarstiks nagu mu ema.",
       "en": "When I was little, I wanted to become a dentist like my mother.",
       "az": "Kiçik olanda anam kimi diş həkimi olmaq istəyirdim.",
       "ru": "Когда я была маленькой, я хотела стать зубным врачом, как моя мама."
      },
      {
       "et": "Siis ma olen mõelnud ka saada näitlejaks, lauljaks, kuigi ma laulda ei oska.",
       "en": "Then I've also thought about becoming an actor or a singer, although I can't sing.",
       "az": "Sonra aktrisa, müğənni olmağı da düşünmüşəm, baxmayaraq ki, oxumağı bacarmıram.",
       "ru": "Потом я думала стать актрисой, певицей, хотя петь я не умею."
      },
      {
       "et": "Siis ma olen mõelnud saada disaineriks, kas siis rõiva- või sisekujundusdisaineriks.",
       "en": "Then I've thought about becoming a designer, either a clothes designer or an interior designer.",
       "az": "Sonra dizayner olmağı düşünmüşəm, ya geyim, ya da interyer dizayneri.",
       "ru": "Потом я думала стать дизайнером — то ли одежды, то ли интерьера."
      },
      {
       "et": "Nii et ma olen üsna mitmekülgne.",
       "en": "So I'm quite versatile.",
       "az": "Yəni mən kifayət qədər çoxşaxəliyəm.",
       "ru": "Так что я довольно разносторонняя."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Kui sa saaksid uuesti valida, kas õpiksid midagi muud?",
    "en": "If you could choose again, would you study something else?",
    "az": "Yenidən seçə bilsəydin, başqa bir şey oxuyardınmı?",
    "ru": "Если бы ты мог выбрать заново, учился бы ты чему-то другому?"
   },
   "turns": [
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Ei õpiks.",
       "en": "No, I wouldn't.",
       "az": "Oxumazdım.",
       "ru": "Не стал бы."
      },
      {
       "et": "Sest eriala on natukene laiem mõiste kui töökoht.",
       "en": "Because a speciality is a somewhat broader idea than a job.",
       "az": "Çünki ixtisas iş yerindən bir az daha geniş anlayışdır.",
       "ru": "Потому что специальность — понятие немного более широкое, чем место работы."
      },
      {
       "et": "Ja kui ma oleksin kasvanud normaalses riigis või kui ma oleksin sündinud normaalsesse riiki - Eesti Vabariiki - , siis ma oleksin arvatavasti rohkem õppinud ajalugu.",
       "en": "And if I had grown up in a normal state, or if I had been born into a normal state — the Republic of Estonia — then I would probably have studied more history.",
       "az": "Əgər mən normal dövlətdə böyüsəydim və ya normal dövlətdə — Estoniya Respublikasında — doğulsaydım, onda yəqin ki, tarixi daha çox oxuyardım.",
       "ru": "И если бы я вырос в нормальном государстве или если бы я родился в нормальном государстве — в Эстонской Республике, — то я, вероятно, больше изучал бы историю."
      }
     ]
    },
    {
     "who": "Timo",
     "lines": [
      {
       "et": "Ma olen töötanud ajakirjanikuna, aga lõpetasin selle töö 2000ndate alguses.",
       "en": "I've worked as a journalist, but I gave that job up at the beginning of the 2000s.",
       "az": "Jurnalist kimi işləmişəm, amma bu işi 2000-ci illərin əvvəlində buraxdım.",
       "ru": "Я работал журналистом, но бросил эту работу в начале 2000-х."
      },
      {
       "et": "Nüüd olen mõelnud, et see võibolla oli viga.",
       "en": "Now I've been thinking that maybe that was a mistake.",
       "az": "İndi düşünürəm ki, bəlkə də bu, səhv idi.",
       "ru": "Теперь я думаю, что это, может быть, было ошибкой."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Kui ma saaksin uuesti sündida ja uuesti valida, siis ma läheksin kolmeaastaselt tantsutrenni ja siis ma hakkaksin tantsijaks.",
       "en": "If I could be born again and choose again, I would go to dance classes at three, and then I would become a dancer.",
       "az": "Yenidən doğula və yenidən seçə bilsəydim, üç yaşında rəqs məşqinə gedərdim və sonra rəqqasə olardım.",
       "ru": "Если бы я могла родиться заново и выбрать заново, то я бы в три года пошла на танцы и потом стала бы танцовщицей."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Mida sa veel õppida tahaksid?",
    "en": "What else would you like to learn?",
    "az": "Daha nə öyrənmək istərdin?",
    "ru": "Чему ещё ты хотел бы научиться?"
   },
   "turns": [
    {
     "who": "Timo",
     "lines": [
      {
       "et": "Tahaksin õppida veel vene keelt.",
       "en": "I'd like to learn Russian as well.",
       "az": "Rus dilini də öyrənmək istərdim.",
       "ru": "Я бы хотел ещё выучить русский язык."
      },
      {
       "et": "Sest Eestis elades on venekeelse elanikkonnaga suhtlemine minu arvates ikka väga oluline.",
       "en": "Because living in Estonia, communicating with the Russian-speaking population is, in my opinion, really very important.",
       "az": "Çünki Estoniyada yaşayarkən rusdilli əhali ilə ünsiyyət, məncə, çox vacibdir.",
       "ru": "Потому что, живя в Эстонии, общение с русскоязычным населением, по-моему, всё-таки очень важно."
      }
     ]
    },
    {
     "who": "Mai Riin",
     "lines": [
      {
       "et": "Minu soov on kindlasti minna ülikooli.",
       "en": "My wish is definitely to go to university.",
       "az": "Arzum mütləq universitetə getməkdir.",
       "ru": "Моё желание — обязательно поступить в университет."
      },
      {
       "et": "Ma olen mõelnud õppida meditsiini või võibolla juurat, aga ma ei ole veel kindlale otsusele jõudnud.",
       "en": "I've thought about studying medicine or maybe law, but I haven't come to a firm decision yet.",
       "az": "Tibb, ya da bəlkə hüquq oxumağı düşünmüşəm, amma hələ qəti qərara gəlməmişəm.",
       "ru": "Я думала изучать медицину или, может быть, право, но ещё не пришла к твёрдому решению."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Ma olen hakanud mõtlema IT-le.",
       "en": "I've started thinking about IT.",
       "az": "İT haqqında düşünməyə başlamışam.",
       "ru": "Я начала думать об IT."
      },
      {
       "et": "Tahaks vahepeal arvutitega suhelda.",
       "en": "I'd like to communicate with computers for a change.",
       "az": "Arada bir kompüterlərlə ünsiyyət qurmaq istərdim.",
       "ru": "Хотелось бы для разнообразия пообщаться с компьютерами."
      },
      {
       "et": "Ma arvan, et ma õpin järgmisena IT-d.",
       "en": "I think IT is what I'll study next.",
       "az": "Məncə, növbəti olaraq İT oxuyacağam.",
       "ru": "Я думаю, что следующим я буду изучать IT."
      }
     ]
    },
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "See on raske küsimus.",
       "en": "That's a difficult question.",
       "az": "Bu, çətin sualdır.",
       "ru": "Это трудный вопрос."
      },
      {
       "et": "Minu aastate juures on küsimus juba võibolla selles, mida sa veel tahaksid ära teha.",
       "en": "At my age the question is perhaps already what you would still like to get done.",
       "az": "Mənim yaşımda sual, bəlkə də, artıq ondadır ki, daha nəyi etmək istərdin.",
       "ru": "В мои годы вопрос, может быть, уже в том, что ты ещё хотел бы успеть сделать."
      },
      {
       "et": "Ja mul on tunne, et siiamaani on need põhiasjad kõik tegemata.",
       "en": "And I have a feeling that, up to now, the main things are all still undone.",
       "az": "Mənə elə gəlir ki, indiyədək əsas işlərin hamısı görülməmiş qalıb.",
       "ru": "И у меня такое чувство, что до сих пор все эти главные дела не сделаны."
      },
      {
       "et": "Siis võibolla ma võiksin öelda nii, et ma tahaksin õppida oma elu viimase osaga toime tulema.",
       "en": "So maybe I could put it like this: I would like to learn to cope with the last part of my life.",
       "az": "Onda bəlkə belə deyə bilərəm ki, həyatımın son hissəsinin öhdəsindən gəlməyi öyrənmək istərdim.",
       "ru": "Тогда, может быть, я мог бы сказать так: я хотел бы научиться справляться с последней частью своей жизни."
      }
     ]
    }
   ]
  }
 ],
