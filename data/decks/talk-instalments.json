{
 "id": "talk-instalments",
 "added": "2026-10-07",
 "name": {
  "en": "Buying on instalments",
  "az": "Hissə-hissə ödənişlə almaq",
  "ru": "Покупка в рассрочку"
 },
 "why": {
  "en": "A washing machine on instalments, a library card for an ID, and no to the insurance",
  "az": "Hissə-hissə ödənişlə paltaryuyan maşın, şəxsiyyət vəsiqəsi yerinə kitabxana kartı və sığortaya \"yox\"",
  "ru": "Стиральная машина в рассрочку, читательский билет вместо удостоверения и отказ от страховки"
 },
 "taste": "70 eurot on päris suur raha.",
 "source": "Keeletee",
 "scenes": [
  {
   "turns": [
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Kas ostate siis kohe välja või soovite järelmaksuga osta?",
       "en": "Will you pay for it in full now, or would you like to pay in instalments?",
       "az": "Onu indi tam ödəyib alırsınız, yoxsa hissə-hissə ödənişlə almaq istəyirsiniz?",
       "ru": "Вы сразу выкупите полностью или хотите купить в рассрочку?"
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Kui saab, siis järelmaksuga.",
       "en": "If it's possible, then in instalments.",
       "az": "Mümkündürsə, hissə-hissə ödənişlə.",
       "ru": "Если можно, то в рассрочку."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Saab-saab.",
       "en": "Of course it's possible.",
       "az": "Olar, əlbəttə.",
       "ru": "Можно, можно."
      },
      {
       "et": "Siis ma palun mingit isikut tõendavat dokumenti.",
       "en": "In that case, can I have some sort of ID, please?",
       "az": "Onda sizdən hər hansı şəxsiyyəti təsdiq edən sənəd xahiş edirəm.",
       "ru": "Тогда попрошу какой-нибудь документ, удостоверяющий личность."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Palun.",
       "en": "Here you are.",
       "az": "Buyurun.",
       "ru": "Пожалуйста."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "See on raamatukogukaart.",
       "en": "This is a library card.",
       "az": "Bu, kitabxana kartıdır.",
       "ru": "Это читательский билет."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Vabandust.",
       "en": "I'm sorry.",
       "az": "Bağışlayın.",
       "ru": "Извините."
      },
      {
       "et": "Palun.",
       "en": "Here you are.",
       "az": "Buyurun.",
       "ru": "Пожалуйста."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Nii.",
       "en": "Right.",
       "az": "Belə.",
       "ru": "Так."
      },
      {
       "et": "Lepingu vormistamine võtab veidi aega.",
       "en": "Drawing up the contract takes a little time.",
       "az": "Müqavilənin rəsmiləşdirilməsi bir az vaxt aparır.",
       "ru": "Оформление договора займёт немного времени."
      },
      {
       "et": "Istuge palun.",
       "en": "Please take a seat.",
       "az": "Əyləşin, xahiş edirəm.",
       "ru": "Присаживайтесь, пожалуйста."
      },
      {
       "et": "Ma teen dokumentidest koopiad ja võtan pangaga ühendust.",
       "en": "I'll make copies of the documents and get in touch with the bank.",
       "az": "Mən sənədlərin surətini çıxarıram və bankla əlaqə saxlayıram.",
       "ru": "Я сделаю копии документов и свяжусь с банком."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Sobib.",
       "en": "That's fine.",
       "az": "Uyğundur.",
       "ru": "Хорошо."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Kas soovite kindlustust ka?",
       "en": "Would you like insurance as well?",
       "az": "Sığorta da istəyirsiniz?",
       "ru": "Страховку тоже хотите?"
      },
      {
       "et": "See maksab ainult 70 eurot.",
       "en": "It costs only 70 euros.",
       "az": "Cəmi 70 avro tutur.",
       "ru": "Она стоит всего 70 евро."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "70 eurot on päris suur raha.",
       "en": "70 euros is quite a lot of money.",
       "az": "70 avro xeyli puldur.",
       "ru": "70 евро — это довольно большие деньги."
      },
      {
       "et": "Mis ma selle eest saan?",
       "en": "What do I get for it?",
       "az": "Bunun əvəzində nə alıram?",
       "ru": "Что я за это получу?"
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "No kui näiteks pesumasin katki läheb, siis garantiiaja sees vahetame teil kohe katkise masina uue masina vastu välja.",
       "en": "Well, if the washing machine breaks down, for instance, then within the warranty period we exchange the broken machine for a new one straight away.",
       "az": "Yaxşı, məsələn, paltaryuyan maşın xarab olsa, zəmanət müddəti ərzində xarab maşını dərhal yenisi ilə dəyişirik.",
       "ru": "Ну, если, например, стиральная машина сломается, то в течение гарантийного срока мы вам сразу заменим сломанную машину на новую."
      },
      {
       "et": "Ja garantiiaeg on kaks aastat.",
       "en": "And the warranty period is two years.",
       "az": "Zəmanət müddəti də iki ildir.",
       "ru": "А гарантийный срок — два года."
      },
      {
       "et": "Nii et kaks aastat võite täiesti muretu olla.",
       "en": "So for two years you can be completely free of worry.",
       "az": "Yəni iki il tamamilə narahatçılıqsız ola bilərsiniz.",
       "ru": "Так что два года вы можете ни о чём не беспокоиться."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Ei, kindlustust ma ei soovi.",
       "en": "No, I don't want the insurance.",
       "az": "Yox, sığorta istəmirəm.",
       "ru": "Нет, страховку я не хочу."
      },
      {
       "et": "Ma eeldan, et see pesumasin ei lähe katki.",
       "en": "I'm assuming this washing machine won't break.",
       "az": "Güman edirəm ki, bu paltaryuyan maşın xarab olmayacaq.",
       "ru": "Я исхожу из того, что эта стиральная машина не сломается."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Selge.",
       "en": "Understood.",
       "az": "Aydındır.",
       "ru": "Понятно."
      },
      {
       "et": "Kuidas arvate.",
       "en": "As you wish.",
       "az": "Necə istəyirsiniz.",
       "ru": "Как хотите."
      },
      {
       "et": "Kirjutage palun siia tänane kuupäev.",
       "en": "Please write today's date here.",
       "az": "Zəhmət olmasa, bura bugünkü tarixi yazın.",
       "ru": "Напишите, пожалуйста, здесь сегодняшнее число."
      },
      {
       "et": "Ja siia kirjutage allkiri.",
       "en": "And write your signature here.",
       "az": "Bura da imzanızı atın.",
       "ru": "А здесь распишитесь."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Oma uue pesumasina saate siis homse päeva jooksul kätte.",
       "en": "You'll get your new washing machine sometime tomorrow, then.",
       "az": "Yeni paltaryuyan maşınınızı sabah gün ərzində alacaqsınız.",
       "ru": "Свою новую стиральную машину вы тогда получите в течение завтрашнего дня."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Fantastiline!",
       "en": "Fantastic!",
       "az": "Fantastik!",
       "ru": "Фантастика!"
      }
     ]
    }
   ]
  }
 ],
