{
 "id": "talk-health",
 "added": "2026-10-07",
 "name": {
  "en": "Looking after your health",
  "az": "Sağlamlığını necə qoruyursan",
  "ru": "Как ты бережёшь здоровье"
 },
 "why": {
  "en": "Jüri quit smoking seventeen years ago, Mirja eats a bit of everything, and both sleep well",
  "az": "Yüri on yeddi il əvvəl siqareti atıb, Mirya hər şeydən bir az yeyir, ikisi də yaxşı yatır",
  "ru": "Юри семнадцать лет назад бросил курить, Мирья ест всего понемногу, и оба хорошо спят"
 },
 "taste": "Tasakaal on põhiline.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Kuidas hoiad oma tervist?",
    "en": "How do you look after your health?",
    "az": "Sağlamlığını necə qoruyursan?",
    "ru": "Как ты бережёшь своё здоровье?"
   },
   "turns": [
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Minu tervisega on nüüd küll nii, et mul ei ole oma tervisele midagi ette heita.",
       "en": "As for my health now, I have nothing to reproach it with.",
       "az": "İndi sağlamlığıma gəlincə, ona heç bir iradım yoxdur.",
       "ru": "Со здоровьем у меня сейчас так, что мне не в чем его упрекнуть."
      },
      {
       "et": "Ma olen niimoodi elanud, et ma olen siiamaani veel elus.",
       "en": "I have lived in such a way that I am still alive to this day.",
       "az": "Elə yaşamışam ki, indiyə qədər hələ sağam.",
       "ru": "Я жил так, что до сих пор ещё жив."
      },
      {
       "et": "Mul pole midagi väga kurta.",
       "en": "I have nothing much to complain about.",
       "az": "Elə bir şikayətim yoxdur.",
       "ru": "Жаловаться мне особенно не на что."
      },
      {
       "et": "Aga ega ma selleks vist väga palju midagi teinud ei ole.",
       "en": "But I probably haven’t done very much for it, either.",
       "az": "Amma bunun üçün, deyəsən, elə çox şey də etməmişəm.",
       "ru": "Но я для этого, наверное, не так уж много и сделал."
      },
      {
       "et": "Välja arvatud see, et 17 aastat tagasi ütles minu keha, et rohkem ta tubakat ei taha, ja ma jätsin suitsetamise maha.",
       "en": "Except that seventeen years ago my body said it wanted no more tobacco, and I gave up smoking.",
       "az": "Bundan başqa ki, 17 il əvvəl bədənim dedi ki, daha tütün istəmir və mən siqareti atdım.",
       "ru": "Разве что 17 лет назад моё тело сказало, что больше не хочет табака, и я бросил курить."
      },
      {
       "et": "Olin kaua aega selline kõva suitsumees ja jõin liitreid kohvi ja see vist ei olnud väga tervislik eluviis.",
       "en": "For a long time I was a heavy smoker and drank litres of coffee, and that probably wasn’t a very healthy way of life.",
       "az": "Uzun müddət çox siqaret çəkən adam idim, litrlərlə qəhvə içirdim və bu, deyəsən, elə də sağlam həyat tərzi deyildi.",
       "ru": "Я долгое время был заядлым курильщиком и пил кофе литрами, и это, наверное, был не очень здоровый образ жизни."
      },
      {
       "et": "Aga see on vist olnud ka ainus oma tervise põletamine, nii-öelda läbipõletamine või elupõletamine.",
       "en": "But that has probably been the only way I’ve burned up my health - burning out or burning through life, so to speak.",
       "az": "Amma, deyəsən, sağlamlığımı yandırmağım da yalnız bu olub, necə deyərlər, tükənmək və ya ömrü yandırmaq.",
       "ru": "Но это, наверное, и было единственное прожигание своего здоровья, так сказать, выгорание или прожигание жизни."
      }
     ]
    },
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Mis on minu hea tervise põhjus, ma ei tea.",
       "en": "What the reason for my good health is, I don’t know.",
       "az": "Sağlamlığımın səbəbi nədir, bilmirəm.",
       "ru": "В чём причина моего хорошего здоровья, я не знаю."
      },
      {
       "et": "Võib-olla see, et minu põlvkonna inimesed on elanud oludes, kus on tulnud juba lapsest saati tööd teha: majapidamistöid või ka talutöid.",
       "en": "Maybe it’s that the people of my generation lived in conditions where they had to work from childhood on: housework, or farm work too.",
       "az": "Bəlkə də ondandır ki, mənim nəslimin insanları elə şəraitdə yaşayıblar ki, uşaqlıqdan işləmək lazım gəlib: ev işləri və ya təsərrüfat işləri.",
       "ru": "Может быть, дело в том, что люди моего поколения жили в условиях, когда работать приходилось с самого детства: по хозяйству или на хуторе."
      },
      {
       "et": "Töö tegemine, füüsiline töö on kindlasti see, mis võiks tervisele hästi mõjuda.",
       "en": "Working, physical work, is surely something that can do your health good.",
       "az": "İşləmək, fiziki iş, mütləq sağlamlığa yaxşı təsir edə biləcək şeydir.",
       "ru": "Работа, физический труд — это точно то, что может хорошо влиять на здоровье."
      },
      {
       "et": "Ma olen teinud ka sporti.",
       "en": "I have done some sport, too.",
       "az": "İdmanla da məşğul olmuşam.",
       "ru": "Я и спортом занимался."
      },
      {
       "et": "Raplas olid kõik loomulikult suured korvpallurid, hiljem tulid orienteerumine ja suusatamine.",
       "en": "In Rapla everybody was naturally a keen basketball player; later came orienteering and skiing.",
       "az": "Raplada hamı, təbii ki, böyük basketbolçu idi, sonra oriyentirləmə və xizək sürmə gəldi.",
       "ru": "В Рапла все, естественно, были заядлыми баскетболистами, позже пришли ориентирование и лыжи."
      },
      {
       "et": "Ja see on ka kõik.",
       "en": "And that’s all there is.",
       "az": "Vəssalam.",
       "ru": "Вот и всё."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Mulle meeldib sporti teha!",
       "en": "I like doing sport!",
       "az": "İdmanla məşğul olmağı xoşlayıram!",
       "ru": "Я люблю заниматься спортом!"
      },
      {
       "et": "Kui ma kooliajal vihkasin trenne ja kehalist kasvatust, siis nüüd mulle tõesti meeldib sporti teha.",
       "en": "At school I hated training and PE, but now I really do like doing sport.",
       "az": "Məktəb vaxtı məşqlərə və bədən tərbiyəsinə nifrət edirdimsə, indi idmanla məşğul olmağı həqiqətən xoşlayıram.",
       "ru": "Если в школьные годы я ненавидела тренировки и физкультуру, то теперь мне правда нравится заниматься спортом."
      },
      {
       "et": "Ma käin vähemalt kolm korda nädalas trennis.",
       "en": "I go to training at least three times a week.",
       "az": "Həftədə ən azı üç dəfə məşqə gedirəm.",
       "ru": "Я хожу на тренировки как минимум три раза в неделю."
      },
      {
       "et": "Ja kui ma ei käi trennis, siis mulle meeldib ikka liikuda.",
       "en": "And when I don’t go to training, I still like to move.",
       "az": "Məşqə getməyəndə də hərəkət etməyi yenə xoşlayıram.",
       "ru": "А когда я не хожу на тренировки, мне всё равно нравится двигаться."
      },
      {
       "et": "Näiteks peale tööd, peale õhtusööki me lähme jalutama või ma käin rattaga tööl, kui on ilus ilm.",
       "en": "For instance, after work, after dinner, we go for a walk, or I cycle to work when the weather is nice.",
       "az": "Məsələn, işdən sonra, şam yeməyindən sonra gəzməyə gedirik, ya da hava gözəl olanda işə velosipedlə gedirəm.",
       "ru": "Например, после работы, после ужина мы идём гулять, или я езжу на работу на велосипеде, когда хорошая погода."
      },
      {
       "et": "Alati võib ka mingit tööd teha, tööd leiab alati.",
       "en": "You can always do some work too; there’s always work to be found.",
       "az": "Həmişə hansısa iş də görmək olar, iş həmişə tapılır.",
       "ru": "Всегда можно и поработать, работа всегда найдётся."
      },
      {
       "et": "Näiteks täna ma lähen aitan sõbral remonti teha.",
       "en": "Today, for example, I’m going to help a friend with some renovating.",
       "az": "Məsələn, bu gün gedib dostuma təmirdə kömək edirəm.",
       "ru": "Например, сегодня я иду помогать другу с ремонтом."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Ma pean ennast iga päev liigutama, muidu tuleb kohe paha tunne.",
       "en": "I have to move every day, otherwise I get a bad feeling straight away.",
       "az": "Hər gün hərəkət etməliyəm, yoxsa dərhal pis hiss edirəm.",
       "ru": "Мне нужно двигаться каждый день, иначе сразу становится нехорошо."
      },
      {
       "et": "Siis ma kohe tunnen, et keha ei ole rahul.",
       "en": "Then I feel straight away that my body isn’t happy.",
       "az": "Onda dərhal hiss edirəm ki, bədənim narazıdır.",
       "ru": "Тогда я сразу чувствую, что тело недовольно."
      },
      {
       "et": "Ma ei jälgi mingit dieeti, ma söön enam-vähem kõike.",
       "en": "I don’t follow any diet; I eat more or less everything.",
       "az": "Heç bir pəhrizə əməl etmirəm, az-çox hər şey yeyirəm.",
       "ru": "Я не соблюдаю никакой диеты, я ем более-менее всё."
      },
      {
       "et": "Põhimõtteliselt ma sööngi kõike.",
       "en": "Basically I do eat everything.",
       "az": "Əslində hər şeyi yeyirəm.",
       "ru": "В принципе, я ем всё."
      },
      {
       "et": "Ma isegi vist armastan absoluutselt kõike toidu sees.",
       "en": "I think I even love absolutely everything there is in food.",
       "az": "Deyəsən, yeməkdə olan hər şeyi tamamilə sevirəm.",
       "ru": "Я, наверное, даже люблю в еде абсолютно всё."
      },
      {
       "et": "Ma lihtsalt vaatan, et söök oleks tasakaalus: vaatan, et ma ainult liha ei sööks, vaid et oleks ikka aedvilja ja natuke puuvilja ka ja midagi magusat ja kõike natukene.",
       "en": "I just see that the food is balanced: I see that I don’t only eat meat, but that there are vegetables too, and a little fruit, and something sweet, and a little of everything.",
       "az": "Sadəcə baxıram ki, yemək balanslı olsun: baxıram ki, təkcə ət yeməyim, tərəvəz də olsun, bir az meyvə də, nəsə şirin də, hər şeydən bir az.",
       "ru": "Я просто слежу, чтобы еда была сбалансированной: слежу, чтобы есть не только мясо, а чтобы были и овощи, и немного фруктов, и что-нибудь сладкое, и всего понемножку."
      },
      {
       "et": "Tasakaal on põhiline.",
       "en": "Balance is the main thing.",
       "az": "Əsas şey balansdır.",
       "ru": "Баланс — это главное."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Ma ei ole kunagi suitsetanud.",
       "en": "I have never smoked.",
       "az": "Heç vaxt siqaret çəkməmişəm.",
       "ru": "Я никогда не курила."
      },
      {
       "et": "Ja mida vanemaks ma saan, seda vähem ma tarbin alkoholi, nüüd juba üsna-üsna-üsna harva.",
       "en": "And the older I get, the less alcohol I drink; by now very, very, very rarely.",
       "az": "Və nə qədər yaşlanıram, bir o qədər az spirtli içki içirəm, indi artıq çox-çox-çox nadir hallarda.",
       "ru": "И чем старше я становлюсь, тем меньше пью алкоголь, теперь уже очень-очень-очень редко."
      },
      {
       "et": "Ja mida ma veel ei tee?",
       "en": "And what else don’t I do?",
       "az": "Bəs daha nə etmirəm?",
       "ru": "А чего я ещё не делаю?"
      },
      {
       "et": "Ma ei laiskle.",
       "en": "I don’t laze about.",
       "az": "Tənbəllik etmirəm.",
       "ru": "Я не ленюсь."
      },
      {
       "et": "Ma ei lebota niisama, ma tegutsen.",
       "en": "I don’t just lie around; I keep busy.",
       "az": "Elə-belə uzanıb qalmıram, nəsə edirəm.",
       "ru": "Я не валяюсь просто так, я действую."
      },
      {
       "et": "Ja siis ongi hea olla.",
       "en": "And then I feel good.",
       "az": "Onda da özümü yaxşı hiss edirəm.",
       "ru": "И тогда мне и хорошо."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Ja ma ei varasta uneajast, absoluutselt mitte.",
       "en": "And I don’t steal from my sleeping time, absolutely not.",
       "az": "Yuxu vaxtımdan da oğurlamıram, qətiyyən.",
       "ru": "И я не ворую время у сна, абсолютно нет."
      },
      {
       "et": "Mul on kindel kellaaeg, ma lähen siis ilusti magama ja ma magan seitse ja pool tundi, nii et minu unetsükkel on ilusti täis.",
       "en": "I have a set time, I go to bed nicely then, and I sleep seven and a half hours, so my sleep cycle is properly complete.",
       "az": "Müəyyən bir saatım var, o vaxt qaydasınca yatıram və yeddi yarım saat yatıram, belə ki, yuxu dövrüm tam olur.",
       "ru": "У меня определённое время, я тогда как положено ложусь спать и сплю семь с половиной часов, так что мой цикл сна полностью завершается."
      },
      {
       "et": "Magan ka hästi, väga hästi.",
       "en": "And I sleep well, very well.",
       "az": "Yaxşı da yatıram, çox yaxşı.",
       "ru": "И сплю я хорошо, очень хорошо."
      }
     ]
    }
   ]
  }
 ],
