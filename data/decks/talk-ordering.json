{
 "id": "talk-ordering",
 "added": "2026-10-06",
 "name": {
  "en": "Ordering the meal",
  "az": "Yeməyi sifariş etmək",
  "ru": "Заказ"
 },
 "why": {
  "en": "Fish soup without the coconut milk, shashlik, and what comes on the side",
  "az": "Kokos südü olmadan balıq şorbası, şaşlık və yanında nə verilir",
  "ru": "Рыбный суп без кокосового молока, шашлык и что взять на гарнир"
 },
 "taste": "Nii, kas olete valmis?",
 "source": "Keeletee",
 "scenes": [
  {
   "turns": [
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Nii, kas olete valmis?",
       "en": "So, are you ready?",
       "az": "Hə, hazırsınız?",
       "ru": "Так, вы готовы?"
      }
     ]
    },
    {
     "who": "Johanna",
     "lines": [
      {
       "et": "Tegelikult õlu oli mulle.",
       "en": "Actually, the beer was for me.",
       "az": "Əslində pivə mənim idi.",
       "ru": "Вообще-то пиво было мне."
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Oi, muidugi.",
       "en": "Oh, of course.",
       "az": "Oy, əlbəttə.",
       "ru": "Ой, конечно."
      },
      {
       "et": "Vabandust!",
       "en": "Sorry!",
       "az": "Bağışlayın!",
       "ru": "Извините!"
      },
      {
       "et": "Nii, kas olete otsustanud?",
       "en": "So, have you decided?",
       "az": "Hə, qərar vermisiniz?",
       "ru": "Так, вы решили?"
      }
     ]
    },
    {
     "who": "Illimar",
     "lines": [
      {
       "et": "Mina võtaksin kalasupi.",
       "en": "I would like the fish soup.",
       "az": "Mən balıq şorbası götürərdim.",
       "ru": "Я бы взял рыбный суп."
      },
      {
       "et": "Ega see terav ei ole?",
       "en": "It isn't spicy, is it?",
       "az": "O acı deyil ki?",
       "ru": "Он не острый?"
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Seal on natukene tšillit küll, aga kuna seal on kookospiim ka sees, siis see supp väga terav ei ole, pigem on ta selline mahe.",
       "en": "There is a little chilli in it, but since there is coconut milk in it too, the soup isn't very spicy — it's rather mild.",
       "az": "İçində bir az çili var, amma kokos südü də olduğundan şorba çox acı deyil, daha çox mülayimdir.",
       "ru": "Чили в нём немного есть, но поскольку там ещё и кокосовое молоко, суп не очень острый — скорее мягкий."
      }
     ]
    },
    {
     "who": "Illimar",
     "lines": [
      {
       "et": "Kas ilma kookospiimata ei saaks?",
       "en": "Couldn't I have it without the coconut milk?",
       "az": "Kokos südü olmadan olmaz?",
       "ru": "А без кокосового молока нельзя?"
      },
      {
       "et": "Ma kookospiima väga ei armasta.",
       "en": "I'm not very fond of coconut milk.",
       "az": "Mən kokos südünü o qədər də sevmirəm.",
       "ru": "Я не очень люблю кокосовое молоко."
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Saab ikka, ma räägin kokaga.",
       "en": "Of course you can, I'll talk to the chef.",
       "az": "Olar, əlbəttə, aşpazla danışaram.",
       "ru": "Конечно, можно, я поговорю с поваром."
      }
     ]
    },
    {
     "who": "Johanna",
     "lines": [
      {
       "et": "Mulle palun šašlõkk.",
       "en": "Shashlik for me, please.",
       "az": "Mənə şaşlık, zəhmət olmasa.",
       "ru": "Мне, пожалуйста, шашлык."
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Mis lisandit te šašlõki kõrvale soovite?",
       "en": "What side would you like with the shashlik?",
       "az": "Şaşlığın yanına hansı qarnir istəyirsiniz?",
       "ru": "Какой гарнир вы хотите к шашлыку?"
      },
      {
       "et": "Meil saab valida friikartulid, praekartulid, ahjukartulid, keedukartulid, hautatud aedviljad.",
       "en": "You can choose from fries, fried potatoes, baked potatoes, boiled potatoes or stewed vegetables.",
       "az": "Fri kartofu, qızardılmış kartof, sobada bişmiş kartof, qaynadılmış kartof, buğlanmış tərəvəz seçmək olar.",
       "ru": "На выбор картофель фри, жареный картофель, запечённый картофель, отварной картофель, тушёные овощи."
      },
      {
       "et": "Tatar ja riis on ka valikus.",
       "en": "Buckwheat and rice are on offer too.",
       "az": "Qarabaşaq və düyü də var.",
       "ru": "Есть также гречка и рис."
      }
     ]
    },
    {
     "who": "Johanna",
     "lines": [
      {
       "et": "Ma võtaksin ainult mingi värske salati, näiteks tomati-kurgisalati.",
       "en": "I would just have some fresh salad, the tomato and cucumber salad for instance.",
       "az": "Mən ancaq bir təzə salat götürərdim, məsələn, pomidor-xiyar salatı.",
       "ru": "Я бы взяла только какой-нибудь свежий салат, например салат из помидоров и огурцов."
      },
      {
       "et": "Millest see salat koosneb?",
       "en": "What is in that salad?",
       "az": "Bu salatın tərkibində nə var?",
       "ru": "Из чего он состоит?"
      },
      {
       "et": "Ega selle sees küüslauku pole?",
       "en": "There's no garlic in it, is there?",
       "az": "İçində sarımsaq yoxdur ki?",
       "ru": "В нём нет чеснока?"
      },
      {
       "et": "Ma olen küüslaugu vastu allergiline.",
       "en": "I'm allergic to garlic.",
       "az": "Mənim sarımsağa allergiyam var.",
       "ru": "У меня аллергия на чеснок."
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Selles salatis ongi ainult tomat ja kurk, küüslauku ei ole.",
       "en": "That salad is just tomato and cucumber, no garlic.",
       "az": "Bu salatda ancaq pomidor və xiyar var, sarımsaq yoxdur.",
       "ru": "В этом салате только помидоры и огурцы, чеснока нет."
      },
      {
       "et": "Kas veel midagi?",
       "en": "Anything else?",
       "az": "Daha nəsə?",
       "ru": "Что-нибудь ещё?"
      }
     ]
    },
    {
     "who": "Johanna",
     "lines": [
      {
       "et": "See on hetkel vist kõik.",
       "en": "That's probably all for now.",
       "az": "Hələlik, deyəsən, hamısı budur.",
       "ru": "Пока, наверное, всё."
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Hüva.",
       "en": "Fine.",
       "az": "Yaxşı.",
       "ru": "Хорошо."
      },
      {
       "et": "Ma jätan ühe menüü lauda, äkki soovite pärast magustoitu või midagi.",
       "en": "I'll leave one menu on the table, in case you want a dessert or something later.",
       "az": "Bir menyunu masada qoyuram, bəlkə sonra desert və ya nəsə istədiniz.",
       "ru": "Я оставлю одно меню на столе — вдруг потом захотите десерт или ещё что-нибудь."
      }
     ]
    },
    {
     "who": "Illimar",
     "lines": [
      {
       "et": "Jah, võib-olla.",
       "en": "Yes, maybe.",
       "az": "Hə, bəlkə.",
       "ru": "Да, может быть."
      },
      {
       "et": "Kui kaua söökidega läheb?",
       "en": "How long will the food take?",
       "az": "Yeməklər nə qədər çəkəcək?",
       "ru": "Сколько ждать еду?"
      }
     ]
    },
    {
     "who": "Ettekandja",
     "lines": [
      {
       "et": "Ei lähe kaua.",
       "en": "Not long.",
       "az": "Çox çəkməz.",
       "ru": "Недолго."
      },
      {
       "et": "Supi saab kohe ja šašlõkiga läheb kõige rohkem 15 minutit.",
       "en": "The soup comes right away, and the shashlik takes fifteen minutes at the most.",
       "az": "Şorba dərhal gəlir, şaşlık isə ən çoxu 15 dəqiqə çəkər.",
       "ru": "Суп будет сразу, а шашлык займёт самое большее 15 минут."
      }
     ]
    },
    {
     "who": "Illimar",
     "lines": [
      {
       "et": "Sinu terviseks, mu lill!",
       "en": "Your health, my flower!",
       "az": "Sənin sağlığına, çiçəyim!",
       "ru": "За твоё здоровье, мой цветочек!"
      },
      {
       "et": "Kõks!",
       "en": "Cheers!",
       "az": "Çin-çin!",
       "ru": "Чин-чин!"
      }
     ]
    }
   ]
  }
 ],
