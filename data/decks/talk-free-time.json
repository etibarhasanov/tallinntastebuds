{
 "id": "talk-free-time",
 "added": "2026-11-05",
 "name": {
  "en": "What you do in your free time",
  "az": "Boş vaxtında nə edirsən",
  "ru": "Что ты делаешь в свободное время"
 },
 "why": {
  "en": "Sport outdoors in every season, a jazz club in Tallinn and Netflix, basketball and an evening lost on YouTube",
  "az": "Hər fəsildə açıq havada idman, Tallinndə caz klubu və Netflix, basketbol və YouTube-da itən bir axşam",
  "ru": "Спорт на улице в любое время года, джаз-клуб в Таллинне и Netflix, баскетбол и вечер, потерянный на YouTube"
 },
 "taste": "Mul ei ole kunagi igav.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Mida sa teed vabal ajal?",
    "en": "What do you do in your free time?",
    "az": "Boş vaxtında nə edirsən?",
    "ru": "Что ты делаешь в свободное время?"
   },
   "turns": [
    {
     "who": "Piret",
     "lines": [
      {
       "et": "Mul ei ole kunagi igav.",
       "en": "I am never bored.",
       "az": "Heç vaxt darıxmıram.",
       "ru": "Мне никогда не бывает скучно."
      },
      {
       "et": "Võib-olla mul tuleb isegi ajast puudu.",
       "en": "Maybe I am even short of time.",
       "az": "Bəlkə də hətta vaxtım çatmır.",
       "ru": "Может быть, мне даже не хватает времени."
      },
      {
       "et": "Mitte võib-olla, mul ongi kogu aeg ajast puudu!",
       "en": "Not maybe — I am always short of time!",
       "az": "Bəlkə yox, vaxtım həmişə çatmır!",
       "ru": "Не может быть, а мне всё время не хватает времени!"
      },
      {
       "et": "Ma tahaksin palju rohkem teha!",
       "en": "I would like to do much more!",
       "az": "Daha çox şey etmək istərdim!",
       "ru": "Я бы хотела делать гораздо больше!"
      },
      {
       "et": "Aga suure osa oma vabast ajast tegelen spordiga.",
       "en": "But I spend a large part of my free time on sport.",
       "az": "Amma boş vaxtımın böyük hissəsini idmanla məşğul oluram.",
       "ru": "Но большую часть свободного времени я занимаюсь спортом."
      }
     ]
    },
    {
     "who": "Piret",
     "lines": [
      {
       "et": "Minu jaoks tähendab sport loodust ja õues käimist, sest põhiliselt teen ma sporti ikkagi õues.",
       "en": "For me sport means nature and being outdoors, because I mostly do my sport outside.",
       "az": "Mənim üçün idman təbiət və açıq havaya çıxmaq deməkdir, çünki idmanla əsasən yenə də çöldə məşğul oluram.",
       "ru": "Для меня спорт означает природу и прогулки на воздухе, потому что спортом я занимаюсь в основном всё-таки на улице."
      },
      {
       "et": "Ma käin sportimas erinevatel aastaaegadel ja erinevates kohtades.",
       "en": "I go out for sport in different seasons and in different places.",
       "az": "Müxtəlif fəsillərdə və müxtəlif yerlərdə idman etməyə gedirəm.",
       "ru": "Я занимаюсь спортом в разное время года и в разных местах."
      },
      {
       "et": "Tutvun erinevate inimestega.",
       "en": "I get to know different people.",
       "az": "Müxtəlif insanlarla tanış oluram.",
       "ru": "Знакомлюсь с разными людьми."
      },
      {
       "et": "See, mis õues toimub, ja see, kuidas loodus välja näeb, on iga kord erinev.",
       "en": "What goes on outside, and how nature looks, is different every time.",
       "az": "Çöldə baş verənlər də, təbiətin necə göründüyü də hər dəfə başqa cür olur.",
       "ru": "То, что происходит на улице, и то, как выглядит природа, каждый раз разное."
      },
      {
       "et": "Ja see on nii lahe!",
       "en": "And that is so cool!",
       "az": "Bu da çox əladır!",
       "ru": "И это так здорово!"
      },
      {
       "et": "Ja see mulle meeldib!",
       "en": "And I like that!",
       "az": "Bu da xoşuma gəlir!",
       "ru": "И мне это нравится!"
      }
     ]
    },
    {
     "who": "Johannes",
     "lines": [
      {
       "et": "Tallinnas on üks äge džässiklubi, kus toimub nädala sees väga häid džässikontserte.",
       "en": "There is a great jazz club in Tallinn that has very good jazz concerts during the week.",
       "az": "Tallinndə bir əla caz klubu var, orada həftə içi çox yaxşı caz konsertləri olur.",
       "ru": "В Таллинне есть один классный джаз-клуб, где по будням проходят очень хорошие джазовые концерты."
      },
      {
       "et": "Ma üritan sinna minna.",
       "en": "I try to go there.",
       "az": "Oraya getməyə çalışıram.",
       "ru": "Я стараюсь туда ходить."
      },
      {
       "et": "Või siis teine variant on see, et mõnikord ma sisustan oma vaba aega Netflixiga nagu teisedki noored.",
       "en": "Or the other option is that sometimes I fill my free time with Netflix, like other young people.",
       "az": "Ya da başqa variant budur ki, bəzən boş vaxtımı başqa gənclər kimi Netflixlə doldururam.",
       "ru": "Или другой вариант: иногда я заполняю свободное время Netflix’ом, как и другие молодые люди."
      },
      {
       "et": "Ma vaatan mingeid videoid või kuulan muusikat.",
       "en": "I watch some videos or listen to music.",
       "az": "Hansısa videolara baxıram ya da musiqi dinləyirəm.",
       "ru": "Смотрю какие-нибудь видео или слушаю музыку."
      },
      {
       "et": "Käin ka pidudel ja puhkan ja käin tuttavatel külas ja lähen sõpradega aeg-ajalt sauna.",
       "en": "I also go to parties and rest, and visit people I know, and now and then go to the sauna with friends.",
       "az": "Məclislərə də gedirəm, dincəlirəm, tanışlara qonaq gedirəm, arabir dostlarla saunaya gedirəm.",
       "ru": "Ещё хожу на вечеринки, отдыхаю, хожу в гости к знакомым и время от времени хожу с друзьями в сауну."
      },
      {
       "et": "Selline see vaba aeg on!",
       "en": "That is what free time is like!",
       "az": "Boş vaxt belədir!",
       "ru": "Вот такое оно, свободное время!"
      }
     ]
    },
    {
     "who": "Ott",
     "lines": [
      {
       "et": "Käin kolm korda nädalas korvpallitrennis.",
       "en": "I go to basketball training three times a week.",
       "az": "Həftədə üç dəfə basketbol məşqinə gedirəm.",
       "ru": "Три раза в неделю я хожу на тренировки по баскетболу."
      },
      {
       "et": "Vaba aega sisustan ka lugemisega.",
       "en": "I also fill my free time with reading.",
       "az": "Boş vaxtımı oxumaqla da doldururam.",
       "ru": "Свободное время я заполняю ещё и чтением."
      },
      {
       "et": "Mängin arvutimänge koos sõpradega.",
       "en": "I play computer games with friends.",
       "az": "Dostlarla kompüter oyunları oynayıram.",
       "ru": "Играю с друзьями в компьютерные игры."
      },
      {
       "et": "Telekat ma peaaegu ei vaata, mina olen rohkem arvutis.",
       "en": "I hardly watch TV; I am more on the computer.",
       "az": "Televizora demək olar ki, baxmıram, daha çox kompüterdəyəm.",
       "ru": "Телевизор я почти не смотрю, я больше сижу за компьютером."
      },
      {
       "et": "Arvutis ma jälgin paljusid Youtube’i kanaleid, mis tegelikult minu jaoks ongi nagu teleka asemel.",
       "en": "On the computer I follow a lot of YouTube channels, which for me actually take the place of TV.",
       "az": "Kompüterdə çoxlu YouTube kanalını izləyirəm, onlar əslində mənim üçün televizorun yerini tutur.",
       "ru": "За компьютером я слежу за многими каналами на YouTube, которые для меня, по сути, и заменяют телевизор."
      },
      {
       "et": "See on maailm, kuhu ma mõni õhtu ära eksin.",
       "en": "It is a world I get lost in some evenings.",
       "az": "Bu, bəzi axşamlar içində itib-batdığım bir dünyadır.",
       "ru": "Это мир, в котором я иной вечер теряюсь."
      },
      {
       "et": "Klikin ühele asjale ja see läheb teise asja juurde ja nii edasi.",
       "en": "I click on one thing and it leads to another thing, and so on.",
       "az": "Bir şeyə klikləyirəm, o da başqa bir şeyə aparır və sair.",
       "ru": "Кликаю на одно, оно ведёт к другому, и так далее."
      }
     ]
    }
   ]
  }
 ],
