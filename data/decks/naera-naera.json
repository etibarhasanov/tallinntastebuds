 "deck": "naera-words",
 "verses": [
  [
   {
    "et": "Naera, naera, naerame võidu,",
    "en": "Laugh, laugh, let's race to laugh —",
    "az": "Gül, gül, gəl yarışaraq gülək —",
    "ru": "Смейся, смейся, посмеёмся наперегонки —"
   },
   {
    "et": "kes naerab paremini…",
    "en": "who laughs the better…",
    "az": "kim daha yaxşı gülür…",
    "ru": "кто посмеётся лучше…"
   },
   {
    "et": "Läbi tuliste suvede",
    "en": "Through the fiery summers",
    "az": "Alovlu yayların içindən",
    "ru": "Сквозь огненные лета"
   },
   {
    "et": "ja talviti aremini.",
    "en": "and, in winter, more shyly.",
    "az": "qışlar isə daha çəkingən.",
    "ru": "а зимами — робче."
   }
  ],
  [
   {
    "et": "Kui sa julged, saad elust läbi",
    "en": "If you dare, you get through life",
    "az": "Cürət etsən, həyatdan keçərsən",
    "ru": "Если осмелишься, пройдёшь по жизни"
   },
   {
    "et": "otse ja pugemata.",
    "en": "straight, and without grovelling.",
    "az": "düz və yaltaqlanmadan.",
    "ru": "прямо и не пресмыкаясь."
   },
   {
    "et": "Päevad kõik on kalendris kinni.",
    "en": "The days are all shut in the calendar.",
    "az": "Günlərin hamısı təqvimdə bağlıdır.",
    "ru": "Все дни заперты в календаре."
   },
   {
    "et": "Kinni ja lugemata.",
    "en": "Shut, and uncounted.",
    "az": "Bağlı və sayılmamış.",
    "ru": "Заперты и не сосчитаны."
   }
  ],
  [
   {
    "et": "Sinu sinistes veresoontes",
    "en": "In your blue veins",
    "az": "Sənin mavi damarlarında",
    "ru": "В твоих синих жилах"
   },
   {
    "et": "pesitseb põliskevad.",
    "en": "an age-old spring is nesting.",
    "az": "əzəli bir bahar yuva qurub.",
    "ru": "гнездится извечная весна."
   },
   {
    "et": "Minu kondid on kuusepuised,",
    "en": "My bones are made of spruce,",
    "az": "Mənim sümüklərim küknar ağacındandır,",
    "ru": "Мои кости — еловые,"
   },
   {
    "et": "valged ja kõlisevad.",
    "en": "white, and they ring.",
    "az": "ağdır və cingildəyir.",
    "ru": "белые и звенящие."
   }
  ],
  [
   {
    "et": "Suvi tuleb ja suvi läheb,",
    "en": "Summer comes and summer goes,",
    "az": "Yay gəlir, yay gedir,",
    "ru": "Лето приходит и лето уходит,"
   },
   {
    "et": "suislepp see veretabki.",
    "en": "and the suislepp apple even turns blood-red.",
    "az": "suislepp alması isə qan kimi qızarır.",
    "ru": "а суйслепп даже наливается алым."
   },
   {
    "et": "Armastus hulgub ilma mööda.",
    "en": "Love wanders about the world.",
    "az": "Məhəbbət dünyanı dolaşır.",
    "ru": "Любовь бродит по свету."
   },
   {
    "et": "Kättpidi teretabki.",
    "en": "It even greets you by the hand.",
    "az": "Hətta əlindən tutub salamlaşır.",
    "ru": "И даже здоровается за руку."
   }
  ]
 ],
