{
 "id": "talk-adventure",
 "added": "2026-10-07",
 "name": {
  "en": "An especially exciting trip",
  "az": "Xüsusilə maraqlı bir səfər",
  "ru": "Особенно захватывающая поездка"
 },
 "why": {
  "en": "Floating like a crocodile in a salt-mine lake in the Carpathians, and climbing through a hole into a dripping cave of bats",
  "az": "Karpatlarda duz mədəni gölündə timsah kimi üzmək və deşikdən damcılayan, yarasalarla dolu mağaraya girmək",
  "ru": "Лежать на воде, как крокодил, в соляном озере в Карпатах и пролезть через дыру в мокрую пещеру с летучими мышами"
 },
 "taste": "Ja seal olid soolakaevandused.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Räägi ühest eriti põnevast reisielamusest!",
    "en": "Tell us about an especially exciting travel experience!",
    "az": "Xüsusilə maraqlı bir səfər təəssüratından danış!",
    "ru": "Расскажи об одном особенно захватывающем впечатлении от поездки!"
   },
   "turns": [
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "See oli 1981. aastal, kui ma käisin ühe sõbraga Taga-Karpaatides.",
       "en": "It was in 1981, when I went to Transcarpathia with a friend.",
       "az": "Bu, 1981-ci ildə idi, bir dostla Zakarpatyeyə getmişdim.",
       "ru": "Это было в 1981 году, когда я ездил с одним другом в Закарпатье."
      },
      {
       "et": "Selle sõbra naine oli sealt pärit ungarlanna, kelle vanemate juurde me külla läksime.",
       "en": "This friend’s wife was a Hungarian woman from there, and it was her parents we were visiting.",
       "az": "Bu dostun arvadı oralı bir macar qadını idi, biz onun valideynlərinin yanına qonaq getdik.",
       "ru": "Жена этого друга была венгерка родом оттуда, и мы поехали в гости к её родителям."
      },
      {
       "et": "See koht oli ungari keeles Zlatina ja ukraina keeles ja vene keeles Solotvino.",
       "en": "The place was Zlatina in Hungarian, and Solotvino in Ukrainian and in Russian.",
       "az": "O yer macarca Zlatina, ukraynaca və rusca isə Solotvino idi.",
       "ru": "Это место по-венгерски называлось Златина, а по-украински и по-русски — Солотвино."
      },
      {
       "et": "Ja seal olid soolakaevandused.",
       "en": "And there were salt mines there.",
       "az": "Orada duz mədənləri var idi.",
       "ru": "И там были соляные шахты."
      },
      {
       "et": "Tänu sellele, et seal olid soolakaevandused, oli sinna rajatud ka sanatoorium.",
       "en": "Thanks to the salt mines, a sanatorium had been built there too.",
       "az": "Orada duz mədənləri olduğu üçün ora sanatoriya da tikilmişdi.",
       "ru": "Благодаря тому, что там были соляные шахты, там построили и санаторий."
      }
     ]
    },
    {
     "who": "Jüri",
     "lines": [
      {
       "et": "Ja see on koht, mida võiks kindlasti võrrelda Surnumerega.",
       "en": "And this is a place that could surely be compared to the Dead Sea.",
       "az": "Bu, mütləq Ölü dənizlə müqayisə oluna biləcək bir yerdir.",
       "ru": "И это место, которое точно можно сравнить с Мёртвым морем."
      },
      {
       "et": "Sest kui sa sinna vette läksid, siis jalad tõusid üles ja sa olid vee peal ja seal ei olnud võimalik vee alla vajuda.",
       "en": "Because when you went into the water, your legs came up, and you were on top of the water, and there it was impossible to sink under it.",
       "az": "Çünki suya girəndə ayaqların yuxarı qalxırdı, suyun üstündə olurdun və orada suyun altına batmaq mümkün deyildi.",
       "ru": "Потому что, когда ты заходил в воду, ноги поднимались, ты лежал на воде, и уйти под воду там было невозможно."
      },
      {
       "et": "Seal tuli lihtsalt olla hoolas, et vesi ei läheks suhu ega silma.",
       "en": "You just had to be careful that the water didn’t get into your mouth or your eyes.",
       "az": "Sadəcə diqqətli olmaq lazım idi ki, su ağzına və gözünə getməsin.",
       "ru": "Там просто нужно было быть осторожным, чтобы вода не попала в рот или в глаза."
      },
      {
       "et": "Ja kui me seal ringi ujusime, siis märkasime selliseid suuremaid tädisid seal vee peal, kes tulid nagu krokodillid - see oli ka omaette vaatamisväärsus!",
       "en": "And when we swam around there, we noticed these larger ladies on the water who came along like crocodiles - that was quite a sight in itself!",
       "az": "Orada üzüb gəzəndə suyun üstündə timsah kimi gələn iri bədənli xalaları gördük - bu da ayrıca bir tamaşa idi!",
       "ru": "А когда мы там плавали, то заметили на воде таких крупных тётушек, которые плыли, как крокодилы, — это было отдельное зрелище!"
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Ma olin siis palju noorem ja see oli elus esimest korda, kui ma nägin koobastes nahkhiiri.",
       "en": "I was a good deal younger then, and it was the first time in my life that I saw bats in caves.",
       "az": "Mən onda çox cavan idim və həyatımda ilk dəfə idi ki, mağaralarda yarasa gördüm.",
       "ru": "Я тогда была гораздо моложе, и это был первый раз в жизни, когда я видела летучих мышей в пещерах."
      },
      {
       "et": "Siis ma ei teadnud veel, kuidas nad elavad.",
       "en": "At that time I didn’t know yet how they live.",
       "az": "Onda hələ bilmirdim ki, onlar necə yaşayırlar.",
       "ru": "Тогда я ещё не знала, как они живут."
      },
      {
       "et": "Ma sain istuda koopas, tilkuvas koopas ja vaadata, kuidas nahkhiired seal elavad.",
       "en": "I got to sit in the cave, a dripping cave, and watch how the bats live there.",
       "az": "Mağarada, damcılayan mağarada oturub yarasaların orada necə yaşadığına baxa bildim.",
       "ru": "Мне довелось посидеть в пещере, в пещере, где капает, и посмотреть, как там живут летучие мыши."
      }
     ]
    },
    {
     "who": "Mirja",
     "lines": [
      {
       "et": "Väga lahedad koopad!",
       "en": "Really cool caves!",
       "az": "Çox maraqlı mağaralar!",
       "ru": "Очень классные пещеры!"
      },
      {
       "et": "Maa peal oli selline pisikene auk.",
       "en": "There was this tiny hole in the ground.",
       "az": "Yerdə belə balaca bir deşik var idi.",
       "ru": "В земле была такая крошечная дырка."
      },
      {
       "et": "Ma mõtlesin, et kas mina mahun sealt sisse.",
       "en": "I wondered whether I would fit through it.",
       "az": "Fikirləşdim ki, görəsən, mən oradan sığışaram.",
       "ru": "Я подумала: пролезу ли я туда?"
      },
      {
       "et": "Aga kõik turistid - me olime neljakesi - ronisid sealt august sisse ja siis me olime küll müstilises maailmas!",
       "en": "But all the tourists - there were four of us - climbed in through that hole, and then we really were in a mystical world!",
       "az": "Amma bütün turistlər - biz dörd nəfər idik - o deşikdən içəri girdilər və onda, doğrudan da, sirli bir dünyada idik!",
       "ru": "Но все туристы — нас было четверо — пролезли через эту дыру, и тогда мы оказались в самом настоящем мистическом мире!"
      },
      {
       "et": "See koobas oli selline hästi madal, hästi märg, niiske, tilkus, pime.",
       "en": "This cave was very low, very wet, damp, dripping, dark.",
       "az": "Bu mağara çox alçaq, çox yaş, rütubətli, damcılayan, qaranlıq idi.",
       "ru": "Эта пещера была очень низкая, очень мокрая, сырая, капала, тёмная."
      },
      {
       "et": "Aga meil olid muidugi lambid.",
       "en": "But of course we had lamps.",
       "az": "Amma əlbəttə ki, lampalarımız var idi.",
       "ru": "Но у нас, конечно, были фонари."
      },
      {
       "et": "Eestis ei ole selliseid koopaid, midagi meil on, aga see ei ole võrreldav!",
       "en": "There are no caves like that in Estonia; we do have something, but it isn’t comparable!",
       "az": "Estoniyada belə mağaralar yoxdur, nəsə var, amma müqayisə olunmaz!",
       "ru": "В Эстонии таких пещер нет, что-то у нас есть, но это несравнимо!"
      }
     ]
    }
   ]
  }
 ],
