{
 "id": "talk-neighbours",
 "added": "2026-10-07",
 "name": {
  "en": "Neighbours",
  "az": "Qonşular",
  "ru": "Соседи"
 },
 "why": {
  "en": "Who talks to the neighbours, who only says hello, and what comes through the wall",
  "az": "Kim qonşularla danışır, kim sadəcə salam verir və divarın o tayından nə eşidilir",
  "ru": "Кто общается с соседями, кто только здоровается и что слышно через стену"
 },
 "taste": "Läbi seina kostab mõnikord hääli.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Kas sa suhtled oma naabritega?",
    "en": "Do you talk to your neighbours?",
    "az": "Qonşularınla ünsiyyət qurursan?",
    "ru": "Ты общаешься с соседями?"
   },
   "turns": [
    {
     "who": "Aleksandr",
     "lines": [
      {
       "et": "Mina suhtlen oma naabritega küll.",
       "en": "I do talk to my neighbours.",
       "az": "Mən qonşularımla ünsiyyət qururam.",
       "ru": "Я со своими соседями общаюсь."
      },
      {
       "et": "Näiteks ma suhtlen ühe venelasega.",
       "en": "For instance, I talk with one Russian guy.",
       "az": "Məsələn, bir rusla danışıram.",
       "ru": "Например, я общаюсь с одним русским."
      },
      {
       "et": "Varem me suhtlesime päris tihedalt ja käisime üksteisel külas.",
       "en": "We used to be in touch quite a lot and visited each other.",
       "az": "Əvvəllər çox sıx əlaqədə idik və bir-birimizə qonaq gedirdik.",
       "ru": "Раньше мы общались довольно тесно и ходили друг к другу в гости."
      },
      {
       "et": "Aga teisi naabreid ma tervitan.",
       "en": "The other neighbours I just greet.",
       "az": "Digər qonşularla isə sadəcə salamlaşıram.",
       "ru": "А с остальными соседями я здороваюсь."
      }
     ]
    },
    {
     "who": "Ingrid",
     "lines": [
      {
       "et": "Teate, ma suhtlesin naabritega, kui ma siia kolisin.",
       "en": "You know, I did talk to my neighbours when I moved here.",
       "az": "Bilirsiniz, buraya köçəndə qonşularla ünsiyyət qururdum.",
       "ru": "Знаете, я общалась с соседями, когда сюда переехала."
      },
      {
       "et": "Kohe minu kõrval elas üks tädi Liia.",
       "en": "Right next door lived an old lady, Liia.",
       "az": "Düz yanımda Liia xala yaşayırdı.",
       "ru": "Прямо рядом со мной жила одна тётя Liia."
      },
      {
       "et": "Temaga me saime väga hästi läbi.",
       "en": "We got along with her very well.",
       "az": "Onunla çox yaxşı yola gedirdik.",
       "ru": "Мы с ней очень хорошо ладили."
      },
      {
       "et": "Väga tore inimene oli.",
       "en": "She was a very nice person.",
       "az": "Çox gözəl insan idi.",
       "ru": "Очень славный был человек."
      },
      {
       "et": "Hästi tore inimene oli.",
       "en": "A really nice person.",
       "az": "Həqiqətən gözəl insan idi.",
       "ru": "Очень хороший был человек."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Mis sind häirib sinu kodu juures?",
    "en": "What bothers you about your home?",
    "az": "Evində səni nə narahat edir?",
    "ru": "Что тебе мешает дома?"
   },
   "turns": [
    {
     "who": "Aleksandr",
     "lines": [
      {
       "et": "Mind häirib, kui teisel korrusel elav naaber või naabrid suitsetavad ventilatsioonitorru.",
       "en": "It bothers me when the neighbour or neighbours on the second floor smoke into the ventilation shaft.",
       "az": "İkinci mərtəbədə yaşayan qonşu və ya qonşular ventilyasiya borusuna siqaret çəkəndə məni narahat edir.",
       "ru": "Меня раздражает, когда сосед или соседи со второго этажа курят в вентиляцию."
      },
      {
       "et": "See häirib mind väga.",
       "en": "That bothers me a lot.",
       "az": "Bu, məni çox narahat edir.",
       "ru": "Это меня очень раздражает."
      },
      {
       "et": "Olen käinud juba mitu korda nendega rääkimas.",
       "en": "I've already gone to talk to them several times.",
       "az": "Artıq bir neçə dəfə gedib onlarla danışmışam.",
       "ru": "Я уже несколько раз ходил с ними поговорить."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Kas sa kuuled oma naabreid?",
    "en": "Do you hear your neighbours?",
    "az": "Qonşularını eşidirsən?",
    "ru": "Ты слышишь своих соседей?"
   },
   "turns": [
    {
     "who": "Aleksandr",
     "lines": [
      {
       "et": "Läbi seina kostab mõnikord hääli.",
       "en": "Sometimes you hear voices through the wall.",
       "az": "Bəzən divarın o tayından səslər eşidilir.",
       "ru": "Через стену иногда слышны голоса."
      },
      {
       "et": "Aga õnneks on minu naabrid sellised vaiksed, kes eriti ei laamenda ja elavad rahulikult.",
       "en": "Fortunately, my neighbours are quiet types who don't make much of a racket and live peacefully.",
       "az": "Amma xoşbəxtlikdən qonşularım elə sakit adamlardır ki, çox səs-küy salmırlar və rahat yaşayırlar.",
       "ru": "Но, к счастью, мои соседи такие тихие, особо не буянят и живут спокойно."
      },
      {
       "et": "Kui üldse midagi kostab, siis ainult see, kui keegi kõnnib või tormab ringi korteris.",
       "en": "When anything can be heard at all, it's just someone walking or rushing around the flat.",
       "az": "Ümumiyyətlə nəsə eşidilirsə, ancaq kimsə mənzildə gəzəndə və ya o yan-bu yana qaçanda.",
       "ru": "Если вообще что-то слышно, то только когда кто-то ходит или носится по квартире."
      },
      {
       "et": "Ma ei tea, võib-olla otsib midagi.",
       "en": "I don't know, maybe looking for something.",
       "az": "Bilmirəm, bəlkə nəsə axtarır.",
       "ru": "Не знаю, может, что-то ищет."
      },
      {
       "et": "Ja siis, kui midagi kukub, siis võib-olla kostab läbi.",
       "en": "And then when something falls, maybe that comes through.",
       "az": "Bir də nəsə yerə düşəndə, bəlkə o eşidilir.",
       "ru": "А ещё когда что-то падает, тогда, может, слышно."
      },
      {
       "et": "Või kui lapsed kisavad.",
       "en": "Or when the kids scream.",
       "az": "Ya da uşaqlar qışqıranda.",
       "ru": "Или когда дети кричат."
      },
      {
       "et": "Aga see ei ole minu jaoks probleem.",
       "en": "But it isn't a problem for me.",
       "az": "Amma bu, mənim üçün problem deyil.",
       "ru": "Но для меня это не проблема."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Mis sind häirib sinu kodu juures?",
    "en": "What bothers you about your home?",
    "az": "Evində səni nə narahat edir?",
    "ru": "Что тебе мешает дома?"
   },
   "turns": [
    {
     "who": "Arvo",
     "lines": [
      {
       "et": "Mind häirivad minu naabrid.",
       "en": "My neighbours bother me.",
       "az": "Məni qonşularım narahat edir.",
       "ru": "Мне мешают мои соседи."
      },
      {
       "et": "Mõned inimesed on väga lapsikud.",
       "en": "Some people are so childish.",
       "az": "Bəzi adamlar çox uşaq kimidir.",
       "ru": "Некоторые люди очень инфантильны."
      },
      {
       "et": "See on uskumatu, kuidas nad kaebavad ja ei korista.",
       "en": "It's unbelievable how they complain and don't clean up after themselves.",
       "az": "İnanılmazdır, necə şikayət edirlər və arxalarınca yığışdırmırlar.",
       "ru": "Невероятно, как они жалуются и не убирают за собой."
      }
     ]
    }
   ]
  }
 ],
