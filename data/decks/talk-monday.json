{
 "id": "talk-monday",
 "added": "2026-10-06",
 "name": {
  "en": "A usual Monday",
  "az": "Adi bir bazar ertəsi",
  "ru": "Обычный понедельник"
 },
 "why": {
  "en": "Aleksandr, Krista and Kiur, from waking up to going to bed",
  "az": "Aleksandr, Krista və Kiur — oyanmaqdan yatmağa qədər",
  "ru": "Aleksandr, Krista и Kiur — от подъёма до сна"
 },
 "taste": "Pool kaheksa ärkan üles.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Missugune on sinu tavaline esmaspäev?",
    "en": "What is your usual Monday like?",
    "az": "Sənin adi bazar ertən necə keçir?",
    "ru": "Как проходит твой обычный понедельник?"
   },
   "turns": [
    {
     "who": "Aleksandr",
     "lines": [
      {
       "et": "Pool kaheksa ärkan üles.",
       "en": "At half past seven I wake up.",
       "az": "Səkkizin yarısında oyanıram.",
       "ru": "В половине восьмого я просыпаюсь."
      },
      {
       "et": "Siis teen süüa, pesen hambaid ja nii edasi.",
       "en": "Then I make something to eat, brush my teeth and so on.",
       "az": "Sonra yemək hazırlayıram, dişlərimi yuyuram və sair.",
       "ru": "Потом готовлю поесть, чищу зубы и так далее."
      },
      {
       "et": "Siis lähen tööle.",
       "en": "Then I go to work.",
       "az": "Sonra işə gedirəm.",
       "ru": "Потом иду на работу."
      },
      {
       "et": "Kell üheksa ma olen siin tööl.",
       "en": "At nine o'clock I'm at work here.",
       "az": "Saat doqquzda artıq burada, işdəyəm.",
       "ru": "В девять я уже здесь, на работе."
      },
      {
       "et": "Poole kuueni või kuueni ma olen tööl.",
       "en": "Until half past five or until six I am at work.",
       "az": "Altının yarısına və ya altıya qədər işdəyəm.",
       "ru": "До половины шестого или до шести я на работе."
      },
      {
       "et": "Ja siis ma lähen koju.",
       "en": "And then I go home.",
       "az": "Sonra evə gedirəm.",
       "ru": "А потом иду домой."
      },
      {
       "et": "Seitsme paiku me sööme naisega õhtusööki.",
       "en": "Around seven we eat dinner, my wife and I.",
       "az": "Yeddi radələrində arvadımla şam edirik.",
       "ru": "Около семи мы с женой ужинаем."
      },
      {
       "et": "Kell üksteist me lähme magama.",
       "en": "At eleven o'clock we go to sleep.",
       "az": "Saat on birdə yatırıq.",
       "ru": "В одиннадцать ложимся спать."
      }
     ]
    },
    {
     "who": "Krista",
     "lines": [
      {
       "et": "Minu esmaspäev näeb välja selline: ärkan üles, teen süüa lastele, iseendale.",
       "en": "My Monday looks like this: I wake up, cook food for the children and for myself.",
       "az": "Mənim bazar ertəm belə keçir: oyanıram, uşaqlara və özümə yemək hazırlayıram.",
       "ru": "Мой понедельник выглядит так: просыпаюсь, готовлю еду детям и себе."
      },
      {
       "et": "Me sööme, ma saadan lapsed kooli.",
       "en": "We eat, I send the kids to school.",
       "az": "Yeyirik, uşaqları məktəbə yola salıram.",
       "ru": "Мы едим, я отправляю детей в школу."
      },
      {
       "et": "Ja mehe saadan saksa keele tundi.",
       "en": "And my husband I send to his German class.",
       "az": "Ərimi də alman dili dərsinə yola salıram.",
       "ru": "А мужа отправляю на урок немецкого."
      },
      {
       "et": "Siis ma teen arvuti taga tööd.",
       "en": "Then I do some work at the computer.",
       "az": "Sonra kompüter arxasında işləyirəm.",
       "ru": "Потом работаю за компьютером."
      },
      {
       "et": "Võib-olla lähen päeval jooksma.",
       "en": "Maybe I go jogging during the day.",
       "az": "Bəlkə gündüz qaçmağa gedirəm.",
       "ru": "Может быть, днём иду на пробежку."
      },
      {
       "et": "Ja õhtul on mul keelekursus, kus ma õpetan norra keelt.",
       "en": "And in the evening I have a language course, where I teach Norwegian.",
       "az": "Axşam isə dil kursum var — orada norveç dili öyrədirəm.",
       "ru": "А вечером у меня языковой курс, где я преподаю норвежский."
      }
     ]
    },
    {
     "who": "Kiur",
     "lines": [
      {
       "et": "Ma ärkan pool seitse.",
       "en": "I wake up at half past six.",
       "az": "Yeddinin yarısında oyanıram.",
       "ru": "Я просыпаюсь в половине седьмого."
      },
      {
       "et": "Hommikul ma panen riidesse, siis ma söön, siis ma pesen hambad ära, siis ma lähen bussi peale.",
       "en": "In the morning I get dressed, then I eat, then I brush my teeth, then I take the bus.",
       "az": "Səhər geyinirəm, sonra yeyirəm, sonra dişlərimi yuyuram, sonra avtobusa minirəm.",
       "ru": "Утром одеваюсь, потом ем, потом чищу зубы, потом сажусь на автобус."
      },
      {
       "et": "Lähen kooli, koolist lähen maleringi.",
       "en": "I go to school, and from school I go to the chess club.",
       "az": "Məktəbə gedirəm, məktəbdən şahmat dərnəyinə.",
       "ru": "Еду в школу, из школы — в шахматный кружок."
      },
      {
       "et": "Mingi hetk jõuan koju.",
       "en": "At some point I get home.",
       "az": "Bir vaxt evə çatıram.",
       "ru": "В какой-то момент добираюсь домой."
      },
      {
       "et": "Kodus õpin.",
       "en": "At home I study.",
       "az": "Evdə dərs oxuyuram.",
       "ru": "Дома учу уроки."
      },
      {
       "et": "Siis teen midagi, mis pähe tuleb, ja siis lähen magama.",
       "en": "Then I do whatever comes to mind, and then I go to sleep.",
       "az": "Sonra ağlıma nə gəlirsə, onu edirəm, sonra da yatıram.",
       "ru": "Потом делаю что в голову придёт, а потом иду спать."
      }
     ]
    }
   ]
  }
 ],
