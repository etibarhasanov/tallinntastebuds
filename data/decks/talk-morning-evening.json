{
 "id": "talk-morning-evening",
 "added": "2026-10-06",
 "name": {
  "en": "Morning or evening person?",
  "az": "Səhər adamı, yoxsa axşam adamı?",
  "ru": "Утренний человек или вечерний?"
 },
 "why": {
  "en": "Two people on when they like to work, and four on what an evening holds",
  "az": "İki nəfər nə vaxt işləməyi sevdiyi, dörd nəfər axşamı necə keçirdiyi haqqında",
  "ru": "Двое — о том, когда им работается, и четверо — о том, как проходит вечер"
 },
 "taste": "Ma olen tegelikult hommikuinimene.",
 "source": "Keeletee",
 "scenes": [
  {
   "ask": {
    "et": "Kas sa oled hommiku- või õhtuinimene?",
    "en": "Are you a morning or an evening person?",
    "az": "Sən səhər adamısan, yoxsa axşam adamı?",
    "ru": "Ты утренний человек или вечерний?"
   },
   "turns": [
    {
     "who": "Mihkel",
     "lines": [
      {
       "et": "Ma olen tegelikult hommikuinimene.",
       "en": "I'm actually a morning person.",
       "az": "Mən əslində səhər adamıyam.",
       "ru": "Я на самом деле утренний человек."
      },
      {
       "et": "See tähendab, et mulle ei meeldi õhtul hilja tööd teha.",
       "en": "That means I don't like to work late in the evening.",
       "az": "Yəni axşam gec işləməyi sevmirəm.",
       "ru": "То есть мне не нравится работать поздно вечером."
      },
      {
       "et": "Mulle meeldib tööd teha kas hommikul või pärastlõunal.",
       "en": "I like to work either in the morning or in the afternoon.",
       "az": "Ya səhər, ya da günortadan sonra işləməyi xoşlayıram.",
       "ru": "Я люблю работать или утром, или после обеда."
      },
      {
       "et": "Reeglina ma töötan alati hommikul.",
       "en": "As a rule, I always work in the morning.",
       "az": "Bir qayda olaraq həmişə səhər işləyirəm.",
       "ru": "Как правило, я всегда работаю утром."
      }
     ]
    },
    {
     "who": "Krista",
     "lines": [
      {
       "et": "Mina olen hommikuinimene.",
       "en": "I am a morning person.",
       "az": "Mən səhər adamıyam.",
       "ru": "Я утренний человек."
      },
      {
       "et": "Ma ärkan tavaliselt kell seitse.",
       "en": "I usually wake up at seven.",
       "az": "Adətən saat yeddidə oyanıram.",
       "ru": "Обычно я просыпаюсь в семь."
      },
      {
       "et": "Mulle sobib hommikuti ärgata.",
       "en": "Waking up in the morning suits me.",
       "az": "Səhərlər oyanmaq mənə uyğundur.",
       "ru": "Мне подходит вставать по утрам."
      },
      {
       "et": "Õhtul ma väsin ära.",
       "en": "In the evening I get tired.",
       "az": "Axşam yoruluram.",
       "ru": "Вечером я устаю."
      },
      {
       "et": "Õhtul ma lähen varem magama.",
       "en": "In the evening I go to bed earlier.",
       "az": "Axşam tez yatıram.",
       "ru": "Вечером я ложусь спать пораньше."
      }
     ]
    }
   ]
  },
  {
   "ask": {
    "et": "Mida sa õhtul tavaliselt teed?",
    "en": "What do you usually do in the evening?",
    "az": "Axşamlar adətən nə edirsən?",
    "ru": "Что ты обычно делаешь вечером?"
   },
   "turns": [
    {
     "who": "Krista",
     "lines": [
      {
       "et": "Õhtuti tulevad lapsed koolidest, trennidest.",
       "en": "In the evenings the kids come home from school and from their clubs.",
       "az": "Axşamlar uşaqlar məktəbdən, məşqdən gəlirlər.",
       "ru": "По вечерам дети приходят из школы, с тренировок."
      },
      {
       "et": "Ja siis nad hakkavad õppima ja vahel on neil midagi küsida, siis ma aitan neid.",
       "en": "Then they start to study, and sometimes they have something to ask, so I help them.",
       "az": "Sonra dərs oxumağa başlayırlar, bəzən sualları olur, onda kömək edirəm.",
       "ru": "Потом они садятся за уроки, и иногда им нужно что-то спросить — тогда я им помогаю."
      },
      {
       "et": "Näiteks tahavad nad inglise keele sõnu küsida või siis nad jutustavad mulle midagi, siis ma kuulan.",
       "en": "For instance they want to ask about some English words, or they tell me something and I listen.",
       "az": "Məsələn, ingilis sözləri soruşmaq istəyirlər, ya da mənə nəsə danışırlar, mən də qulaq asıram.",
       "ru": "Например, они спрашивают английские слова или рассказывают мне что-нибудь, а я слушаю."
      },
      {
       "et": "Ja ma vaatan natuke telekat.",
       "en": "And I watch a little TV.",
       "az": "Bir az da televizora baxıram.",
       "ru": "Ещё я немного смотрю телевизор."
      },
      {
       "et": "Ja siis tuleb köök ära koristada.",
       "en": "And then the kitchen needs tidying up.",
       "az": "Sonra mətbəxi yığışdırmaq lazım gəlir.",
       "ru": "А потом надо убрать кухню."
      }
     ]
    },
    {
     "who": "Mihkel",
     "lines": [
      {
       "et": "Täna õhtul ma lähen jalgpalli mängima.",
       "en": "Tonight I'm going to play football.",
       "az": "Bu axşam futbol oynamağa gedirəm.",
       "ru": "Сегодня вечером я иду играть в футбол."
      },
      {
       "et": "See on mu hobi olnud kümme aastat.",
       "en": "It has been my hobby for ten years.",
       "az": "Bu, on ildir mənim hobbimdir.",
       "ru": "Это моё хобби уже десять лет."
      },
      {
       "et": "Ei, rohkem, viisteist aastat.",
       "en": "No, more — fifteen years.",
       "az": "Yox, daha çox — on beş il.",
       "ru": "Нет, больше — пятнадцать лет."
      }
     ]
    },
    {
     "who": "Kiur",
     "lines": [
      {
       "et": "Tavaliselt õhtuti ma õpin või olen arvutis.",
       "en": "Usually in the evenings I study or I'm at the computer.",
       "az": "Adətən axşamlar dərs oxuyuram və ya kompüterdə oluram.",
       "ru": "Обычно по вечерам я учу уроки или сижу за компьютером."
      }
     ]
    },
    {
     "who": "Aleksandr",
     "lines": [
      {
       "et": "No õhtu sõltub sellest, kas mul on proov või ei ole.",
       "en": "Well, the evening depends on whether I have a rehearsal or not.",
       "az": "Axşam ondan asılıdır ki, məşqim var, ya yox.",
       "ru": "Ну, вечер зависит от того, есть ли у меня репетиция."
      },
      {
       "et": "Võib-olla paar korda nädalas teeme oma bändikaaslastega proovi.",
       "en": "Maybe a couple of times a week we rehearse with my bandmates.",
       "az": "Həftədə bir-iki dəfə qrup yoldaşlarımla məşq edirik.",
       "ru": "Пару раз в неделю мы репетируем с ребятами из группы."
      },
      {
       "et": "Ma mängin kitarri ja laulan.",
       "en": "I play the guitar and sing.",
       "az": "Mən gitara çalıram və oxuyuram.",
       "ru": "Я играю на гитаре и пою."
      },
      {
       "et": "Mul on oma bänd.",
       "en": "I have my own band.",
       "az": "Öz qrupum var.",
       "ru": "У меня своя группа."
      }
     ]
    }
   ]
  }
 ],
