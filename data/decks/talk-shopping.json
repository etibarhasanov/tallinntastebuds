{
 "id": "talk-shopping",
 "added": "2026-10-07",
 "name": {
  "en": "Buying a washing machine",
  "az": "Paltaryuyan maşın almaq",
  "ru": "Покупка стиральной машины"
 },
 "why": {
  "en": "A white washing machine under six hundred euros, a client card, and a discount that will not go further",
  "az": "Altı yüz avrodan ucuz ağ paltaryuyan, müştəri kartı və daha artıq olmayan endirim",
  "ru": "Белая стиральная машина дешевле шестисот евро, карта клиента и скидка, больше которой не будет"
 },
 "taste": "Tere, kas saan kuidagi abiks olla?",
 "source": "Keeletee",
 "scenes": [
  {
   "turns": [
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Tere, kas saan kuidagi abiks olla?",
       "en": "Hello, can I help you in any way?",
       "az": "Salam, sizə bir köməyim dəyə bilərmi?",
       "ru": "Здравствуйте, могу я чем-нибудь помочь?"
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Jah, ma tahaksin pesumasinat osta.",
       "en": "Yes, I would like to buy a washing machine.",
       "az": "Bəli, paltaryuyan maşın almaq istərdim.",
       "ru": "Да, я хотел бы купить стиральную машину."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Tulge palun minuga kaasa.",
       "en": "Please come with me.",
       "az": "Zəhmət olmasa, mənimlə gəlin.",
       "ru": "Пройдёмте, пожалуйста, со мной."
      },
      {
       "et": "Pesumasinad on meil siinpool.",
       "en": "Our washing machines are over here.",
       "az": "Paltaryuyanlarımız bu tərəfdədir.",
       "ru": "Стиральные машины у нас здесь."
      },
      {
       "et": "Missugust teil vaja on?",
       "en": "What kind do you need?",
       "az": "Sizə necəsi lazımdır?",
       "ru": "Какая вам нужна?"
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Ma tahaks, et see masin oleks valget värvi.",
       "en": "I'd like the machine to be white.",
       "az": "İstərdim ki, maşın ağ rəngdə olsun.",
       "ru": "Я бы хотел, чтобы машина была белого цвета."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Jah.",
       "en": "Yes.",
       "az": "Bəli.",
       "ru": "Да."
      },
      {
       "et": "Meie pesumasinad on kõik valged.",
       "en": "Our washing machines are all white.",
       "az": "Bizim paltaryuyanların hamısı ağdır.",
       "ru": "Наши стиральные машины все белые."
      },
      {
       "et": "Valgeid pesumasinaid ostetakse kõige rohkem.",
       "en": "White washing machines are the ones people buy most.",
       "az": "Ən çox ağ paltaryuyanlar alınır.",
       "ru": "Белые стиральные машины покупают чаще всего."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Väga hea.",
       "en": "Very good.",
       "az": "Çox gözəl.",
       "ru": "Очень хорошо."
      },
      {
       "et": "Mis teil praegu soodsa hinnaga on?",
       "en": "What do you have on offer at the moment?",
       "az": "Hazırda sizdə nə sərfəli qiymətədir?",
       "ru": "Что у вас сейчас по выгодной цене?"
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "See sõltub teie soovidest.",
       "en": "It depends on what you want.",
       "az": "Bu, istəklərinizdən asılıdır.",
       "ru": "Это зависит от ваших пожеланий."
      },
      {
       "et": "Kui palju see masin umbes maksta võiks?",
       "en": "Roughly how much could the machine cost?",
       "az": "Maşın təxminən neçəyə olsa, olar?",
       "ru": "Примерно сколько может стоить машина?"
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Palju üle kuuesaja euro ma küll maksta ei saa.",
       "en": "I can't pay much more than six hundred euros.",
       "az": "Altı yüz avrodan çox ödəyə bilmərəm.",
       "ru": "Намного больше шестисот евро я точно заплатить не могу."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Sellise raha eest saate väga kvaliteetse masina.",
       "en": "For that kind of money you get a very good quality machine.",
       "az": "Bu pula çox keyfiyyətli maşın ala bilərsiniz.",
       "ru": "За такие деньги вы получите очень качественную машину."
      },
      {
       "et": "Need siin on kampaaniahinnaga ja kui teil on kliendikaart, saate veel kümme protsenti odavamalt.",
       "en": "These here are on special offer, and if you have a client card you get another ten per cent off.",
       "az": "Bunlar kampaniya qiymətinədir və müştəri kartınız varsa, daha on faiz ucuz alarsınız.",
       "ru": "Вот эти по акционной цене, а если у вас есть карта клиента, будет ещё на десять процентов дешевле."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Mul ei ole kliendikaarti.",
       "en": "I don't have a client card.",
       "az": "Məndə müştəri kartı yoxdur.",
       "ru": "У меня нет карты клиента."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Vormistame.",
       "en": "We'll make you one.",
       "az": "Rəsmiləşdirərik.",
       "ru": "Оформим."
      },
      {
       "et": "Vormistamine ei maksa midagi.",
       "en": "It doesn't cost anything.",
       "az": "Rəsmiləşdirmək pulsuzdur.",
       "ru": "Оформление ничего не стоит."
      },
      {
       "et": "Missugust mudelit te siis soovite?",
       "en": "Which model would you like, then?",
       "az": "Bəs hansı modeli istəyirsiniz?",
       "ru": "Какую модель вы тогда хотите?"
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Seda valget siin.",
       "en": "This white one here.",
       "az": "Bu ağı, buradakını.",
       "ru": "Вот эту белую."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Kohe kontrollin, kas see masin on laos olemas.",
       "en": "I'll check right away whether we have this machine in stock.",
       "az": "İndi yoxlayıram, görüm bu maşın anbarda varmı.",
       "ru": "Сейчас проверю, есть ли эта машина на складе."
      },
      {
       "et": "Teate, see näidis siin ongi meil viimane eksemplar.",
       "en": "You know, this display model here is actually our last one.",
       "az": "Bilirsiniz, buradakı bu nümunə elə bizim sonuncu nüsxədir.",
       "ru": "Знаете, вот этот образец как раз наш последний экземпляр."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Kas te saate sellele siis veel natukene allahindlust teha?",
       "en": "Could you give me a little more off on this one, then?",
       "az": "Onda buna bir az da endirim edə bilərsinizmi?",
       "ru": "Тогда вы можете сделать на неё ещё небольшую скидку?"
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Ei saa.",
       "en": "No, I can't.",
       "az": "Yox, olmaz.",
       "ru": "Не могу."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Tõesti?",
       "en": "Really?",
       "az": "Doğrudan?",
       "ru": "Правда?"
      },
      {
       "et": "Äkki siiski?",
       "en": "Are you sure?",
       "az": "Bəlkə yenə də olar?",
       "ru": "А может, всё-таки?"
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Vaadake, see on lõplik hind.",
       "en": "Look, this is the final price.",
       "az": "Baxın, bu, son qiymətdir.",
       "ru": "Смотрите, это окончательная цена."
      },
      {
       "et": "Ainult teile ja ainult täna.",
       "en": "For you only and today only.",
       "az": "Ancaq sizə və ancaq bu gün.",
       "ru": "Только для вас и только сегодня."
      }
     ]
    },
    {
     "who": "Klient",
     "lines": [
      {
       "et": "Las ma mõtlen.",
       "en": "Let me think.",
       "az": "Qoyun fikirləşim.",
       "ru": "Дайте подумать."
      }
     ]
    },
    {
     "who": "Müüja",
     "lines": [
      {
       "et": "Lähme kassasse!",
       "en": "Let's go to the till!",
       "az": "Gedək kassaya!",
       "ru": "Пойдёмте на кассу!"
      }
     ]
    }
   ]
  }
 ],
