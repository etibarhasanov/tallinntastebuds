rin acgözlüyü, din pərdəsi altında avam camaatı aldatmaları filmdə öz əksini tapmışdır. Əsas rolları Abbas Mirzə Şərifzadə, Ağarza Quliyev, Möhsün Sənani və Aleksandr Makovski ifa edirlər.","aboutEn":"Bayquş (The Owl) is a feature film made by director Georgi Kravçenko in 1924. It was produced at AFKİ. The film depicts the class struggle between different social strata in a village on the eve of the establishment of Soviet power in Azerbaijan, the greed of some clergy, and their deceiving of ordinary people under the cover of religion. The leading roles are played by Abbas Mirzə Şərifzadə, Ağarza Quliyev, Möhsün Sənani and Aleksandr Makovski.","watch":[],"views":0,"video":[],"imdb":null,"image":null,"wiki":"Bayquş (film, 1924)","source":null},{"id":"culfa-baki-yolu-1924","title":"Culfa-Bakı yolu","titleEn":null,"titleRu":null,"year":1924,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":[],"writer":[],"cast":[],"about":null,"aboutEn":null,"watch":[],"views":0,"video":[],"imdb":null,"image":null,"wiki":null,"source":null},{"id":"fehle-meiseti-1924","title":"Fəhlə məişəti","titleEn":null,"titleRu":null,"year":1924,"yearTo":null,"kind":"documentary","length":null,"kindAz":"sənədli film","director":[],"writer":[],"cast":[],"about":null,"aboutEn":null,"watch":[],"views":0,"video":[],"imdb":null,"image":null,"wiki":null,"source":null},{"id":"xalq-torpaq-komissarligi-1924","title":"Xalq Torpaq Komissarlığı","titleEn":null,"titleRu":null,"year":1924,"yearTo":null,"kind":"documentary","length":null,"kindAz":"sənədli film","director":[],"writer":[],"cast":[],"about":null,"aboutEn":null,"watch":[],"views":0,"video":[],"imdb":null,"image":null,"wiki":null,"source":null},{"id":"xezer-gemiciliyi-1924","title":"Xəzər gəmiçiliyi","titleEn":null,"titleRu":null,"year":1924,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":[],"writer":[],"cast":[],"about":null,"aboutEn":null,"watch":[],