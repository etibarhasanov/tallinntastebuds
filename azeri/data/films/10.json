rı Həsənağa Turabov, Mömünat Qurbanova, Gümrah Rəhimov, Ənvər Həsənov, Ömür Nağıyev, Eldəniz Quliyev, Rasim Balayev, Ramiz Əzizbəyli, Şahmar Ələkbərov ifa edirlər.","aboutEn":"The film Qanlı zəmi (The Bloody Field) was made in 1985 by directors Həsənağa Turabov and Əbdül Mahmudov. This film with a gripping plot tells of the people's avenger and legendary hero Qaçaq Nəbi and the deeds of valour of his band. It is actor Həsənağa Turabov's first work in cinema as a director. The film was awarded the first category. It was produced at the \"Azərbaycanfilm\" film studio. The main roles are played by Həsənağa Turabov, Mömünat Qurbanova, Gümrah Rəhimov, Ənvər Həsənov, Ömür Nağıyev, Eldəniz Quliyev, Rasim Balayev, Ramiz Əzizbəyli and Şahmar Ələkbərov.","watch":[],"video":[{"url":"https://www.youtube.com/watch?v=yqXzjum0qKM","label":"Filmi izlə"}],"imdb":"tt0263880","image":null,"wiki":"Qanlı zəmi (film, 1985)","source":null},{"id":"qara-leylek-1985","title":"Qara leylək","titleEn":null,"year":1985,"yearTo":null,"kind":"animation","length":null,"kindAz":"cizgi filmi","director":["Vaqif Behbudov"],"writer":["Teymur Elçin"],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[{"url":"https://www.youtube.com/watch?v=NPhG5XZmrLA","label":"Filmi izlə"}],"imdb":null,"image":null,"wiki":"Qara leylək (film, 1985)","source":null},{"id":"qurultaydan-qurultaya-1985","title":"Qurultaydan qurultaya","titleEn":null,"year":1985,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":[],"writer":[],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[],"imdb":null,"image":null,"wiki":null,"source":null},{"id":"neft-kimya-maddeleri-laylarin-neft-hasilatini-yukseldir-1985","title":"Neft-kimya maddələri layların neft hasilatını yüksəldir","titleEn":null,"year":1985,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":[],"writer":[],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[],"im