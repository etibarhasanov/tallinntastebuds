85","title":"Sağ ol, müəllim","titleEn":null,"year":1985,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":[],"writer":[],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[],"imdb":null,"image":null,"wiki":null,"source":null},{"id":"sakit-yonun-maceralari-1985","title":"Sakit Yonun macəraları","titleEn":null,"year":1985,"yearTo":null,"kind":"animation","length":null,"kindAz":"cizgi filmi","director":[],"writer":[],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[],"imdb":null,"image":null,"wiki":null,"source":null},{"id":"sefiller-1985","title":"Səfillər","titleEn":null,"year":1985,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":["Cahangir Zeynallı"],"writer":["Rüstəm İbrahimbəyov"],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[],"imdb":null,"image":null,"wiki":"Səfillər (film, 1985)","source":null},{"id":"sizi-dunyalar-qeder-sevirdim-1985","title":"Sizi dünyalar qədər sevirdim","titleEn":null,"year":1985,"yearTo":null,"kind":"feature","length":"full","kindAz":"tammetrajlı bədii film","director":["Rasim İsmayılov"],"writer":["Ramiz Fətəliyev"],"cast":["Ramiz Novruzov","Viktor Tarasov","Aleksandr Denisov","Şahmar Ələkbərov"],"about":"Sizi dünyalar qədər sevirdim — filmi rejissor Rasim İsmayılov tərəfindən 1985-ci ildə ekranlaşdırılmışdır. Filmin çəkilişlərində Belarus və Zaqafqaziya hərbi dairələrinin qoşunları iştirak etmişlər. Film Azərbaycan xalqının rəşadətli oğlu, igid sərkərdə, iki dəfə Sovet İttifaqı Qəhrəmanı, tank qoşunları general-mayoru Həzi Aslanovun həyat və döyüş bioqrafiyasının səhifələrini canlandırır. Film tarixi, döyüş, bioqrafik, müharibə janrındadır. Film \"Azərbaycanfilm\" kinostudiyasında istehsal edilmişdir. Əsas rolları Ramiz Novruzov, Viktor Tarasov, Aleksandr Denisov, Şahmar Ələkbərov ifa edirlər.","aboutEn":"Sizi dünyalar qədər sevirdim (I Loved You More Than the World) was made in 1985 by director Rasim İsmayılov. Troops of the Belarusian and Transcaucasian military districts took part in the filming. The film brings to life pages from the life and combat record of Həzi Aslanov, a valiant son of the Azerbaijani people, a brave commander, twice Hero of the Soviet Union and major general of tank troops. It is a historical, war and biographical film. It was produced at the \"Azərbaycanfilm\" film studio. The main roles are played by Ramiz Novruzov, Viktor Tarasov, Aleksandr Denisov and Şahmar Ələkbərov.","watch":[],"video":[],"imdb":"tt0266069","image":null,"wiki":"Sizi dünyalar qədər sevirdim","source":null},{"id":"taca-dogru-addim-1985","title":"Taca doğru addım","titleEn":null,"year":1985,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":["Teymur Bəkirzadə"],"writer":["Aqşin Kazımzadə","Teymur Bəkirzadə"],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[],"imdb":null,"image":null,"wiki":"Taca doğru addım (film, 1985)","source":null},{"id":"tekelduz-1985","title":"Təkəlduz","titleEn":null,"year":1985,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":["Nicat Əliyev"],"writer":["Ayaz Salayev"],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[],"imdb":null,"image":null,"wiki":"Təkəlduz (film, 1985)","source":null},{"id":"yurusun-sonu-varmi-1985","title":"Yürüşün sonu varmı?","titleEn":null,"year":1985,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":[],"writer":[],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[],"imdb":null,"image":null,"wiki":null,"source":null},{"id":"azerbaycan-dunyani-gezir-1984","title":"\"Azərbaycan\" dünyanı gəzir","titleEn":null,"year":1984,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":["Cəmil Fərəcov"],"writer":["Cəmil Fərəcov"],"cast":[],"about":"\"Azərbaycan\" dünyanı gəzir — qısametrajlı sənədli film.","aboutEn":null,"watch":[],"video":[],"imdb":null,"image":null,"wiki":"\"Azərbaycan\" dünyanı gəzir","source":null},{"id":"alayarimciq-1984","title":"Alayarımçıq","titleEn":null,"year":1984,"yearTo":null,"kind":"newsreel","length":"short","kindAz":"qısametrajlı sənədli süjet — Mozalan № 89","director":[],"writer":[],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[],"imdb":null,"image":null,"wiki":null,"source":null},{"id":"avqust-gelende-1984","title":"Avqust gələndə","titleEn":null,"year":1984,"yearTo":null,"kind":"feature","length":"full","kindAz":"tammetrajlı bədii film","director":["Gülbəniz Əzimzadə"],"writer":["Asim Cəlilov"],"cast":["Natiq Abdullayev","Şahmar Ələkbərov","Valeri Rıjakov","Dadaş Kazımov","Şükufə Yusupova","Ayan Mirqasımova"],"about":"Avqust gələndə filmi rejissor Gülbəniz Əzimzadə tərəfindən 1984-cü ildə ekranlaşdırılmışdır. Film \"Azərbaycanfilm\" kinostudiyasında istehsal edilmişdir. Filmdə 15 yaşlı Arifin və onun dostlarının yeniyetmə xarakterlərinin formalaşmasından, şüurlarının özünütəsdiqindən danışılır. Filmdə əsas rolları Natiq Abdullayev, Şahmar Ələkbərov, Valeri Rıjakov, Dadaş Kazımov, Şükufə Yusupova və Ayan Mirqasımova ifa edirlər.","aboutEn":"\"Avqust gələndə\" (When August Comes) was made by director Gülbəniz Əzimzadə in 1984 at the \"Azərbaycanfilm\" film studio. The film is about how the teenage characters of 15-year-old Arif and his friends take shape and how they come to assert themselves. It stars Natiq Abdullayev, Şahmar Ələkbərov, Valeri Rıjakov, Dadaş Kazımov, Şükufə Yusupova and Ayan Mirqasımova.","watch":[],"video":[],"imdb":null,"image":null,"wiki":"Avqust gələndə (film, 1984)","source":null},{"id":"bir-defe-gormek-1984","title":"Bir dəfə görmək...","titleEn":null,"year":1984,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":[],"writer":[],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[],"imdb":null,"image":null,"wiki":null,"source":null},{"id":"coxsaheli-pambiq-eki