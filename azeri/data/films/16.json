[{"id":"bizim-kucenin-oglanlari-1973","title":"Bizim küçənin oğlanları","titleEn":null,"year":1973,"yearTo":null,"kind":"feature","length":"full","kindAz":"tammetrajlı bədii film","director":["Tofiq İsmayılov"],"writer":["Oqtay Orucov"],"cast":["Ənvər Həsənov","Sədaqət Dadaşova","Salam İsmayıl","Ömür Nağıyev","Nəsibə Zeynalova","Əliağa Ağayev","Ağasadıq Gəraybəyli","Məlik Dadaşov","Şahmar Ələkbərov"],"about":"Bizim küçənin oğlanları tammetrajlı bədii filmi rejissor Tofiq İsmayılov tərəfindən 1973-cü ildə ekranlaşdırılmışdır. \"Azərbaycanfilm\" kinostudiyasında istehsal edilmişdir. Film bir kəndin ayrı-ayrı küçələrinin özünəməxsus məhəlli adət-ənənələrindən, yaşayış tərzindən, eyni küçədə, eyni şəraitdə böyüyən məhəllə uşaqlarının gələcək talelərindən, kimin hansı mənsəbə çata biləcəyi ehtimalından söhbət açır. Əsas rolları Ənvər Həsənov, Sədaqət Dadaşova, Salam İsmayıl, Ömür Nağıyev, Nəsibə Zeynalova, Əliağa Ağayev, Ağasadıq Gəraybəyli, Məlik Dadaşov və Şahmar Ələkbərov ifa edirlər.","aboutEn":"Bizim küçənin oğlanları (The Boys of Our Street) is a feature film made by director Tofiq İsmayılov in 1973. It was produced at the \"Azərbaycanfilm\" film studio. The film speaks of the local customs and ways of life of the different streets of one village, and of the future of the neighbourhood children who grow up on the same street in the same conditions, and of who might rise to which position. The leading roles are played by Ənvər Həsənov, Sədaqət Dadaşova, Salam İsmayıl, Ömür Nağıyev, Nəsibə Zeynalova, Əliağa Ağayev, Ağasadıq Gəraybəyli, Məlik Dadaşov and Şahmar Ələkbərov.","watch":[],"video":[{"url":"https://www.youtube.com/watch?v=-jcUN0oDSnI","label":"Filmi izlə"}],"imdb":null,"image":null,"wiki":"Bizim küçənin oğlanları (film, 1973)","source":null},{"id":"bulud-niye-aglayir-1973","title":"Bulud niyə ağlayır?","titleEn":null,"year":1973,"yearTo":null,"kind":"animation","length":null,"kindAz":"cizgi filmi","director":["Məsud Pənahi"],"writer":["Məsud Pənahi"],"cast":[],"about":"Bulud niyə ağlayır? qısametrajlı cizgi filmi rejissor Məsud Pənahi tərəfindən 1973-cü ildə çəkilmişdir. \"Azərbaycanfilm\" kinostudiyasında istehsal edilmişdir. Qədim əfsanədə quraqlıq nəticəsində cadar-cadar olmuş torpağa yenidən həyat verməklə insanların köməyinə gələn bulud-qız haqqında bəhs edilir. 1974-cü ildə Bakıda VII Ümumittifaq kinofestivalında filmə I mükafat verilmişdir.","aboutEn":"Bulud niyə ağlayır? (Why Is the Cloud Crying?) is a short animated film made by director Məsud Pənahi in 1973. It was produced at the \"Azərbaycanfilm\" film studio. Based on an ancient legend, it tells of a cloud-girl who comes to people's aid by bringing life back to land cracked by drought. In 1974 the film received first prize at the 7th All-Union Film Festival in Baku.","watch":[],"video":[{"url":"https://www.youtube.com/watch?v=f0Z39ecJUbo","label":"Filmi izlə"}],"imdb":null,"image":null,"wiki":"Bulud niyə ağlayır?","source":null},{"id":"cefer-cabbarli-sehne-eserleri-1973","title":"Cəfər Cabbarlı. Səhnə əsərləri","titleEn":null,"year":1973,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":["Nicat Bəkirzadə"],"writer":["Akif Hüseynov"],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[],"imdb":null,"image":null,"wiki":"Cəfər Cabbarlı. Səhnə əsərləri (film, 1973)","source":null},{"id":"cirtdanin-yeni-serguzesti-1973","title":"Cırtdanın yeni sərgüzəşti","titleEn":null,"year":1973,"yearTo":null,"kind":"animation","length":null,"kindAz":"cizgi filmi","director":["Nazim Məmmədov","Bəhmən Əliyev"],"writer":["Fikrət Sadıq"],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[],"imdb":null,"image":"Cırtdanın yeni sərgüzəşti.jpeg","wiki":"Cırtdanın yeni sərgüzəşti","source":null},{"id":"daglarda-isiq-1973","title":"Dağlarda işıq","titleEn":null,"year":1973,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":["Mirzə Mustafayev"],"writer":["Cəmil Əlibəyov"],"c