tch":[],"video":[],"imdb":null,"image":null,"wiki":null,"source":null},{"id":"anaya-mektub-1980","title":"Anaya məktub","titleEn":null,"year":1980,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":[],"writer":[],"cast":[],"about":null,"aboutEn":null,"watch":[],"video":[],"imdb":null,"image":null,"wiki":null,"source":null},{"id":"anda-sedaqet-1980","title":"Anda sədaqət","titleEn":null,"year":1980,"yearTo":null,"kind":"documentary","length":"short","kindAz":"qısametrajlı sənədli film","director":["Pərviz Cəfərov"],"writer":["Əlibala Balayev"],"cast":[],"about":"Anda sədaqət qısametrajlı sənədli filmi rejissor Pərviz Cəfərov tərəfindən 1980-ci ildə çəkilmişdir. Film \"Azərbaycanfilm\" kinostudiyasında istehsal edilmişdir. Kinolent Azərbaycan komsomolunun 60 illik yubileyinə həsr olunmuşdur.","aboutEn":null,"watch":[],"video":[],"imdb":null,"image":null,"wiki":"Anda sədaqət (film, 1980)","source":null},{"id":"anin-qurulusu-1980","title":"Anın quruluşu","titleEn":null,"year":1980,"yearTo":null,"kind":"feature","length":"full","kindAz":"tammetrajlı bədii film","director":["Rasim İsmayılov"],"writer":["Rüstəm İbrahimbəyov"],"cast":["Məmməd Məmmədov","Hacı İsmayılov","Anna Kamenkova","Vladimir Etuş","Olqa Barnet","Aleksandr Şarovski","Elxan Quliyev"],"about":"Anın quruluşu filmi rejissor Rasim İsmayılov tərəfindən 1980-ci ildə ekranlaşdırılmışdır. Televiziya filmində əsasən Ədhəmin öz yurduna qayıtmasından və burada özünü önəmli adam kimi qələmə verməsindən bəhs edilir. Film Mərkəzi televiziyanın (Moskva) sifarişi ilə \"Azərbaycanfilm\" kinostudiyasında istehsal edilmişdir. Filmdə əsas rolları Məmməd Məmmədov, Hacı İsmayılov, Anna Kamenkova, Vladimir Etuş, Olqa Barnet, Aleksandr Şarovski və Elxan Quliyev ifa edirlər.","aboutEn":"\"Anın quruluşu\" (The Structure of a Moment) was made by director Rasim İsmayılov in 1980. The television film is mainly about Ədhəm returning to his homeland and passing himself off there as an important man. It was produced at the \"Azərbaycanfilm\" film studio, commissioned by Central Television (Moscow). It stars Məmməd Məmmədov, Hacı İsmayılov, Anna Kamenkova, Vladimir Etuş, Olqa Barnet, Aleksandr Şarovski and Elxan Quliyev.","watch":[],"video":[],"imdb":"tt1482244","image":null,"wiki":"Anın quruluşu","source":null},{"id":"anlamaq-isteyirem-1980","title":"Anlamaq istəyirəm","titleEn":null,"year":1980,"yearTo":null,"kind":"feature","length":"full","kindAz":"tammetrajlı bədii film","director":["Oqtay Mirqasımov"],"writer":["Nəbi Xəzri","Leonid Juxovitski","Oqtay Mirqasımov"],"cast":["Revaz Çxikvişvili","Həmidə Ömərova","Mikayıl Kərimov","Mayya İsgəndərova","Həsən Məmmədov","Həsənağa Turabov"],"about":"Anlamaq istəyirəm filmi rejissor Oqtay Mirqasımov tərəfindən 1980-ci ildə ekranlaşdırılmışdır. Film Mərkəzi Televiziyanın (Moskva) sifarişi ilə \"Azərbaycanfilm\" kinostudiyasında istehsal edilmişdir. Film məhv olmuş arzular, xoşbəxtlik uğrunda mübarizə aparılmasının acı nəticəsi, iki sevən gəncin uğursuz məhəbbəti haqqında niskilli hekayədir. Aktrisa Həmidə Ömərovaya Çinarə roluna görə Lenin komsomolu mükafatı verilmişdir. Filmdə əsas rolları Revaz Çxikvişvili, Həmidə Ömərova, Mikayıl Kərimov, Mayya İsgəndərova, Həsən Məmmədov və Həsənağa Turabov ifa edirlər. Film AZTV- də dublyaj olunmuşdur.","aboutEn":"\"Anlamaq istəyirəm\" (I Want to Understand) was made by director Oqtay Mirqasımov in 1980 at the \"Azərbaycanfilm\" film studio, commissioned by Central Television (Moscow). The film is a wistful story of ruined dreams, the bitter outcome of a struggle for happiness, and the unhappy love of two young people. The actress Həmidə Ömərova was awarded the Lenin Komsomol Prize for the role of Çinarə. It stars Revaz Çxikvişvili, Həmidə Ömərova, Mikayıl Kərimov, Mayya İsgəndərova, Həsən Məmmədov and Həsənağa Turabov. The film was dubbed at AZTV.","watch":[],"video":[],"imdb":"tt2254019","image":null,"wiki":"Anlamaq istəyirəm (film, 1980)","source":null},{"id":"asta