# Cloudflare Pages reads this file, applies the rules and does not serve it.
#
# Everything here revalidates: the browser still gets a fast 304 when nothing
# changed, but an edit to restaurants.json shows up on the next load rather
# than whenever a cache decides to expire. Photos are the one exception.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The pages carry the ?v= stamps that tell a browser which copy of the scripts
# and stylesheets it is allowed to reuse, so a stale page is a stale
# everything. These rules match the request path, and the address people
# actually open is "/", not "/index.html", so both are spelled out.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The lists page. Same revalidating rule as the map for the same reason — the
# ?v= stamps in it are what tell a browser which script to reuse — plus a
# noindex, because there is nothing on it for anybody who is not signed in and
# a search result for "your lists" would be a permanently empty page.
#
# /list/<id> is not here: it is served by functions/list/[id].js, which sets
# its own headers. That one is noindex too, and deliberately not disallowed in
# robots.txt — see the note there.
/lists.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, follow

# Scripts and stylesheets are content-addressed by tools/stamp.mjs — the URL
# in the HTML carries a hash of the file — so a year-long cache would be safe
# for a stamped request and is deliberately not used anyway. These rules match
# on path and ignore the query string, so the same header would also be handed
# to a request for the bare, unstamped assets/app.js, and a browser that had
# pinned that one for a year would be stuck there for a year. Revalidating
# costs one conditional request and cannot strand anybody.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# The one asset whose URL cannot carry a ?v= stamp: browsers and Google's
# favicon crawler both ask for the bare path. Revalidating is how a redrawn
# mark ever reaches a tab that has already seen the old one.
/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate

# The file you actually edit. This one must never go stale.
/data/*
  Cache-Control: public, max-age=0, must-revalidate

# Photos are named per place and are replaced rather than edited, so they can
# sit in the cache for a week.
/photos/*
  Cache-Control: public, max-age=604800

# A story's video is written once, watched for a day or two and then deleted.
# Nothing ever edits one in place, so the file at a given name is always the
# same file, and a browser that has it should keep it: this is the largest
# thing on the site and the one most likely to be watched twice.
/stories/*
  Cache-Control: public, max-age=604800

# The discount pages turn over an hourly code between them, so a cached copy
# is a wrong copy. They are also the three pages that must never be indexed
# or shown in a preview card, whatever a link unfurler decides to do with the
# noindex tag in the markup.
/deal.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/verify.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/staff.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# The admin page holds a token in the browser it is opened in. A cached copy
# is a copy of the door, so there is never one.
/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
